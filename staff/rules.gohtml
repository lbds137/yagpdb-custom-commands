{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `rules`
  Dependencies: `embed_exec`
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}
{{ $serverURL := or ($globalDict.Get "Server URL") "" }}
{{ $dbEmbedColor := toInt ($globalDict.Get "Embed Color") }}
{{ $guildPremiumTier := toInt ($globalDict.Get "Guild Premium Tier") }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}

{{ $rulesDict := (dbGet 0 "Rules").Value }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $args := parseArgs 0 "Usage: `[rule to start at (inclusive)] (optional)` `[rule to end at (inclusive)] (optional)`"
    (carg "int" "starting rule")
    (carg "int" "ending rule")
}}

{{ $maxRule := 0 }}
{{- range $k, $v := $rulesDict -}}
    {{- if reFind "\\ARule #(\\d+)\\z" $k -}}
        {{- $ruleN := toInt (reReplace "\\ARule #" $k "") -}}
        {{- if gt $ruleN $maxRule -}}
            {{- $maxRule = $ruleN -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
{{ $channelID := .Channel.ID }}
{{ if gt $maxRule 0 }}
    {{ $startingRule := 1 }}
    {{ if $args.IsSet 0 }}
        {{ $startArg := $args.Get 0 }}
        {{ if and (ge $startArg 1) (le $startArg $maxRule) }}
            {{ $startingRule = $startArg }}
        {{ end }}
    {{ end }}
    {{ $endingRule := $maxRule }}
    {{ if $args.IsSet 1 }}
        {{ $endArg := $args.Get 1 }}
        {{ if and (ge $endArg 1) (le $endArg $maxRule) (ge $endArg $startingRule) }}
            {{ $endingRule = $endArg }}
        {{ end }}
    {{ end }}

    {{/* embed_exec's guild-author branch (no AuthorID in ExecData): the same author on
      every rule embed here, computed once */}}
    {{ $gIconExtension := ".png" }}
    {{ if ge (toInt $guildPremiumTier) 1 }}
        {{ $gIconExtension = ".gif" }}
    {{ end }}
    {{ $gIcon := "" }}
    {{ if .Guild.Icon }}
        {{ $gIcon = (joinStr "" "https://cdn.discordapp.com/icons/" (toString .Guild.ID) "/" .Guild.Icon $gIconExtension) }}
    {{ else }}
        {{ $gIcon = $globalDict.Get "Default Avatar" }}
    {{ end }}
    {{ $author := sdict "name" .Guild.Name "url" $serverURL "icon_url" $gIcon }}
    {{ $authorNameLen := len (toRune (print (or $author.name ""))) }}

    {{/* `rule`'s title rule: "Rule #N", or "Rules" when the dict holds exactly one rule
      total (not just in the chosen range) */}}
    {{ $singleRuleTitle := eq (len $rulesDict) 1 }}

    {{/* one item per rule in range, each already cut to embed_exec's own 4,096 / 6,000
      per-embed limits (lines 47-68 there), plus its packed length (title + description +
      author name, what counts toward Discord's 6,000-per-message total) */}}
    {{ $items := cslice }}
    {{- range $i := seq (sub $startingRule 1) $endingRule -}}
        {{- $iHuman := add 1 $i -}}
        {{- $key := joinStr "" "Rule #" $iHuman -}}
        {{- if $rulesDict.HasKey $key -}}
            {{- $title := $key -}}
            {{- if $singleRuleTitle -}}
                {{- $title = "Rules" -}}
            {{- end -}}
            {{- $otherLen := add $authorNameLen (len (toRune $title)) -}}
            {{- $descriptionMaxLen := toInt (min 4096 (sub 6000 $otherLen)) -}}
            {{- $ruleText := $rulesDict.Get $key -}}
            {{- $description := $ruleText -}}
            {{- if gt (len (toRune $ruleText)) $descriptionMaxLen -}}
                {{- $description = "" -}}
                {{- if ge $descriptionMaxLen 1 -}}
                    {{- $kept := slice (split $ruleText "") 0 (sub $descriptionMaxLen 1) -}}
                    {{- $description = joinStr "" $kept "…" -}}
                {{- end -}}
            {{- end -}}
            {{- $embed := cembed
                "title" $title
                "description" $description
                "color" $dbEmbedColor
                "author" $author
                "image" (sdict "url" "")
                "thumbnail" (sdict "url" "") -}}
            {{- $embedLen := add $otherLen (len (toRune $description)) -}}
            {{- $items = $items.Append (sdict "embed" $embed "len" $embedLen) -}}
        {{- end -}}
    {{- end -}}

    {{/* pack the embeds in order into as few messages as Discord allows: at most 10 per
      message, and at most 6,000 characters per message across every embed's title,
      description and author name (docs/API_REFERENCE.md; vendor
      common/templates/general.go's maxEmbeds = 10) */}}
    {{ $messages := cslice }}
    {{ $curEmbeds := cslice }}
    {{ $curLen := 0 }}
    {{- range $item := $items -}}
        {{- $eEmbed := $item.Get "embed" -}}
        {{- $eLen := $item.Get "len" -}}
        {{- $overCount := ge (len $curEmbeds) 10 -}}
        {{- $overLen := gt (add $curLen $eLen) 6000 -}}
        {{- if and (gt (len $curEmbeds) 0) (or $overCount $overLen) -}}
            {{- $messages = $messages.Append $curEmbeds -}}
            {{- $curEmbeds = cslice -}}
            {{- $curLen = 0 -}}
        {{- end -}}
        {{- $curEmbeds = $curEmbeds.Append $eEmbed -}}
        {{- $curLen = add $curLen $eLen -}}
    {{- end -}}
    {{- if gt (len $curEmbeds) 0 -}}
        {{- $messages = $messages.Append $curEmbeds -}}
    {{- end -}}

    {{- range $msgEmbeds := $messages -}}
        {{- sendMessage $channelID (complexMessage "embed" $msgEmbeds) -}}
    {{- end -}}
{{ else }}
    {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
        "ChannelID" $channelID
        "Title" "Rules Lookup Failed"
        "Description" "⚠️ No rules configured in the server!"
    ) }}
{{ end }}

{{ deleteTrigger $deleteTriggerDelay }}
