{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `db`
  Group: `Utility`
  Slash description: `Advanced: read or change stored server settings`
  Defer mode: `None`
  Dependencies: `embed_exec` (the ExecData path only)

  The slash version of retired/db.gohtml: same engine, ephemeral sendResponse.
  inactivity's "date" execCC still arrives on the ExecData path (embed_exec).

  Slash subcommand: `view show one stored value`
  Slash option: `view.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `view.user user another member's own data (staff)`
  Slash subcommand: `browse list the names inside a group`
  Slash option: `browse.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `browse.user user another member's own data (staff)`
  Slash subcommand: `set replace a stored value`
  Slash option: `set.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `set.value string! the new value: text, or a JSON object for a group`
  Slash option: `set.user user another member's own data (staff)`
  Slash subcommand: `add add an item to a list or group`
  Slash option: `add.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `add.value string! the new value (JSON for lists and groups)`
  Slash option: `add.user user another member's own data (staff)`
  Slash subcommand: `remove take an item out of a list or group`
  Slash option: `remove.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `remove.value string! the item to take out (JSON for lists and groups)`
  Slash option: `remove.user user another member's own data (staff)`
  Slash subcommand: `delete delete a stored entry`
  Slash option: `delete.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `delete.user user another member's own data (staff)`
  Slash subcommand: `export download entries as a JSON file`
  Slash option: `export.key string empty = all entries`
  Slash option: `export.user user another member's own data (staff)`

  view = get, browse = keys, export = dump. Rows: staff default to the global row 0,
  a picked `user` targets that member, everyone else their own row.
*/ -}}
{{$T := ((dbGet 0 "Global")).Value}}{{$ag := toInt ($T.Get "Delete Trigger Delay")}}{{$ah := toInt ($T.Get "Embed Color")}}{{$ai := ((dbGet 0 "Commands")).Value}}{{$aj := toInt ($ai.Get "embed_exec")}}{{$ak := ((dbGet 0 "Roles")).Value}}{{$al := toInt ($ak.Get "Staff")}}{{$am := ((dbGet 0 "Channels")).Value}}{{$an := toInt ($am.Get "YAGPDB")}}{{$K := "map[string]interface {}"}}{{$A := "string"}}{{$d := .Member.User.ID}}{{$e := ""}}{{$U := ""}}{{$c := ""}}{{$b := ""}}{{$n := ""}}{{$w := ""}}{{$B := false}}{{$ao := false}}{{$L := or .ExecData.UserID .ExecData.Operation .ExecData.Key .ExecData.Value .ExecData.Title}}{{if $L}}{{$d = .ExecData.UserID}}{{$e = .ExecData.Operation}}{{$c = .ExecData.Key}}{{$b = .ExecData.Value}}{{$n = printf "%T" $b}}{{$w = .ExecData.Title}}{{else}}{{if .IsSlashCommand}}{{$B = true}}{{$U = .SubCommand}}{{$e = .SubCommand}}{{if eq $e "view"}}{{$e = "get"}}{{else}}{{if eq $e "browse"}}{{$e = "keys"}}{{else}}{{if eq $e "export"}}{{$e = "dump"}}{{end}}{{end}}{{end}}{{$c = or .Options.key ""}}{{$b = or .Options.value ""}}{{$n = printf "%T" $b}}{{if hasRoleID $al}}{{$d = 0}}{{if .Options.user}}{{$d = toInt .Options.user.ID}}{{$ao = true}}{{end}}{{end}}{{end}}{{end}}{{$M := eq "keys" $e}}{{$C := eq "delete" $e}}{{$D := eq "get" $e}}{{$ap := eq "set" $e}}{{$t := eq "add" $e}}{{$N := eq "remove" $e}}{{$x := eq "dump" $e}}{{$V := or $M $C $D $ap $t $N $x}}{{$W := or (and $b (trimSpace (print $b))) $M $C $D $x}}{{$E := "(nil)"}}{{$O := "I couldn't read that value. A group must be a valid JSON object, e.g. {\"a\": 1}."}}{{$m := ""}}{{$P := "✅"}}{{$F := $d}}{{if and $x (not $c)}}{{$c = "all"}}{{end}}{{if and $V $c $W}}{{$a := ""}}{{$j := false}}{{$h := split $c ":"}}{{$k := ""}}{{$u := ""}}{{$Q := false}}{{$q := index $h 0}}{{$G := index $h (sub (len $h) 1)}}{{if ge (len $h) 2}}{{$k = ((dbGet $d $q)).Value}}{{if eq $K (printf "%T" $k)}}{{$k = sdict $k}}{{end}}{{$a = $k}}{{$j = true}}{{$c = $q}}{{range $H := slice $h 1}}{{$c = joinStr " > " $c $H}}{{if and $j (eq "map" (kindOf $a true))}}{{$u = $a}}{{$Q = true}}{{$j = $a.HasKey $H}}{{$a = $a.Get $H}}{{if eq $K (printf "%T" $a)}}{{$a = sdict $a}}{{$i := $u.Set $H $a}}{{end}}{{else}}{{$j = false}}{{$Q = false}}{{$a = ""}}{{end}}{{end}}{{else}}{{with dbGet $d $c}}{{$j = true}}{{$a = .Value}}{{if eq $K (printf "%T" $a)}}{{$a = sdict $a}}{{end}}{{end}}{{end}}{{$as := printf "%T" $a}}{{$f := ""}}{{$o := ""}}{{if $x}}{{$I := $d}}{{$y := sdict}}{{if and $c (ne $c "all")}}{{$r := dbGet $I $c}}{{if and $r $r.Value}}{{$i := $y.Set $c $r.Value}}{{end}}{{else}}{{range $r := dbGetPattern $I "%" 100 0}}{{if $r.Value}}{{$i := $y.Set $r.Key $r.Value}}{{end}}{{end}}{{end}}{{$o = "dumped"}}{{$F = $I}}{{$X := json $y true}}{{$Y := joinStr "" "db_dump_" (toString $I) "_" (currentTime.Unix)}}{{if $B}}{{sendResponse nil (complexMessage "content" (joinStr "" "Exported " (len $y) " entries to file") "file" $X "filename" $Y "ephemeral" true)}}{{else}}{{sendMessage nil (complexMessage "file" $X "filename" $Y)}}{{end}}{{$b = joinStr "" "Exported " (len $y) " entries to file"}}{{else}}{{if $M}}{{if eq "map" (kindOf $a true)}}{{$o = "inspected"}}{{$b = cslice}}{{range $l, $J := $a}}{{$b = $b.Append $l}}{{end}}{{else}}{{$f = "That name isn't a group of entries, so there is nothing to list."}}{{end}}{{else}}{{if or $C $D}}{{if $j}}{{$b = $a}}{{if $C}}{{$o = "deleted"}}{{if ge (len $h) 2}}{{$i := $u.Del $G}}{{dbSet $d $q $k}}{{else}}{{dbDel $d $c}}{{end}}{{else}}{{if $D}}{{$o = "retrieved"}}{{end}}{{end}}{{else}}{{$f = "Nothing is stored under that name."}}{{end}}{{else}}{{if or $t $N}}{{try}}{{$s := $b}}{{if eq $A $n}}{{$v := trimSpace $b}}{{if hasPrefix $v "{"}}{{$s = jsonToSdict $v}}{{end}}{{end}}{{if $t}}{{$o = "added"}}{{else}}{{$o = "removed"}}{{end}}{{$Z := and $j (eq "slice" (kindOf $a true))}}{{$aa := and $j (eq "map" (kindOf $a true))}}{{$aq := eq "map" (kindOf $s true)}}{{if and $Z $t}}{{$g := cslice}}{{range $p := $a}}{{$g = $g.Append $p}}{{end}}{{$g = $g.Append $s}}{{$a = $g}}{{if ge (len $h) 2}}{{$i := $u.Set $G $a}}{{dbSet $d $q $k}}{{else}}{{dbSet $d $c $a}}{{end}}{{$b = $s}}{{else}}{{if and $Z $N}}{{$g := cslice}}{{$R := false}}{{range $p := $a}}{{if and (not $R) (eq (str $p) (str $s))}}{{$R = true}}{{else}}{{$g = $g.Append $p}}{{end}}{{end}}{{if $R}}{{$a = $g}}{{if ge (len $h) 2}}{{$i := $u.Set $G $a}}{{dbSet $d $q $k}}{{else}}{{dbSet $d $c $a}}{{end}}{{$b = $s}}{{else}}{{$f = "Nothing is stored under that name."}}{{end}}{{else}}{{if and $aa $aq}}{{$b = $s}}{{$ab := false}}{{range $l, $J := $b}}{{if $t}}{{$ac := $a.Get $l}}{{if and (eq "slice" (kindOf $ac true)) (eq "slice" (kindOf $J true))}}{{$g := cslice}}{{range $p := $ac}}{{$g = $g.Append $p}}{{end}}{{range $p := $J}}{{$g = $g.Append $p}}{{end}}{{$i := $a.Set $l $g}}{{else}}{{$i := $a.Set $l $J}}{{end}}{{else}}{{if $a.HasKey $l}}{{$i := $b.Set $l ($a.Get $l)}}{{$i := $a.Del $l}}{{$ab = true}}{{else}}{{$i := $b.Del $l}}{{end}}{{end}}{{end}}{{if or $t $ab}}{{if ge (len $h) 2}}{{dbSet $d $q $k}}{{else}}{{dbSet $d $c $a}}{{end}}{{else}}{{$f = "Nothing is stored under that name."}}{{end}}{{else}}{{if $aa}}{{$f = $O}}{{else}}{{$f = "That name isn't a list or a group, so you can't add to or remove from it."}}{{end}}{{end}}{{end}}{{end}}{{catch}}{{$f = $O}}{{end}}{{else}}{{if and (ge (len $h) 2) (not $Q)}}{{$f = "That group doesn't exist, so nothing can be stored inside it."}}{{else}}{{try}}{{if eq $A $n}}{{$v := trimSpace $b}}{{$ad := kindOf $a true}}{{$ae := "That name holds a list or a group. Set a name inside it (Key:Sub), or delete it first."}}{{if hasPrefix $v "{"}}{{if and $j (eq "slice" $ad)}}{{$f = $ae}}{{else}}{{$b = jsonToSdict $v}}{{end}}{{else}}{{if hasPrefix $v "["}}{{$f = "Lists can't be set directly; put one inside a group, e.g. {\"Tags\": [\"a\"]}."}}{{else}}{{if and $j (in (cslice "map" "slice") $ad)}}{{$f = $ae}}{{end}}{{end}}{{end}}{{end}}{{if not $f}}{{$o = "set"}}{{if ge (len $h) 2}}{{$i := $u.Set $G $b}}{{dbSet $d $q $k}}{{else}}{{dbSet $d $c $b}}{{end}}{{end}}{{catch}}{{$f = $O}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{$n = printf "%T" $b}}{{if $f}}{{$P = "⚠️"}}{{$m = $f}}{{$b = ""}}{{else}}{{if and (eq $A $n) (not $b)}}{{$b = "\"\""}}{{else}}{{if ne $A $n}}{{try}}{{$b = json $b true}}{{catch}}{{$b = joinStr "" "(unable to render type " $n ")"}}{{end}}{{end}}{{end}}{{$m = joinStr "" "Value successfully " $o "!"}}{{if not $B}}{{deleteTrigger $ag}}{{end}}{{end}}{{else}}{{$P = "⚠️"}}{{if not $V}}{{$m = joinStr "" "Invalid operation provided: " (or $e $E) ""}}{{else}}{{if not $c}}{{$m = "You must provide a key!"}}{{else}}{{if not $W}}{{$m = "You must provide a value!"}}{{end}}{{end}}{{end}}{{end}}{{$m = joinStr " " $P $m}}{{$af := sub 4096 9}}{{if gt (len (toRune $b)) $af}}{{$b = joinStr "" (slice (split $b "") 0 $af) "…"}}{{end}}{{$z := or $c $E}}{{if gt (len (toRune $z)) 1017}}{{$z = joinStr "" (slice (split $z "") 0 1016) "…"}}{{end}}{{$S := "Server-wide"}}{{if toInt $F}}{{$S = joinStr "" "<@" $F ">"}}{{end}}{{if $B}}{{if not $x}}{{$w = joinStr "" "Database Operation: `" $U "`"}}{{$ar := cembed "title" $w "color" $ah "description" (joinStr "" "```\n" (or $b $E) "\n```") "fields" (cslice (sdict "name" "Whose data" "value" $S "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $z "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $m "```") "inline" false))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" $ar)}}{{end}}{{else}}{{if $L}}{{if not (and $L .ExecData.Title)}}{{$w = joinStr "" "Database Operation: `" $e "`"}}{{end}}{{execCC $aj $an 0 (sdict "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" $w "Description" (joinStr "" "```\n" (or $b $E) "\n```") "AuthorID" $F "Fields" (cslice (sdict "name" "Whose data" "value" $S "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $z "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $m "```") "inline" false)))}}{{else}}
Use /db as a slash command: view · browse · set · add · remove · delete · export
{{end}}{{end}}