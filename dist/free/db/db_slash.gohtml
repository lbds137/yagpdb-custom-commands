{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `db`
  Group: `Utility`
  Slash description: `Advanced: read or change stored server settings`
  Defer mode: `None`
  Dependencies: `embed_exec` (the ExecData path only)

  The slash version of retired/db.gohtml: same engine, ephemeral sendResponse.
  inactivity's "date" execCC still arrives on the ExecData path (embed_exec).

  Slash subcommand: `view show one stored value`
  Slash option: `view.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `view.user user another member's own data (staff)`
  Slash subcommand: `browse list the names inside a group`
  Slash option: `browse.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `browse.user user another member's own data (staff)`
  Slash subcommand: `set replace a stored value`
  Slash option: `set.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `set.value string! the new value: text, or a JSON object for a group`
  Slash option: `set.user user another member's own data (staff)`
  Slash subcommand: `add add an item to a list or group`
  Slash option: `add.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `add.value string! the new value (JSON for lists and groups)`
  Slash option: `add.user user another member's own data (staff)`
  Slash subcommand: `remove take an item out of a list or group`
  Slash option: `remove.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `remove.value string! the item to take out (JSON for lists and groups)`
  Slash option: `remove.user user another member's own data (staff)`
  Slash subcommand: `delete delete a stored entry`
  Slash option: `delete.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `delete.user user another member's own data (staff)`
  Slash subcommand: `export download entries as a JSON file`
  Slash option: `export.key string empty = all entries`
  Slash option: `export.user user another member's own data (staff)`

  view = get, browse = keys, export = dump. Rows: staff default to the global row 0,
  a picked `user` targets that member, everyone else their own row.
*/ -}}
{{$S := ((dbGet 0 "Global")).Value}}{{$ad := toInt ($S.Get "Delete Trigger Delay")}}{{$ae := toInt ($S.Get "Embed Color")}}{{$af := ((dbGet 0 "Commands")).Value}}{{$ag := toInt ($af.Get "embed_exec")}}{{$ah := ((dbGet 0 "Roles")).Value}}{{$ai := toInt ($ah.Get "Staff")}}{{$aj := ((dbGet 0 "Channels")).Value}}{{$ak := toInt ($aj.Get "YAGPDB")}}{{$J := "map[string]interface {}"}}{{$z := "string"}}{{$d := .Member.User.ID}}{{$e := ""}}{{$T := ""}}{{$c := ""}}{{$a := ""}}{{$n := ""}}{{$v := ""}}{{$A := false}}{{$al := false}}{{$K := or .ExecData.UserID .ExecData.Operation .ExecData.Key .ExecData.Value .ExecData.Title}}{{if $K}}{{$d = .ExecData.UserID}}{{$e = .ExecData.Operation}}{{$c = .ExecData.Key}}{{$a = .ExecData.Value}}{{$n = printf "%T" $a}}{{$v = .ExecData.Title}}{{else}}{{if .IsSlashCommand}}{{$A = true}}{{$T = .SubCommand}}{{$e = .SubCommand}}{{if eq $e "view"}}{{$e = "get"}}{{else}}{{if eq $e "browse"}}{{$e = "keys"}}{{else}}{{if eq $e "export"}}{{$e = "dump"}}{{end}}{{end}}{{end}}{{$c = or .Options.key ""}}{{$a = or .Options.value ""}}{{$n = printf "%T" $a}}{{if hasRoleID $ai}}{{$d = 0}}{{if .Options.user}}{{$d = toInt .Options.user.ID}}{{$al = true}}{{end}}{{end}}{{end}}{{end}}{{$L := eq "keys" $e}}{{$B := eq "delete" $e}}{{$C := eq "get" $e}}{{$am := eq "set" $e}}{{$t := eq "add" $e}}{{$M := eq "remove" $e}}{{$w := eq "dump" $e}}{{$U := or $L $B $C $am $t $M $w}}{{$V := or $a $L $B $C $w}}{{$D := "(nil)"}}{{$N := "I couldn't read that value. A group must be a valid JSON object, e.g. {\"a\": 1}."}}{{$l := ""}}{{$O := "✅"}}{{$E := $d}}{{if and $w (not $c)}}{{$c = "all"}}{{end}}{{if and $U $c $V}}{{$b := ""}}{{$m := false}}{{$h := split $c ":"}}{{$j := ""}}{{$u := ""}}{{$P := false}}{{$r := index $h 0}}{{$F := index $h (sub (len $h) 1)}}{{if ge (len $h) 2}}{{$j = ((dbGet $d $r)).Value}}{{if eq $J (printf "%T" $j)}}{{$j = sdict $j}}{{end}}{{$b = $j}}{{$m = true}}{{$c = $r}}{{range $G := slice $h 1}}{{$c = joinStr " > " $c $G}}{{if and $m (eq "map" (kindOf $b true))}}{{$u = $b}}{{$P = true}}{{$m = $b.HasKey $G}}{{$b = $b.Get $G}}{{if eq $J (printf "%T" $b)}}{{$b = sdict $b}}{{$i := $u.Set $G $b}}{{end}}{{else}}{{$m = false}}{{$P = false}}{{$b = ""}}{{end}}{{end}}{{else}}{{with dbGet $d $c}}{{$m = true}}{{$b = .Value}}{{if eq $J (printf "%T" $b)}}{{$b = sdict $b}}{{end}}{{end}}{{end}}{{$ap := printf "%T" $b}}{{$g := ""}}{{$o := ""}}{{if $w}}{{$H := $d}}{{$x := sdict}}{{if and $c (ne $c "all")}}{{$s := dbGet $H $c}}{{if and $s $s.Value}}{{$i := $x.Set $c $s.Value}}{{end}}{{else}}{{range $s := dbGetPattern $H "%" 100 0}}{{if $s.Value}}{{$i := $x.Set $s.Key $s.Value}}{{end}}{{end}}{{end}}{{$o = "dumped"}}{{$E = $H}}{{$W := json $x true}}{{$X := joinStr "" "db_dump_" (toString $H) "_" (currentTime.Unix)}}{{if $A}}{{sendResponse nil (complexMessage "content" (joinStr "" "Exported " (len $x) " entries to file") "file" $W "filename" $X "ephemeral" true)}}{{else}}{{sendMessage nil (complexMessage "file" $W "filename" $X)}}{{end}}{{$a = joinStr "" "Exported " (len $x) " entries to file"}}{{else}}{{if $L}}{{if eq "map" (kindOf $b true)}}{{$o = "inspected"}}{{$a = cslice}}{{range $k, $I := $b}}{{$a = $a.Append $k}}{{end}}{{else}}{{$g = "That name isn't a group of entries, so there is nothing to list."}}{{end}}{{else}}{{if or $B $C}}{{if $m}}{{$a = $b}}{{if $B}}{{$o = "deleted"}}{{if ge (len $h) 2}}{{$i := $u.Del $F}}{{dbSet $d $r $j}}{{else}}{{dbDel $d $c}}{{end}}{{else}}{{if $C}}{{$o = "retrieved"}}{{end}}{{end}}{{else}}{{$g = "Nothing is stored under that name."}}{{end}}{{else}}{{if or $t $M}}{{try}}{{$p := $a}}{{if eq $z $n}}{{$a = trimSpace $a}}{{$p = $a}}{{if and (gt (len $a) 0) (eq "{" (index $a 0 | printf "%c"))}}{{$p = jsonToSdict $a}}{{end}}{{end}}{{if $t}}{{$o = "added"}}{{else}}{{$o = "removed"}}{{end}}{{$Y := and $m (eq "slice" (kindOf $b true))}}{{$Z := and $m (eq "map" (kindOf $b true))}}{{$an := eq "map" (kindOf $p true)}}{{if and $Y $t}}{{$f := cslice}}{{range $q := $b}}{{$f = $f.Append $q}}{{end}}{{$f = $f.Append $p}}{{$b = $f}}{{if ge (len $h) 2}}{{$i := $u.Set $F $b}}{{dbSet $d $r $j}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $p}}{{else}}{{if and $Y $M}}{{$f := cslice}}{{$Q := false}}{{range $q := $b}}{{if and (not $Q) (eq (str $q) (str $p))}}{{$Q = true}}{{else}}{{$f = $f.Append $q}}{{end}}{{end}}{{if $Q}}{{$b = $f}}{{if ge (len $h) 2}}{{$i := $u.Set $F $b}}{{dbSet $d $r $j}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $p}}{{else}}{{$g = "Nothing is stored under that name."}}{{end}}{{else}}{{if and $Z $an}}{{$a = $p}}{{$aa := false}}{{range $k, $I := $a}}{{if $t}}{{$ab := $b.Get $k}}{{if and (eq "slice" (kindOf $ab true)) (eq "slice" (kindOf $I true))}}{{$f := cslice}}{{range $q := $ab}}{{$f = $f.Append $q}}{{end}}{{range $q := $I}}{{$f = $f.Append $q}}{{end}}{{$i := $b.Set $k $f}}{{else}}{{$i := $b.Set $k $I}}{{end}}{{else}}{{if $b.HasKey $k}}{{$i := $a.Set $k ($b.Get $k)}}{{$i := $b.Del $k}}{{$aa = true}}{{else}}{{$i := $a.Del $k}}{{end}}{{end}}{{end}}{{if or $t $aa}}{{if ge (len $h) 2}}{{dbSet $d $r $j}}{{else}}{{dbSet $d $c $b}}{{end}}{{else}}{{$g = "Nothing is stored under that name."}}{{end}}{{else}}{{if $Z}}{{$g = $N}}{{else}}{{$g = "That name isn't a list or a group, so you can't add to or remove from it."}}{{end}}{{end}}{{end}}{{end}}{{catch}}{{$g = $N}}{{end}}{{else}}{{if and (ge (len $h) 2) (not $P)}}{{$g = "That group doesn't exist, so nothing can be stored inside it."}}{{else}}{{try}}{{if eq $z $n}}{{$a = trimSpace $a}}{{if and (gt (len $a) 0) (eq "{" (index $a 0 | printf "%c"))}}{{$a = jsonToSdict $a}}{{else}}{{if and (gt (len $a) 0) (eq "[" (index $a 0 | printf "%c"))}}{{$g = "Lists can't be set directly: build one with /db add."}}{{else}}{{if and $m (or (eq "map" (kindOf $b true)) (eq "slice" (kindOf $b true)))}}{{$g = "That name holds a list or a group. Set a name inside it (Key:Sub), or delete it first."}}{{end}}{{end}}{{end}}{{end}}{{if not $g}}{{$o = "set"}}{{if ge (len $h) 2}}{{$i := $u.Set $F $a}}{{dbSet $d $r $j}}{{else}}{{dbSet $d $c $a}}{{end}}{{end}}{{catch}}{{$g = $N}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{$n = printf "%T" $a}}{{if $g}}{{$O = "⚠️"}}{{$l = $g}}{{$a = ""}}{{else}}{{if and (eq $z $n) (not $a)}}{{$a = "\"\""}}{{else}}{{if ne $z $n}}{{try}}{{$a = json $a true}}{{catch}}{{$a = joinStr "" "(unable to render type " $n ")"}}{{end}}{{end}}{{end}}{{$l = joinStr "" "Value successfully " $o "!"}}{{if not $A}}{{deleteTrigger $ad}}{{end}}{{end}}{{else}}{{$O = "⚠️"}}{{if not $U}}{{$l = joinStr "" "Invalid operation provided: " (or $e $D) ""}}{{else}}{{if not $c}}{{$l = "You must provide a key!"}}{{else}}{{if not $V}}{{$l = "You must provide a value!"}}{{end}}{{end}}{{end}}{{end}}{{$l = joinStr " " $O $l}}{{$ac := sub 4096 9}}{{if gt (len (toRune $a)) $ac}}{{$a = joinStr "" (slice (split $a "") 0 $ac) "…"}}{{end}}{{$y := or $c $D}}{{if gt (len (toRune $y)) 1017}}{{$y = joinStr "" (slice (split $y "") 0 1016) "…"}}{{end}}{{$R := "Server-wide"}}{{if toInt $E}}{{$R = joinStr "" "<@" $E ">"}}{{end}}{{if $A}}{{if not $w}}{{$v = joinStr "" "Database Operation: `" $T "`"}}{{$ao := cembed "title" $v "color" $ae "description" (joinStr "" "```\n" (or $a $D) "\n```") "fields" (cslice (sdict "name" "Whose data" "value" $R "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $y "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $l "```") "inline" false))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" $ao)}}{{end}}{{else}}{{if $K}}{{if not (and $K .ExecData.Title)}}{{$v = joinStr "" "Database Operation: `" $e "`"}}{{end}}{{execCC $ag $ak 0 (sdict "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" $v "Description" (joinStr "" "```\n" (or $a $D) "\n```") "AuthorID" $E "Fields" (cslice (sdict "name" "Whose data" "value" $R "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $y "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $l "```") "inline" false)))}}{{else}}
Use /db as a slash command: view · browse · set · add · remove · delete · export
{{end}}{{end}}