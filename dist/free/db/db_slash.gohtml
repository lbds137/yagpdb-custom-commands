{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `db`
  Group: `Utility`
  Defer mode: `None`
  Dependencies: `embed_exec` (the ExecData path only)

  The slash version of retired/db.gohtml (text /db retired 2026-10-01): same engine,
  ephemeral sendResponse instead of embed_exec. inactivity's "date" execCC still
  arrives on the ExecData path, which keeps db.gohtml's behavior, embed_exec included.

  Slash subcommand: `view show one value`
  Slash option: `view.key string! database key, nest with :`
  Slash option: `view.user user another member (staff)`
  Slash subcommand: `browse list a dictionary's keys`
  Slash option: `browse.key string! dictionary key, nest with :`
  Slash option: `browse.user user another member (staff)`
  Slash subcommand: `set set a value`
  Slash option: `set.key string! database key, nest with :`
  Slash option: `set.value string! value, JSON for dicts`
  Slash option: `set.user user another member (staff)`
  Slash subcommand: `add add to a dict or array`
  Slash option: `add.key string! array or dictionary key, nest with :`
  Slash option: `add.value string! value, JSON for dicts`
  Slash option: `add.user user another member (staff)`
  Slash subcommand: `remove remove from a dict or array`
  Slash option: `remove.key string! array or dictionary key, nest with :`
  Slash option: `remove.value string! value, JSON for dicts`
  Slash option: `remove.user user another member (staff)`
  Slash subcommand: `delete delete a key`
  Slash option: `delete.key string! database key, nest with :`
  Slash option: `delete.user user another member (staff)`
  Slash subcommand: `export export entries as a JSON file`
  Slash option: `export.key string empty = all entries`
  Slash option: `export.user user another member (staff)`

  view = get, browse = keys, export = dump. Rows: staff default to the global row 0
  (the old `:0` without the colon), a picked `user` targets that member, everyone
  else their own row.
*/ -}}
{{$Q := ((dbGet 0 "Global")).Value}}{{$ab := toInt ($Q.Get "Delete Trigger Delay")}}{{$ac := toInt ($Q.Get "Embed Color")}}{{$ad := ((dbGet 0 "Commands")).Value}}{{$ae := toInt ($ad.Get "embed_exec")}}{{$af := ((dbGet 0 "Roles")).Value}}{{$ag := toInt ($af.Get "Staff")}}{{$ah := ((dbGet 0 "Channels")).Value}}{{$ai := toInt ($ah.Get "YAGPDB")}}{{$I := "map[string]interface {}"}}{{$y := "string"}}{{$d := .Member.User.ID}}{{$e := ""}}{{$R := ""}}{{$c := ""}}{{$a := ""}}{{$l := ""}}{{$u := ""}}{{$z := false}}{{$aj := false}}{{$J := or .ExecData.UserID .ExecData.Operation .ExecData.Key .ExecData.Value .ExecData.Title}}{{if $J}}{{$d = .ExecData.UserID}}{{$e = .ExecData.Operation}}{{$c = .ExecData.Key}}{{$a = .ExecData.Value}}{{$l = printf "%T" $a}}{{$u = .ExecData.Title}}{{else}}{{if .IsSlashCommand}}{{$z = true}}{{$R = .SubCommand}}{{$e = .SubCommand}}{{if eq $e "view"}}{{$e = "get"}}{{else}}{{if eq $e "browse"}}{{$e = "keys"}}{{else}}{{if eq $e "export"}}{{$e = "dump"}}{{end}}{{end}}{{end}}{{$c = or .Options.key ""}}{{$a = or .Options.value ""}}{{$l = printf "%T" $a}}{{if hasRoleID $ag}}{{$d = 0}}{{if .Options.user}}{{$d = toInt .Options.user.ID}}{{$aj = true}}{{end}}{{end}}{{end}}{{end}}{{$K := eq "keys" $e}}{{$A := eq "delete" $e}}{{$B := eq "get" $e}}{{$ak := eq "set" $e}}{{$s := eq "add" $e}}{{$L := eq "remove" $e}}{{$v := eq "dump" $e}}{{$S := or $K $A $B $ak $s $L $v}}{{$T := or $a $K $A $B $v}}{{$C := "(nil)"}}{{$M := "Invalid value provided! Please double check your input and try again."}}{{$k := ""}}{{$N := "✅"}}{{$D := $d}}{{if and $v (not $c)}}{{$c = "all"}}{{end}}{{if and $S $c $T}}{{$b := ""}}{{$m := false}}{{$g := split $c ":"}}{{$i := ""}}{{$t := ""}}{{$O := false}}{{$p := index $g 0}}{{$E := index $g (sub (len $g) 1)}}{{if ge (len $g) 2}}{{$i = ((dbGet $d $p)).Value}}{{if eq $I (printf "%T" $i)}}{{$i = sdict $i}}{{end}}{{$b = $i}}{{$m = true}}{{$c = $p}}{{range $F := slice $g 1}}{{$c = joinStr " > " $c $F}}{{if and $m (eq "map" (kindOf $b true))}}{{$t = $b}}{{$O = true}}{{$m = $b.HasKey $F}}{{$b = $b.Get $F}}{{if eq $I (printf "%T" $b)}}{{$b = sdict $b}}{{$t.Set $F $b}}{{end}}{{else}}{{$m = false}}{{$O = false}}{{$b = ""}}{{end}}{{end}}{{else}}{{with dbGet $d $c}}{{$m = true}}{{$b = .Value}}{{if eq $I (printf "%T" $b)}}{{$b = sdict $b}}{{end}}{{end}}{{end}}{{$an := printf "%T" $b}}{{$h := ""}}{{$n := ""}}{{if $v}}{{$G := $d}}{{$w := sdict}}{{if and $c (ne $c "all")}}{{$q := dbGet $G $c}}{{if and $q $q.Value}}{{$w.Set $c $q.Value}}{{end}}{{else}}{{range $q := dbGetPattern $G "%" 100 0}}{{if $q.Value}}{{$w.Set $q.Key $q.Value}}{{end}}{{end}}{{end}}{{$n = "dumped"}}{{$D = $G}}{{$U := json $w true}}{{$V := joinStr "" "db_dump_" (toString $G) "_" (currentTime.Unix)}}{{if $z}}{{sendResponse nil (complexMessage "content" (joinStr "" "Exported " (len $w) " entries to file") "file" $U "filename" $V "ephemeral" true)}}{{else}}{{sendMessage nil (complexMessage "file" $U "filename" $V)}}{{end}}{{$a = joinStr "" "Exported " (len $w) " entries to file"}}{{else}}{{if $K}}{{if eq "map" (kindOf $b true)}}{{$n = "inspected"}}{{$a = cslice}}{{range $j, $H := $b}}{{$a = $a.Append $j}}{{end}}{{else}}{{$h = "No dictionary found for the given key!"}}{{end}}{{else}}{{if or $A $B}}{{if $m}}{{$a = $b}}{{if $A}}{{$n = "deleted"}}{{if ge (len $g) 2}}{{$t.Del $E}}{{dbSet $d $p $i}}{{else}}{{dbDel $d $c}}{{end}}{{else}}{{if $B}}{{$n = "retrieved"}}{{end}}{{end}}{{else}}{{$h = "No value found!"}}{{end}}{{else}}{{if or $s $L}}{{try}}{{$r := $a}}{{if eq $y $l}}{{if and (gt (len $a) 0) (eq "{" (index $a 0 | printf "%c"))}}{{$r = jsonToSdict $a}}{{end}}{{end}}{{if $s}}{{$n = "added"}}{{else}}{{$n = "removed"}}{{end}}{{$W := and $m (eq "slice" (kindOf $b true))}}{{$X := and $m (eq "map" (kindOf $b true))}}{{$al := eq "map" (kindOf $r true)}}{{if and $W $s}}{{$f := cslice}}{{range $o := $b}}{{$f = $f.Append $o}}{{end}}{{$f = $f.Append $r}}{{$b = $f}}{{if ge (len $g) 2}}{{$t.Set $E $b}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $r}}{{else}}{{if and $W $L}}{{$f := cslice}}{{$P := false}}{{range $o := $b}}{{if and (not $P) (eq (str $o) (str $r))}}{{$P = true}}{{else}}{{$f = $f.Append $o}}{{end}}{{end}}{{if $P}}{{$b = $f}}{{if ge (len $g) 2}}{{$t.Set $E $b}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $r}}{{else}}{{$h = "No value found!"}}{{end}}{{else}}{{if and $X $al}}{{$a = $r}}{{$Y := false}}{{range $j, $H := $a}}{{if $s}}{{$Z := $b.Get $j}}{{if and (eq "slice" (kindOf $Z true)) (eq "slice" (kindOf $H true))}}{{$f := cslice}}{{range $o := $Z}}{{$f = $f.Append $o}}{{end}}{{range $o := $H}}{{$f = $f.Append $o}}{{end}}{{$b.Set $j $f}}{{else}}{{$b.Set $j $H}}{{end}}{{else}}{{if $b.HasKey $j}}{{$a.Set $j ($b.Get $j)}}{{$b.Del $j}}{{$Y = true}}{{else}}{{$a.Del $j}}{{end}}{{end}}{{end}}{{if or $s $Y}}{{if ge (len $g) 2}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $b}}{{end}}{{else}}{{$h = "No value found!"}}{{end}}{{else}}{{if $X}}{{$h = $M}}{{else}}{{$h = "No array or dictionary found for the given key!"}}{{end}}{{end}}{{end}}{{end}}{{catch}}{{$h = $M}}{{end}}{{else}}{{if and (ge (len $g) 2) (not $O)}}{{$h = "No dictionary found for the given key!"}}{{else}}{{try}}{{if eq $y $l}}{{$a = jsonToSdict $a}}{{end}}{{$n = "set"}}{{if ge (len $g) 2}}{{$t.Set $E $a}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $a}}{{end}}{{catch}}{{$h = $M}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{$l = printf "%T" $a}}{{if $h}}{{$N = "⚠️"}}{{$k = $h}}{{$a = ""}}{{else}}{{if and (eq $y $l) (not $a)}}{{$a = "\"\""}}{{else}}{{if ne $y $l}}{{try}}{{$a = json $a true}}{{catch}}{{$a = joinStr "" "(unable to render type " $l ")"}}{{end}}{{end}}{{end}}{{$k = joinStr "" "Value successfully " $n "!"}}{{if not $z}}{{deleteTrigger $ab}}{{end}}{{end}}{{else}}{{$N = "⚠️"}}{{if not $S}}{{$k = joinStr "" "Invalid operation provided: " (or $e $C) ""}}{{else}}{{if not $c}}{{$k = "You must provide a key!"}}{{else}}{{if not $T}}{{$k = "You must provide a value!"}}{{end}}{{end}}{{end}}{{end}}{{$k = joinStr " " $N $k}}{{$aa := sub 4096 9}}{{if gt (len (toRune $a)) $aa}}{{$a = joinStr "" (slice (split $a "") 0 $aa) "…"}}{{end}}{{$x := or $c $C}}{{if gt (len (toRune $x)) 1017}}{{$x = joinStr "" (slice (split $x "") 0 1016) "…"}}{{end}}{{if $z}}{{if not $v}}{{$u = joinStr "" "Database Operation: `" $R "`"}}{{$am := cembed "title" $u "color" $ac "description" (joinStr "" "```\n" (or $a $C) "\n```") "fields" (cslice (sdict "name" "User ID" "value" (joinStr "" "```\n" $D "```") "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $x "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $k "```") "inline" false))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" $am)}}{{end}}{{else}}{{if $J}}{{if not (and $J .ExecData.Title)}}{{$u = joinStr "" "Database Operation: `" $e "`"}}{{end}}{{execCC $ae $ai 0 (sdict "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" $u "Description" (joinStr "" "```\n" (or $a $C) "\n```") "AuthorID" $D "Fields" (cslice (sdict "name" "User ID" "value" (joinStr "" "```\n" $D "```") "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $x "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $k "```") "inline" false)))}}{{else}}
Use /db as a slash command: view · browse · set · add · remove · delete · export
{{end}}{{end}}