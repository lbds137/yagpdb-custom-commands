{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `db`
  Group: `Utility`
  Slash description: `Advanced: read or change stored server settings`
  Defer mode: `None`
  Dependencies: `embed_exec` (the ExecData path only)

  The slash version of retired/db.gohtml (text /db retired 2026-10-01): same engine,
  ephemeral sendResponse instead of embed_exec. inactivity's "date" execCC still
  arrives on the ExecData path, which keeps db.gohtml's behavior, embed_exec included.

  Slash subcommand: `view show one stored value`
  Slash option: `view.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `view.user user another member's own data (staff)`
  Slash subcommand: `browse list the names inside a group`
  Slash option: `browse.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `browse.user user another member's own data (staff)`
  Slash subcommand: `set replace a stored value`
  Slash option: `set.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `set.value string! the new value (JSON for lists and groups)`
  Slash option: `set.user user another member's own data (staff)`
  Slash subcommand: `add add an item to a list or group`
  Slash option: `add.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `add.value string! the new value (JSON for lists and groups)`
  Slash option: `add.user user another member's own data (staff)`
  Slash subcommand: `remove take an item out of a list or group`
  Slash option: `remove.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `remove.value string! the item to take out (JSON for lists and groups)`
  Slash option: `remove.user user another member's own data (staff)`
  Slash subcommand: `delete delete a stored entry`
  Slash option: `delete.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `delete.user user another member's own data (staff)`
  Slash subcommand: `export export entries as a JSON file`
  Slash option: `export.key string empty = all entries`
  Slash option: `export.user user another member's own data (staff)`

  view = get, browse = keys, export = dump. Rows: staff default to the global row 0
  (the old `:0` without the colon), a picked `user` targets that member, everyone
  else their own row.
*/ -}}
{{$R := ((dbGet 0 "Global")).Value}}{{$ac := toInt ($R.Get "Delete Trigger Delay")}}{{$ad := toInt ($R.Get "Embed Color")}}{{$ae := ((dbGet 0 "Commands")).Value}}{{$af := toInt ($ae.Get "embed_exec")}}{{$ag := ((dbGet 0 "Roles")).Value}}{{$ah := toInt ($ag.Get "Staff")}}{{$ai := ((dbGet 0 "Channels")).Value}}{{$aj := toInt ($ai.Get "YAGPDB")}}{{$J := "map[string]interface {}"}}{{$z := "string"}}{{$d := .Member.User.ID}}{{$e := ""}}{{$S := ""}}{{$c := ""}}{{$a := ""}}{{$m := ""}}{{$v := ""}}{{$A := false}}{{$ak := false}}{{$K := or .ExecData.UserID .ExecData.Operation .ExecData.Key .ExecData.Value .ExecData.Title}}{{if $K}}{{$d = .ExecData.UserID}}{{$e = .ExecData.Operation}}{{$c = .ExecData.Key}}{{$a = .ExecData.Value}}{{$m = printf "%T" $a}}{{$v = .ExecData.Title}}{{else}}{{if .IsSlashCommand}}{{$A = true}}{{$S = .SubCommand}}{{$e = .SubCommand}}{{if eq $e "view"}}{{$e = "get"}}{{else}}{{if eq $e "browse"}}{{$e = "keys"}}{{else}}{{if eq $e "export"}}{{$e = "dump"}}{{end}}{{end}}{{end}}{{$c = or .Options.key ""}}{{$a = or .Options.value ""}}{{$m = printf "%T" $a}}{{if hasRoleID $ah}}{{$d = 0}}{{if .Options.user}}{{$d = toInt .Options.user.ID}}{{$ak = true}}{{end}}{{end}}{{end}}{{end}}{{$L := eq "keys" $e}}{{$B := eq "delete" $e}}{{$C := eq "get" $e}}{{$al := eq "set" $e}}{{$t := eq "add" $e}}{{$M := eq "remove" $e}}{{$w := eq "dump" $e}}{{$T := or $L $B $C $al $t $M $w}}{{$U := or $a $L $B $C $w}}{{$D := "(nil)"}}{{$N := "Invalid value provided! Please double check your input and try again."}}{{$l := ""}}{{$O := "✅"}}{{$E := $d}}{{if and $w (not $c)}}{{$c = "all"}}{{end}}{{if and $T $c $U}}{{$b := ""}}{{$n := false}}{{$g := split $c ":"}}{{$j := ""}}{{$u := ""}}{{$P := false}}{{$q := index $g 0}}{{$F := index $g (sub (len $g) 1)}}{{if ge (len $g) 2}}{{$j = ((dbGet $d $q)).Value}}{{if eq $J (printf "%T" $j)}}{{$j = sdict $j}}{{end}}{{$b = $j}}{{$n = true}}{{$c = $q}}{{range $G := slice $g 1}}{{$c = joinStr " > " $c $G}}{{if and $n (eq "map" (kindOf $b true))}}{{$u = $b}}{{$P = true}}{{$n = $b.HasKey $G}}{{$b = $b.Get $G}}{{if eq $J (printf "%T" $b)}}{{$b = sdict $b}}{{$h := $u.Set $G $b}}{{end}}{{else}}{{$n = false}}{{$P = false}}{{$b = ""}}{{end}}{{end}}{{else}}{{with dbGet $d $c}}{{$n = true}}{{$b = .Value}}{{if eq $J (printf "%T" $b)}}{{$b = sdict $b}}{{end}}{{end}}{{end}}{{$ao := printf "%T" $b}}{{$i := ""}}{{$o := ""}}{{if $w}}{{$H := $d}}{{$x := sdict}}{{if and $c (ne $c "all")}}{{$r := dbGet $H $c}}{{if and $r $r.Value}}{{$h := $x.Set $c $r.Value}}{{end}}{{else}}{{range $r := dbGetPattern $H "%" 100 0}}{{if $r.Value}}{{$h := $x.Set $r.Key $r.Value}}{{end}}{{end}}{{end}}{{$o = "dumped"}}{{$E = $H}}{{$V := json $x true}}{{$W := joinStr "" "db_dump_" (toString $H) "_" (currentTime.Unix)}}{{if $A}}{{sendResponse nil (complexMessage "content" (joinStr "" "Exported " (len $x) " entries to file") "file" $V "filename" $W "ephemeral" true)}}{{else}}{{sendMessage nil (complexMessage "file" $V "filename" $W)}}{{end}}{{$a = joinStr "" "Exported " (len $x) " entries to file"}}{{else}}{{if $L}}{{if eq "map" (kindOf $b true)}}{{$o = "inspected"}}{{$a = cslice}}{{range $k, $I := $b}}{{$a = $a.Append $k}}{{end}}{{else}}{{$i = "No dictionary found for the given key!"}}{{end}}{{else}}{{if or $B $C}}{{if $n}}{{$a = $b}}{{if $B}}{{$o = "deleted"}}{{if ge (len $g) 2}}{{$h := $u.Del $F}}{{dbSet $d $q $j}}{{else}}{{dbDel $d $c}}{{end}}{{else}}{{if $C}}{{$o = "retrieved"}}{{end}}{{end}}{{else}}{{$i = "No value found!"}}{{end}}{{else}}{{if or $t $M}}{{try}}{{$s := $a}}{{if eq $z $m}}{{if and (gt (len $a) 0) (eq "{" (index $a 0 | printf "%c"))}}{{$s = jsonToSdict $a}}{{end}}{{end}}{{if $t}}{{$o = "added"}}{{else}}{{$o = "removed"}}{{end}}{{$X := and $n (eq "slice" (kindOf $b true))}}{{$Y := and $n (eq "map" (kindOf $b true))}}{{$am := eq "map" (kindOf $s true)}}{{if and $X $t}}{{$f := cslice}}{{range $p := $b}}{{$f = $f.Append $p}}{{end}}{{$f = $f.Append $s}}{{$b = $f}}{{if ge (len $g) 2}}{{$h := $u.Set $F $b}}{{dbSet $d $q $j}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $s}}{{else}}{{if and $X $M}}{{$f := cslice}}{{$Q := false}}{{range $p := $b}}{{if and (not $Q) (eq (str $p) (str $s))}}{{$Q = true}}{{else}}{{$f = $f.Append $p}}{{end}}{{end}}{{if $Q}}{{$b = $f}}{{if ge (len $g) 2}}{{$h := $u.Set $F $b}}{{dbSet $d $q $j}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $s}}{{else}}{{$i = "No value found!"}}{{end}}{{else}}{{if and $Y $am}}{{$a = $s}}{{$Z := false}}{{range $k, $I := $a}}{{if $t}}{{$aa := $b.Get $k}}{{if and (eq "slice" (kindOf $aa true)) (eq "slice" (kindOf $I true))}}{{$f := cslice}}{{range $p := $aa}}{{$f = $f.Append $p}}{{end}}{{range $p := $I}}{{$f = $f.Append $p}}{{end}}{{$h := $b.Set $k $f}}{{else}}{{$h := $b.Set $k $I}}{{end}}{{else}}{{if $b.HasKey $k}}{{$h := $a.Set $k ($b.Get $k)}}{{$h := $b.Del $k}}{{$Z = true}}{{else}}{{$h := $a.Del $k}}{{end}}{{end}}{{end}}{{if or $t $Z}}{{if ge (len $g) 2}}{{dbSet $d $q $j}}{{else}}{{dbSet $d $c $b}}{{end}}{{else}}{{$i = "No value found!"}}{{end}}{{else}}{{if $Y}}{{$i = $N}}{{else}}{{$i = "No array or dictionary found for the given key!"}}{{end}}{{end}}{{end}}{{end}}{{catch}}{{$i = $N}}{{end}}{{else}}{{if and (ge (len $g) 2) (not $P)}}{{$i = "No dictionary found for the given key!"}}{{else}}{{try}}{{if eq $z $m}}{{$a = jsonToSdict $a}}{{end}}{{$o = "set"}}{{if ge (len $g) 2}}{{$h := $u.Set $F $a}}{{dbSet $d $q $j}}{{else}}{{dbSet $d $c $a}}{{end}}{{catch}}{{$i = $N}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{$m = printf "%T" $a}}{{if $i}}{{$O = "⚠️"}}{{$l = $i}}{{$a = ""}}{{else}}{{if and (eq $z $m) (not $a)}}{{$a = "\"\""}}{{else}}{{if ne $z $m}}{{try}}{{$a = json $a true}}{{catch}}{{$a = joinStr "" "(unable to render type " $m ")"}}{{end}}{{end}}{{end}}{{$l = joinStr "" "Value successfully " $o "!"}}{{if not $A}}{{deleteTrigger $ac}}{{end}}{{end}}{{else}}{{$O = "⚠️"}}{{if not $T}}{{$l = joinStr "" "Invalid operation provided: " (or $e $D) ""}}{{else}}{{if not $c}}{{$l = "You must provide a key!"}}{{else}}{{if not $U}}{{$l = "You must provide a value!"}}{{end}}{{end}}{{end}}{{end}}{{$l = joinStr " " $O $l}}{{$ab := sub 4096 9}}{{if gt (len (toRune $a)) $ab}}{{$a = joinStr "" (slice (split $a "") 0 $ab) "…"}}{{end}}{{$y := or $c $D}}{{if gt (len (toRune $y)) 1017}}{{$y = joinStr "" (slice (split $y "") 0 1016) "…"}}{{end}}{{if $A}}{{if not $w}}{{$v = joinStr "" "Database Operation: `" $S "`"}}{{$an := cembed "title" $v "color" $ad "description" (joinStr "" "```\n" (or $a $D) "\n```") "fields" (cslice (sdict "name" "User ID" "value" (joinStr "" "```\n" $E "```") "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $y "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $l "```") "inline" false))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" $an)}}{{end}}{{else}}{{if $K}}{{if not (and $K .ExecData.Title)}}{{$v = joinStr "" "Database Operation: `" $e "`"}}{{end}}{{execCC $af $aj 0 (sdict "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" $v "Description" (joinStr "" "```\n" (or $a $D) "\n```") "AuthorID" $E "Fields" (cslice (sdict "name" "User ID" "value" (joinStr "" "```\n" $E "```") "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" $y "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $l "```") "inline" false)))}}{{else}}
