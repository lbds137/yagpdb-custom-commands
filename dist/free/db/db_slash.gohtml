{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `db`
  Group: `Utility`
  Defer mode: `None`
  Dependencies: `embed_exec` (the ExecData path only)

  The slash version of db.gohtml (the text command stays): same engine, ephemeral
  sendResponse instead of embed_exec. inactivity's "date" execCC still arrives on
  the ExecData path, which keeps db.gohtml's behavior, embed_exec included.

  Slash subcommand: `view show one value`
  Slash option: `view.key string! database key, nest with :`
  Slash option: `view.user user another member (staff)`
  Slash subcommand: `browse list a dictionary's keys`
  Slash option: `browse.key string! dictionary key, nest with :`
  Slash option: `browse.user user another member (staff)`
  Slash subcommand: `set set a value`
  Slash option: `set.key string! database key, nest with :`
  Slash option: `set.value string! value, JSON for dicts`
  Slash option: `set.user user another member (staff)`
  Slash subcommand: `add add to a dict or array`
  Slash option: `add.key string! array or dictionary key, nest with :`
  Slash option: `add.value string! value, JSON for dicts`
  Slash option: `add.user user another member (staff)`
  Slash subcommand: `remove remove from a dict or array`
  Slash option: `remove.key string! array or dictionary key, nest with :`
  Slash option: `remove.value string! value, JSON for dicts`
  Slash option: `remove.user user another member (staff)`
  Slash subcommand: `delete delete a key`
  Slash option: `delete.key string! database key, nest with :`
  Slash option: `delete.user user another member (staff)`
  Slash subcommand: `export export entries as a JSON file`
  Slash option: `export.key string empty = all entries`
  Slash option: `export.user user another member (staff)`

  view = get, browse = keys, export = dump. Rows: staff default to the global row 0
  (the old `:0` without the colon), a picked `user` targets that member, everyone
  else their own row.
*/ -}}
{{$P := ((dbGet 0 "Global")).Value}}{{$aa := toInt ($P.Get "Delete Trigger Delay")}}{{$ab := toInt ($P.Get "Embed Color")}}{{$ac := ((dbGet 0 "Commands")).Value}}{{$ad := toInt ($ac.Get "embed_exec")}}{{$ae := ((dbGet 0 "Roles")).Value}}{{$af := toInt ($ae.Get "Staff")}}{{$ag := ((dbGet 0 "Channels")).Value}}{{$ah := toInt ($ag.Get "YAGPDB")}}{{$H := "map[string]interface {}"}}{{$y := "string"}}{{$d := .Member.User.ID}}{{$e := ""}}{{$Q := ""}}{{$c := ""}}{{$a := ""}}{{$l := ""}}{{$u := ""}}{{$z := false}}{{$ai := false}}{{$I := or .ExecData.UserID .ExecData.Operation .ExecData.Key .ExecData.Value .ExecData.Title}}{{if $I}}{{$d = .ExecData.UserID}}{{$e = .ExecData.Operation}}{{$c = .ExecData.Key}}{{$a = .ExecData.Value}}{{$l = printf "%T" $a}}{{$u = .ExecData.Title}}{{else}}{{if .IsSlashCommand}}{{$z = true}}{{$Q = .SubCommand}}{{$e = .SubCommand}}{{if eq $e "view"}}{{$e = "get"}}{{else}}{{if eq $e "browse"}}{{$e = "keys"}}{{else}}{{if eq $e "export"}}{{$e = "dump"}}{{end}}{{end}}{{end}}{{$c = or .Options.key ""}}{{$a = or .Options.value ""}}{{$l = printf "%T" $a}}{{if hasRoleID $af}}{{$d = 0}}{{if .Options.user}}{{$d = toInt .Options.user.ID}}{{$ai = true}}{{end}}{{end}}{{end}}{{end}}{{$J := eq "keys" $e}}{{$A := eq "delete" $e}}{{$B := eq "get" $e}}{{$aj := eq "set" $e}}{{$s := eq "add" $e}}{{$K := eq "remove" $e}}{{$v := eq "dump" $e}}{{$R := or $J $A $B $aj $s $K $v}}{{$S := or $a $J $A $B $v}}{{$w := "(nil)"}}{{$L := "Invalid value provided! Please double check your input and try again."}}{{$k := ""}}{{$M := "✅"}}{{$C := $d}}{{if and $v (not $c)}}{{$c = "all"}}{{end}}{{if and $R $c $S}}{{$b := ""}}{{$m := false}}{{$g := split $c ":"}}{{$i := ""}}{{$t := ""}}{{$N := false}}{{$p := index $g 0}}{{$D := index $g (sub (len $g) 1)}}{{if ge (len $g) 2}}{{$i = ((dbGet $d $p)).Value}}{{if eq $H (printf "%T" $i)}}{{$i = sdict $i}}{{end}}{{$b = $i}}{{$m = true}}{{$c = $p}}{{range $E := slice $g 1}}{{$c = joinStr " > " $c $E}}{{if and $m (eq "map" (kindOf $b true))}}{{$t = $b}}{{$N = true}}{{$m = $b.HasKey $E}}{{$b = $b.Get $E}}{{if eq $H (printf "%T" $b)}}{{$b = sdict $b}}{{$t.Set $E $b}}{{end}}{{else}}{{$m = false}}{{$N = false}}{{$b = ""}}{{end}}{{end}}{{else}}{{with dbGet $d $c}}{{$m = true}}{{$b = .Value}}{{if eq $H (printf "%T" $b)}}{{$b = sdict $b}}{{end}}{{end}}{{end}}{{$am := printf "%T" $b}}{{$h := ""}}{{$n := ""}}{{if $v}}{{$F := $d}}{{$x := sdict}}{{if and $c (ne $c "all")}}{{$q := dbGet $F $c}}{{if and $q $q.Value}}{{$x.Set $c $q.Value}}{{end}}{{else}}{{range $q := dbGetPattern $F "%" 100 0}}{{if $q.Value}}{{$x.Set $q.Key $q.Value}}{{end}}{{end}}{{end}}{{$n = "dumped"}}{{$C = $F}}{{$T := json $x true}}{{$U := joinStr "" "db_dump_" (toString $F) "_" (currentTime.Unix)}}{{if $z}}{{sendResponse nil (complexMessage "content" (joinStr "" "Exported " (len $x) " entries to file") "file" $T "filename" $U "ephemeral" true)}}{{else}}{{sendMessage nil (complexMessage "file" $T "filename" $U)}}{{end}}{{$a = joinStr "" "Exported " (len $x) " entries to file"}}{{else}}{{if $J}}{{if eq "map" (kindOf $b true)}}{{$n = "inspected"}}{{$a = cslice}}{{range $j, $G := $b}}{{$a = $a.Append $j}}{{end}}{{else}}{{$h = "No dictionary found for the given key!"}}{{end}}{{else}}{{if or $A $B}}{{if $m}}{{$a = $b}}{{if $A}}{{$n = "deleted"}}{{if ge (len $g) 2}}{{$t.Del $D}}{{dbSet $d $p $i}}{{else}}{{dbDel $d $c}}{{end}}{{else}}{{if $B}}{{$n = "retrieved"}}{{end}}{{end}}{{else}}{{$h = "No value found!"}}{{end}}{{else}}{{if or $s $K}}{{try}}{{$r := $a}}{{if eq $y $l}}{{if and (gt (len $a) 0) (eq "{" (index $a 0 | printf "%c"))}}{{$r = jsonToSdict $a}}{{end}}{{end}}{{if $s}}{{$n = "added"}}{{else}}{{$n = "removed"}}{{end}}{{$V := and $m (eq "slice" (kindOf $b true))}}{{$W := and $m (eq "map" (kindOf $b true))}}{{$ak := eq "map" (kindOf $r true)}}{{if and $V $s}}{{$f := cslice}}{{range $o := $b}}{{$f = $f.Append $o}}{{end}}{{$f = $f.Append $r}}{{$b = $f}}{{if ge (len $g) 2}}{{$t.Set $D $b}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $r}}{{else}}{{if and $V $K}}{{$f := cslice}}{{$O := false}}{{range $o := $b}}{{if and (not $O) (eq (str $o) (str $r))}}{{$O = true}}{{else}}{{$f = $f.Append $o}}{{end}}{{end}}{{if $O}}{{$b = $f}}{{if ge (len $g) 2}}{{$t.Set $D $b}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $b}}{{end}}{{$a = $r}}{{else}}{{$h = "No value found!"}}{{end}}{{else}}{{if and $W $ak}}{{$a = $r}}{{$X := false}}{{range $j, $G := $a}}{{if $s}}{{$Y := $b.Get $j}}{{if and (eq "slice" (kindOf $Y true)) (eq "slice" (kindOf $G true))}}{{$f := cslice}}{{range $o := $Y}}{{$f = $f.Append $o}}{{end}}{{range $o := $G}}{{$f = $f.Append $o}}{{end}}{{$b.Set $j $f}}{{else}}{{$b.Set $j $G}}{{end}}{{else}}{{if $b.HasKey $j}}{{$a.Set $j ($b.Get $j)}}{{$b.Del $j}}{{$X = true}}{{else}}{{$a.Del $j}}{{end}}{{end}}{{end}}{{if or $s $X}}{{if ge (len $g) 2}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $b}}{{end}}{{else}}{{$h = "No value found!"}}{{end}}{{else}}{{if $W}}{{$h = $L}}{{else}}{{$h = "No array or dictionary found for the given key!"}}{{end}}{{end}}{{end}}{{end}}{{catch}}{{$h = $L}}{{end}}{{else}}{{if and (ge (len $g) 2) (not $N)}}{{$h = "No dictionary found for the given key!"}}{{else}}{{try}}{{if eq $y $l}}{{$a = jsonToSdict $a}}{{end}}{{$n = "set"}}{{if ge (len $g) 2}}{{$t.Set $D $a}}{{dbSet $d $p $i}}{{else}}{{dbSet $d $c $a}}{{end}}{{catch}}{{$h = $L}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{$l = printf "%T" $a}}{{if $h}}{{$M = "⚠️"}}{{$k = $h}}{{$a = ""}}{{else}}{{if and (eq $y $l) (not $a)}}{{$a = "\"\""}}{{else}}{{if ne $y $l}}{{try}}{{$a = json $a true}}{{catch}}{{$a = joinStr "" "(unable to render type " $l ")"}}{{end}}{{end}}{{end}}{{$k = joinStr "" "Value successfully " $n "!"}}{{if not $z}}{{deleteTrigger $aa}}{{end}}{{end}}{{else}}{{$M = "⚠️"}}{{if not $R}}{{$k = joinStr "" "Invalid operation provided: " (or $e $w) ""}}{{else}}{{if not $c}}{{$k = "You must provide a key!"}}{{else}}{{if not $S}}{{$k = "You must provide a value!"}}{{end}}{{end}}{{end}}{{end}}{{$k = joinStr " " $M $k}}{{$Z := sub 4096 9}}{{if gt (len (toRune $a)) $Z}}{{$a = joinStr "" (slice (split $a "") 0 $Z) "…"}}{{end}}{{if $z}}{{if not $v}}{{$u = joinStr "" "Database Operation: `" $Q "`"}}{{$al := cembed "title" $u "color" $ab "description" (joinStr "" "```\n" (or $a $w) "\n```") "fields" (cslice (sdict "name" "User ID" "value" (joinStr "" "```\n" $C "```") "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" (or $c $w) "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $k "```") "inline" false))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" $al)}}{{end}}{{else}}{{if $I}}{{if not (and $I .ExecData.Title)}}{{$u = joinStr "" "Database Operation: `" $e "`"}}{{end}}{{execCC $ad $ah 0 (sdict "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" $u "Description" (joinStr "" "```\n" (or $a $w) "\n```") "AuthorID" $C "Fields" (cslice (sdict "name" "User ID" "value" (joinStr "" "```\n" $C "```") "inline" true) (sdict "name" "Key" "value" (joinStr "" "```\n" (or $c $w) "```") "inline" true) (sdict "name" "Result" "value" (joinStr "" "```\n" $k "```") "inline" false)))}}{{else}}
Use /db as a slash command: view · browse · set · add · remove · delete · export
{{end}}{{end}}