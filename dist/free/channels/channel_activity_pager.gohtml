{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Message Component`
  Trigger: `^ca:`
  Group: `Staff Utility`
  Dependencies: none (channel_activity execCCs this for the first page)
*/ -}}
{{$aa := ((dbGet 0 "Global")).Value}}{{$ab := toInt ($aa.Get "Embed Color")}}{{$J := ((dbGet 0 "Directory")).Value}}{{$ac := or ($J.Get "Exclude Categories") cslice}}{{$ad := or ($J.Get "Exclude Channels") cslice}}{{$ae := sdict "0" "GUILD_TEXT" "5" "GUILD_ANNOUNCEMENT" "15" "GUILD_FORUM"}}{{$l := dict}}{{range $s := $ac}}{{$l.Set (toInt $s) true}}{{end}}{{range $s := $ad}}{{$l.Set (toInt $s) true}}{{end}}{{$t := dict}}{{$K := dict}}{{range $b := .Guild.Channels}}{{$K.Set $b.ID $b.Name}}{{if $ae.HasKey (json $b.Type)}}{{if not ($l.Get $b.ID)}}{{if not ($l.Get $b.ParentID)}}{{$t.Set $b.ID $b}}{{end}}{{end}}{{end}}{{end}}{{$L := dbBottomEntries "Last Active" 100 0}}{{$M := eq (len $L) 100}}{{$u := cslice}}{{if $M}}{{$u = dbBottomEntries "Last Active" 100 100}}{{end}}{{$m := and $M (eq (len $u) 100)}}{{$g := cslice}}{{$g = $g.AppendSlice $L}}{{$g = $g.AppendSlice $u}}{{$af := currentTime.Unix}}{{$e := sdict "active" cslice "quiet" cslice "stale" cslice "never" cslice}}{{$N := dict}}{{range $n := $g}}{{if $t.Get $n.UserID}}{{$v := toInt $n.Value}}{{$w := div (sub $af $v) 86400}}{{$a := "stale"}}{{if lt $w 7}}{{$a = "active"}}{{else}}{{if lt $w 30}}{{$a = "quiet"}}{{end}}{{end}}{{$N.Set $n.UserID (sdict "ts" $v "days" $w "bucket" $a)}}{{$e.Set $a ((($e.Get $a)).Append (printf "<#%d> — <t:%d:R>" $n.UserID $v))}}{{end}}{{end}}{{$O := "channel_id,name,category,last_message_utc,days_quiet,bucket"}}{{$x := cslice $O}}{{$y := len $O}}{{$z := 0}}{{$o := 0}}{{range $b := .Guild.Channels}}{{if $t.Get $b.ID}}{{$i := $N.Get $b.ID}}{{if or $i (not $m)}}{{$h := cslice}}{{range $p := cslice $b.Name (or ($K.Get $b.ParentID) "")}}{{if reFind "[,\"\r\n]" $p}}{{$p = joinStr "" "\"" (reReplace "\"" $p "\"\"") "\""}}{{end}}{{$h = $h.Append $p}}{{end}}{{$j := ""}}{{if $i}}{{$j = printf "%d,%s,%s,%s,%d,%s" $b.ID (index $h 0) (index $h 1) (formatTime (timestampToTime ($i.Get "ts")) "2006-01-02T15:04:05Z") ($i.Get "days") ($i.Get "bucket")}}{{else}}{{$e.Set "never" ((($e.Get "never")).Append (printf "<#%d>" $b.ID))}}{{$j = printf "%d,%s,%s,,,never" $b.ID (index $h 0) (index $h 1)}}{{end}}{{if gt (add $y 1 (len $j)) 100000}}{{$o = add 1 $o}}{{else}}{{$x = $x.Append $j}}{{$y = add $y 1 (len $j)}}{{$z = add 1 $z}}{{end}}{{end}}{{end}}{{end}}{{$A := ""}}{{$a := "stale"}}{{$d := 1}}{{$B := false}}{{if .ExecData}}{{if .ExecData.Bucket}}{{$B = true}}{{end}}{{end}}{{if $B}}{{$a = toString .ExecData.Bucket}}{{$d = toInt (or .ExecData.Page 1)}}{{else}}{{if .Interaction}}{{$C := split .CustomID ":"}}{{$A = index $C 1}}{{if ge (len $C) 3}}{{$a = $A}}{{$d = toInt (index $C 2)}}{{end}}{{else}}{{$a = toString (or .ExecData.Bucket "stale")}}{{$d = toInt (or .ExecData.Page 1)}}{{end}}{{end}}{{if not ($e.HasKey $a)}}{{$a = "stale"}}{{end}}{{$D := len ($e.Get "active")}}{{$E := len ($e.Get "quiet")}}{{$F := len ($e.Get "stale")}}{{$P := len ($e.Get "never")}}{{$Q := printf "%d" (add $D $E $F $P)}}{{$G := printf "%d" $P}}{{if $m}}{{$Q = printf "%d+" (add $D $E $F)}}{{$G = "?"}}{{end}}{{$R := printf "%s channels: %d active · %d quiet · %d stale · %s never seen" $Q $D $E $F $G}}{{if eq $A "csv"}}{{$S := ""}}{{if gt $o 0}}{{$S = printf " — CSV truncated at %d rows (%d left out: 100,000-character file cap)" $z $o}}{{end}}{{sendResponse nil (complexMessage "content" (joinStr "" $R $S) "file" (joinStr "\n" $x) "filename" "channel_activity" "ephemeral" true)}}{{else}}{{$T := $e.Get $a}}{{$q := len $T}}{{$f := div (add $q 14) 15}}{{if lt $f 1}}{{$f = 1}}{{end}}{{if lt $d 1}}{{$d = 1}}{{end}}{{if gt $d $f}}{{$d = $f}}{{end}}{{$U := mult (sub $d 1) 15}}{{$H := add $U 15}}{{if gt $H $q}}{{$H = $q}}{{end}}{{$V := sdict "active" "Active" "quiet" "Quiet" "stale" "Stale" "never" "Never seen"}}{{$W := "oldest first"}}{{if eq $a "never"}}{{$W = "in channel order"}}{{end}}{{$c := cslice $R}}{{if eq (len $g) 0}}{{$c = $c.Append "_No activity has been recorded yet. Make sure channel_tracker is running._"}}{{end}}{{$c = $c.Append ""}}{{$c = $c.Append (printf "**%s**, %s — page %d of %d" ($V.Get $a) $W $d $f)}}{{if eq $a "never"}}{{$c = $c.Append "_Bot and webhook posts aren't seen, nor channels where YAGPDB can't send._"}}{{end}}{{if $m}}{{$c = $c.Append "_Only the oldest 200 tracked channels were checked; untracked channels can't be listed._"}}{{end}}{{if eq $q 0}}{{$c = $c.Append "Nothing here."}}{{else}}{{$c = $c.AppendSlice (slice $T $U $H)}}{{end}}{{$I := cslice}}{{range $k := cslice "active" "quiet" "stale" "never"}}{{$X := "secondary"}}{{if eq $k $a}}{{$X = "primary"}}{{end}}{{$Y := printf "%d" (len ($e.Get $k))}}{{$Z := false}}{{if eq $k "never"}}{{$Y = $G}}{{$Z = $m}}{{end}}{{$I = $I.Append (cbutton "label" (printf "%s (%s)" ($V.Get $k) $Y) "style" $X "custom_id" (printf "ca:%s:1:b" $k) "disabled" $Z)}}{{end}}{{$ag := cslice (cbutton "emoji" (sdict "name" "◀") "style" "secondary" "custom_id" (printf "ca:%s:%d" $a (sub $d 1)) "disabled" (le $d 1)) (cbutton "label" (printf "Page %d/%d" $d $f) "style" "secondary" "custom_id" "ca:noop" "disabled" true) (cbutton "emoji" (sdict "name" "▶") "style" "secondary" "custom_id" (printf "ca:%s:%d" $a (add $d 1)) "disabled" (ge $d $f)) (cbutton "emoji" (sdict "name" "⬇") "label" "CSV" "style" "secondary" "custom_id" "ca:csv")}}{{$r := complexMessage "embed" (cembed "title" "Channel activity" "color" $ab "description" (joinStr "\n" $c)) "components" (cslice $I $ag)}}{{if $B}}{{if .Interaction}}{{sendResponse nil $r}}{{else}}{{sendMessage nil $r}}{{end}}{{else}}{{if .Interaction}}{{updateMessage $r}}{{else}}{{sendMessage nil $r}}{{end}}{{end}}{{end}}