 "Â" "Z" "À" "Z" "Â" "Z" "Ç" "X" "É" "V" "È" "V" "Ê" "V" "Ë" "V" "Æ" "ZV" "Î" "R" "Ï" "R" "Ñ" "M" "Ô" "L" "Œ" "LV" "Ș" "H" "Ț" "G" "Ù" "F" "Û" "F" "Ü" "F" "Ÿ" "B" "ă" "z" "â" "z" "à" "z" "â" "z" "ç" "x" "é" "v" "è" "v" "ê" "v" "ë" "v" "æ" "zv" "î" "r" "ï" "r" "ñ" "m" "ô" "l" "œ" "lv" "ș" "h" "ț" "g" "ù" "f" "û" "f" "ü" "f" "ÿ" "b" "ᚠ" "ᛟ" "ᚢ" "ᛞ" "ᚦ" "ᛜ" "ᚨ" "ᛚ" "ᚱ" "ᛗ" "ᚲ" "ᛖ" "ᚷ" "ᛒ" "ᚹ" "ᛏ" "ᚺ" "ᛊ" "ᚾ" "ᛉ" "ᛁ" "ᛈ" "ᛃ" "ᛇ" "ᛇ" "ᛃ" "ᛈ" "ᛁ" "ᛉ" "ᚾ" "ᛊ" "ᚺ" "ᛏ" "ᚹ" "ᛒ" "ᚷ" "ᛖ" "ᚲ" "ᛗ" "ᚱ" "ᛚ" "ᚨ" "ᛜ" "ᚦ" "ᛞ" "ᚢ" "ᛟ" "ᚠ" "ᚡ" "ᛟ" "ᚣ" "ᛞ" "ᚤ" "ᛞ" "ᚥ" "ᛞ" "ᚧ" "ᛜ" "ᚩ" "ᛚ" "ᚪ" "ᛚ" "ᚫ" "ᛚ" "ᚬ" "ᛚ" "ᚭ" "ᛚ" "ᚮ" "ᛚ" "ᚯ" "ᛚ" "ᚰ" "ᛚ" "ᚳ" "ᛖ" "ᚴ" "ᛖ" "ᚵ" "ᛖ" "ᚶ" "ᛖ" "ᚸ" "ᛒ" "ᚻ" "ᛊ" "ᚼ" "ᛊ" "ᚽ" "ᛊ" "ᚿ" "ᛉ" "ᛀ" "ᛉ" "ᛂ" "ᛈ" "ᛄ" "ᛇ" "ᛅ" "ᛇ" "ᛆ" "ᛇ" "ᛡ" "ᛇ" "ᛦ" "ᚾ" "ᛧ" "ᚾ" "ᛨ" "ᚾ" "ᛋ" "ᚺ" "ᛌ" "ᚺ" "ᛍ" "ᚺ" "ᛎ" "ᚺ" "ᛐ" "ᚹ" "ᛑ" "ᚹ" "ᛠ" "ᚹ" "ᛓ" "ᚷ" "ᛔ" "ᚷ" "ᛕ" "ᚷ" "ᛘ" "ᚱ" "ᛙ" "ᚱ" "ᛛ" "ᚨ" "ᛝ" "ᚦ"}}{{$w := ""}}{{$J := false}}{{$f := reSplit "[[:space:]]+" $b}}{{$Y := reSplit "[^[:space:]]+" $b}}{{range $c, $j := $f}}{{$x := ""}}{{$K := split $j ""}}{{$L := len $K}}{{range $y, $k := $K}}{{$l := index $X $k}}{{if $l}}{{$J = true}}{{if and (gt $L 1) (eq $y (sub $L 1))}}{{$m := index $i $l}}{{if $m}}{{$l = $m}}{{end}}{{end}}{{else}}{{$l = $k}}{{end}}{{$x = joinStr "" $x $l}}{{end}}{{$w = joinStr (index $Y $c) $w $x}}{{end}}{{if $J}}{{$a.Set "Title" "Atbash Ciphertext"}}{{$a.Set "Description" $w}}{{$a.Set "Fields" (cslice (sdict "name" "Plaintext" "value" $b "inline" false))}}{{else}}{{$e = joinStr "" "⚠️ There was nothing to encipher: atbash supports Hebrew, " "Paleo-Hebrew, Greek, Arabic, Latin, runes, and digits. Please try again."}}{{end}}{{else}}{{if eq $d "alefbet"}}{{$b := .Options.text}}{{$M := sdict "𐤀" "א" "𐤁" "ב" "𐤂" "ג" "𐤃" "ד" "𐤄" "ה" "𐤅" "ו" "𐤆" "ז" "𐤇" "ח" "𐤈" "ט" "𐤉" "י" "𐤊" "כ" "𐤋" "ל" "𐤌" "מ" "𐤍" "נ" "𐤎" "ס" "𐤏" "ע" "𐤐" "פ" "𐤑" "צ" "𐤒" "ק" "𐤓" "ר" "𐤔" "ש" "𐤕" "ת" "ا" "א" "ب" "ב" "ج" "ג" "د" "ד" "ه" "ה" "ة" "ה" "و" "ו" "ز" "ז" "ح" "ח" "ط" "ט" "ي" "י" "ك" "כ" "ل" "ל" "م" "מ" "ن" "נ" "س" "ס" "ع" "ע" "ف" "פ" "ص" "צ" "ق" "ק" "ر" "ר" "ش" "ש" "ت" "ת" "ث" "ש" "خ" "ח" "ذ" "ז" "ض" "צ" "ظ" "צ" "غ" "ע" "ى" "א" "آ" "א" "أ" "א" "إ" "א" "پ" "ב" "چ" "ג" "ؤ" "ו" "ژ" "ז" "ئ" "י" "گ" "כ"}}{{$N := false}}{{$n := ""}}{{$z := split $b ""}}{{$O := len $z}}{{range $c := seq 0 $O}}{{$k := index $z $c}}{{$g := index $M $k}}{{if $g}}{{$N = true}}{{if eq $c (sub $O 1)}}{{$g = index $i $g}}{{else}}{{$Z := index $z (add 1 $c)}}{{$aa := index $M $Z}}{{if not $aa}}{{$g = index $i $g}}{{end}}{{end}}{{$n = joinStr "" $n $g}}{{else}}{{$n = joinStr "" $n $k}}{{end}}{{end}}{{if $N}}{{$a.Set "Title" "Hebrew Converter"}}{{$a.Set "Description" $n}}{{$a.Set "Fields" (cslice (sdict "name" "Original Text" "value" $b "inline" false))}}{{else}}{{$e = "⚠️ The argument provided does not contain any valid text for conversion to Hebrew. Please try again."}}{{end}}{{else}}{{if eq $d "pyramid"}}{{$b := ""}}{{if $r}}{{$b = trimSpace $r}}{{else}}{{$b = trimSpace .Options.text}}{{end}}{{$ab := $H.Get "Values"}}{{$f := reSplit "[[:space:]]+" $b}}{{if $r}}{{$f = cslice $b}}{{end}}{{if gt (len $f) 1}}{{$o := cslice}}{{$p := 0}}{{range $c, $j := $f}}{{if lt $c $v}}{{$o = $o.Append $j}}{{else}}{{$p = add 1 $p}}{{end}}{{end}}{{$P := "words"}}{{if eq 1 (len $o)}}{{$P = "word"}}{{end}}{{$A := cslice (joinStr "" "Pyramid gematria of **" (len $o) "** " $P " follows, one embed per word.")}}{{if gt $p 0}}{{$Q := "words were"}}{{if eq 1 $p}}{{$Q = "word was"}}{{end}}{{$R := "words"}}{{if eq 1 $v}}{{$R = "word"}}{{end}}{{$A = $A.Append (joinStr " " "⚠️ Warning:" $p $Q "not processed because only" $v $R "can be processed at a time.")}}{{end}}{{sendResponse nil (complexMessage "content" (joinStr "\n" $A.StringSlice))}}{{range $j := $o}}{{execCC $V $s 1 (sdict "AuthorID" $I "ChannelID" $s "Description" $j)}}{{end}}{{else}}{{$t := ""}}{{$u := ""}}{{range $B := split (index $f 0) ""}}{{if $ab.Get $B}}{{$S := joinStr "" $u $B}}{{$T := $S}}{{$m := index $i $B}}{{if and $u $m}}{{$T = joinStr "" $u $m}}{{end}}{{$t = joinStr "\n" $t $T}}{{$u = $S}}{{end}}{{end}}{{if $t}}{{$a.Set "Title" "Pyramid Gematria"}}{{$a.Set "Description" $t}}{{$a.Set "Fields" (cslice (sdict "name" "Word" "value" $b "inline" false))}}{{else}}{{$e = "⚠️ That word has no letters with a gematria value, so there is no pyramid to build."}}{{end}}{{end}}{{else}}{{if eq $d "random"}}{{$ac := sdict "0" "א" "1" "ב" "2" "ג" "3" "ד" "4" "ה" "5" "ו" "6" "ז" "7" "ח" "8" "ט" "9" "י" "10" "כ" "11" "ל" "12" "מ" "13" "נ" "14" "ס" "15" "ע" "16" "פ" "17" "צ" "18" "ק" "19" "ר" "20" "ש" "21" "ת"}}{{$h := toInt .Options.letters}}{{$q := 1}}{{if .Options.HasKey "groups"}}{{$q = toInt .Options.groups}}{{end}}{{$C := or (lt $h 1) (lt $q 1) (gt $h 1000) (gt $q 1000)}}{{if not $C}}{{$C = gt (mult $h $q) 1000}}{{end}}{{if $C}}{{$e = "⚠️ Give `letters` and `groups` of at least 1, and no more than 1000 letters in all."}}{{else}}{{$D := cslice}}{{range $c := seq 0 $q}}{{$E := ""}}{{range $y := seq 0 $h}}{{$F := index $ac (toString (randInt 0 22))}}{{if and (gt $h 1) (eq $y (sub $h 1))}}{{$F = index $i $F}}{{end}}{{$E = joinStr "" $E $F}}{{end}}{{$D = $D.Append $E}}{{end}}{{$a.Set "Title" "Hebrew Generator"}}{{$a.Set "Description" (joinStr " " $D.StringSlice)}}{{end}}{{else}}
Use /hebrew as a slash command: atbash, alefbet, pyramid or random
{{end}}{{end}}{{end}}{{end}}{{if $e}}{{sendResponse nil (complexMessage "content" $e "ephemeral" true)}}{{else}}{{if $a.Title}}{{$a.Set "AuthorID" $I}}{{$a.Set "ChannelID" $s}}{{$a.Set "Respond" true}}{{execCC $U $s 0 $a}}{{end}}{{end}}