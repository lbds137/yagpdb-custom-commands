{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `hebrew`
  Group: `Utility`
  Slash description: `Hebrew tools`
  Defer mode: `None`
  Dependencies: `gematria`

  The slash version of atbash, alefbet, pyramid and rand_hebrew, one root with four
  subcommands. The logic and dictionaries are inlined from them. A result (public) is ONE
  execCC to gematria with `Respond`: the child inherits the interaction and answers it, so
  this run prints nothing on that path (an empty run sends no response). Errors and usage
  refusals are ephemeral sendResponses of this run, never alongside the execCC.

  A pyramid of several words answers the interaction itself FIRST (a public message with
  the word count, plus the skipped-words warning), then schedules one delayed run of this
  command per word (ExecData `Description`, `AuthorID`, `ChannelID`; the Commands key
  `hebrew_slash`). The stored interaction was responded to by then, so each delayed run's
  embed is a followup. A delayed run restores `.Interaction` but not `.IsSlashCommand`,
  `.SubCommand` or `.Options`, so the ExecData is checked before them.

  Slash subcommand: `atbash atbash cipher of Hebrew, Greek, Arabic, Latin, runes and digits`
  Slash option: `atbash.text string! the text to encipher`
  Slash subcommand: `alefbet Paleo-Hebrew and Arabic letters converted to Hebrew`
  Slash option: `alefbet.text string! the text to convert`
  Slash subcommand: `pyramid gematria of a word's pyramid, one embed per word`
  Slash option: `pyramid.text string! one or more words`
  Slash subcommand: `random random Hebrew letters, with their gematria`
  Slash option: `random.letters integer! letters per group`
  Slash option: `random.groups integer how many groups (default 1)`
*/ -}}
{{$G := ((dbGet 0 "Commands")).Value}}{{$U := toInt ($G.Get "gematria")}}{{$V := toInt ($G.Get "hebrew_slash")}}{{$W := ((dbGet 0 "Global")).Value}}{{$H := ((dbGet 0 "Gematria")).Value}}{{$i := $H.Get "Final Letters"}}{{$v := toInt (min (toInt ($W.Get "ExecCC Limit")) 10)}}{{$r := .ExecData.Description}}{{$d := ""}}{{if $r}}{{$d = "pyramid"}}{{else}}{{if .IsSlashCommand}}{{$d = .SubCommand}}{{end}}{{end}}{{$I := or .ExecData.AuthorID .User.ID}}{{$s := or .ExecData.ChannelID .Channel.ID}}{{$e := ""}}{{$a := sdict}}{{if eq $d "atbash"}}{{$b := .Options.text}}{{$X := sdict "0" "9" "1" "8" "2" "7" "3" "6" "4" "5" "5" "4" "6" "3" "7" "2" "8" "1" "9" "0" "א" "ת" "ב" "ש" "ג" "ר" "ד" "ק" "ה" "צ" "ו" "פ" "ז" "ע" "ח" "ס" "ט" "נ" "י" "מ" "כ" "ל" "ל" "כ" "מ" "י" "נ" "ט" "ס" "ח" "ע" "ז" "פ" "ו" "צ" "ה" "ק" "ד" "ר" "ג" "ש" "ב" "ת" "א" "ך" "ל" "ם" "י" "ן" "ט" "ף" "ו" "ץ" "ה" "𐤀" "𐤕" "𐤁" "𐤔" "𐤂" "𐤓" "𐤃" "𐤒" "𐤄" "𐤑" "𐤅" "𐤐" "𐤆" "𐤏" "𐤇" "𐤎" "𐤈" "𐤍" "𐤉" "𐤌" "𐤊" "𐤋" "𐤋" "𐤊" "𐤌" "𐤉" "𐤍" "𐤈" "𐤎" "𐤇" "𐤏" "𐤆" "𐤐" "𐤅" "𐤑" "𐤄" "𐤒" "𐤃" "𐤓" "𐤂" "𐤔" "𐤁" "𐤕" "𐤀" "Α" "Ω" "Β" "Ψ" "Γ" "Χ" "Δ" "Φ" "Ε" "Υ" "Ϝ" "Ϡ" "Ϛ" "Ϙ" "Ζ" "Τ" "Η" "Σ" "Θ" "Ρ" "Ι" "Π" "Κ" "Ο" "Λ" "Ξ" "Μ" "Ν" "Ν" "Μ" "Ξ" "Λ" "Ο" "Κ" "Π" "Ι" "Ϙ" "Ϛ" "Ρ" "Θ" "Σ" "Η" "Τ" "Ζ" "Υ" "Ε" "Φ" "Δ" "Χ" "Γ" "Ψ" "Β" "Ω" "Α" "Ϡ" "Ϝ" "ᾼ" "Ω" "Ά" "Ω" "Ὰ" "Ω" "Ἀ" "Ω" "ᾈ" "Ω" "Ἄ" "Ω" "ᾌ" "Ω" "Ἂ" "Ω" "ᾊ" "Ω" "Ἆ" "Ω" "ᾎ" "Ω" "Ἁ" "Ω" "ᾉ" "Ω" "Ἅ" "Ω" "ᾍ" "Ω" "Ἃ" "Ω" "ᾋ" "Ω" "Ἇ" "Ω" "ᾏ" "Ω" "Ᾱ" "Ω" "Ᾰ" "Ω" "Έ" "Υ" "Ὲ" "Υ" "Ἐ" "Υ" "Ἔ" "Υ" "Ἒ" "Υ" "Ἑ" "Υ" "Ἕ" "Υ" "Ἓ" "Υ" "ῌ" "Υ" "Ή" "Σ" "Ὴ" "Σ" "Ἠ" "Σ" "ᾘ" "Σ" "Ἤ" "Σ" "ᾜ" "Σ" "Ἢ" "Σ" "ᾚ" "Σ" "Ἦ" "Σ" "ᾞ" "Σ" "Ἡ" "Σ" "ᾙ" "Σ" "Ἥ" "Σ" "ᾝ" "Σ" "Ἣ" "Σ" "ᾛ" "Σ" "Ἧ" "Σ" "ᾟ" "Σ" "Ί" "Π" "Ὶ" "Π" "Ἰ" "Π" "Ἴ" "Π" "Ἲ" "Π" "Ἶ" "Π" "Ἱ" "Π" "Ἵ" "Π" "Ἳ" "Π" "Ἷ" "Π" "Ϊ" "Π" "Ῑ" "Π" "Ῐ" "Π" "Ό" "Κ" "Ὸ" "Κ" "Ὀ" "Κ" "Ὄ" "Κ" "Ὂ" "Κ" "Ὁ" "Κ" "Ὅ" "Κ" "Ὃ" "Κ" "Ῥ" "Θ" "Ύ" "Ε" "Ὺ" "Ε" "Ὑ" "Ε" "Ὕ" "Ε" "Ὓ" "Ε" "Ὗ" "Ε" "Ϋ" "Ε" "Ῡ" "Ε" "Ῠ" "Ε" "Ώ" "Α" "Ὼ" "Α" "Ὠ" "Α" "ᾨ" "Α" "Ὤ" "Α" "ᾬ" "Α" "Ὢ" "Α" "ᾪ" "Α" "Ὦ" "Α" "ᾮ" "Α" "Ὡ" "Α" "ᾩ" "Α"