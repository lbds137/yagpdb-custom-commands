{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Modal Submission`
  Trigger: `^prompt:post:`
  Group: `Staff Utility`
  Defer mode: `None`

  The /prompt form's writer (prompt opens it): posts the submitted prompt where the
  form's custom ID points. Thread mode: in a forum channel, a post titled
  `YYYY-MM-DD: ...`; anywhere else, a createThread thread. Both carry the bare body,
  never a mention: a bot-created thread's messages don't notify until a human has
  spoken in it (Discord's human-speech gate, probed 2026-10-02), so the role ping, if
  the form has one, goes to the run channel as a normal message — one that always
  notifies, carrying the link, whose thread name is the title, above a body excerpt of
  about 300 characters. Inline mode: a plain message, mention-first, because a normal
  channel's sends do notify. The date is Eastern time, DST included. Everything the
  staff member sees is ephemeral; the post is the public artifact. Each post's prompt
  message is pinned where it landed, in its own try, so a refused pin (full pin list,
  missing permission) never fails the post and only adds "(couldn't pin it ...)" to the
  ack.
*/ -}}
{{if .IsModal}}{{$v := ((dbGet 0 "Roles")).Value}}{{$w := toInt ($v.Get "Staff")}}{{if not (hasRoleID $w)}}{{sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true)}}{{else}}{{$h := split .CustomID ":"}}{{if ne (len $h) 5}}{{sendResponse nil (complexMessage "content" "⚠️ Malformed prompt form — run /prompt again." "ephemeral" true)}}{{else}}{{$i := index $h 2}}{{$f := toInt (index $h 3)}}{{$c := toInt (index $h 4)}}{{if or (and (ne $i "t") (ne $i "i")) (not (reFind "\\A\\d+\\z" (index $h 3))) (not (reFind "\\A\\d+\\z" (index $h 4)))}}{{sendResponse nil (complexMessage "content" "⚠️ Malformed prompt form — run /prompt again." "ephemeral" true)}}{{else}}{{$q := ""}}{{if eq $i "t"}}{{$q = .ModalValues.prompt_title.value}}{{end}}{{$g := .ModalValues.prompt_body.value}}{{$n := $g}}{{if ne $c 0}}{{$n = joinStr " " (mentionRoleID $c) $g}}{{end}}{{$r := false}}{{if eq $i "t"}}{{$o := ""}}{{try}}{{$o = getChannelOrThread $f}}{{catch}}{{end}}{{if $o}}{{$r = eq $o.Type 15}}{{end}}{{end}}{{$s := len (toRune $g)}}{{$t := len (toRune $n)}}{{if gt $s 2000}}{{sendResponse nil (complexMessage "content" (print "⚠️ The prompt is " $s " characters — the limit is 2000.") "ephemeral" true)}}{{else}}{{if and (gt $t 2000) (eq $i "i")}}{{sendResponse nil (complexMessage "content" (print "⚠️ The role ping puts the prompt at " $t " characters — the limit is 2000. Shorten the prompt or drop the role.") "ephemeral" true)}}{{else}}{{$x := currentTime.In (loadLocation "America/New_York")}}{{$y := $x.Format "2006-01-02"}}{{if eq $i "t"}}{{$j := print $y ": " $q}}{{$u := len (toRune $j)}}{{if gt $u 100}}{{sendResponse nil (complexMessage "content" (print "⚠️ The thread title is " $u " characters — the limit is 100.") "ephemeral" true)}}{{else}}{{$k := trimSpace $g}}{{if gt (len (toRune $k)) 300}}{{$p := reFind "(?s)\\A.{1,300}\\s" $k}}{{if not $p}}{{$p = reFind "(?s)\\A.{300}" $k}}{{end}}{{$k = print (trimSpace $p) "…"}}{{end}}{{if $r}}{{$b := ""}}{{try}}{{$b = createForumPost $f $j (complexMessage "content" $g)}}{{catch}}{{end}}{{if not $b}}{{sendResponse nil (complexMessage "content" "⚠️ Couldn't create the post." "ephemeral" true)}}{{else}}{{$l := print "https://discord.com/channels/" .Guild.ID "/" $b.ID}}{{$e := true}}{{try}}{{pinMessage $b.ID $b.ID}}
									{{catch}}
										
										{{$e = false}}
									{{end}}
									{{$m := true}}
									{{if ne $c 0}}
										{{try}}
											
											{{$z := sendMessageRetID nil (complexMessage "content" (print "🔔 New prompt for " (mentionRoleID $c) ": " $l "\n>>> " $k) "allowed_mentions" (sdict "roles" (cslice $c)))}}
										{{catch}}
											
											{{$m = false}}
										{{end}}
									{{end}}
									{{$a := print "✅ Posted " $j ": " $l}}
									{{if not $m}}
										{{$a = print $a " (couldn't send the ping)"}}
									{{end}}
									{{if not $e}}
										{{$a = print $a " (couldn't pin it: the pin list may be full, or I can't pin there)"}}
									{{end}}
									{{sendResponse nil (complexMessage "content" $a "ephemeral" true)}}
								{{end}}
							{{else}}
								
								{{$b := ""}}
								{{try}}
									{{$b = createThread $f 0 $j}}
								{{catch}}
								{{end}}
								{{if not $b}}
									{{sendResponse nil (complexMessage "content" "⚠️ Couldn't create the post." "ephemeral" true)}}
								{{else}}
									{{$d := 0}}
									{{try}}
										{{$d = sendMessageRetID $b.ID (complexMessage "content" $g)}}
									{{catch}}
									{{end}}
									{{if $d}}
										{{$l := print "https://discord.com/channels/" .Guild.ID "/" $b.ID "/" $d}}
										{{$e := true}}
										{{try}}
											{{pinMessage $b.ID $d}}
										{{catch}}
											
											{{$e = false}}
										{{end}}
										{{$m := true}}
										{{if ne $c 0}}
											{{try}}
												
												{{$z := sendMessageRetID nil (complexMessage "content" (print "🔔 New prompt for " (mentionRoleID $c) ": " $l "\n>>> " $k) "allowed_mentions" (sdict "roles" (cslice $c)))}}
											{{catch}}
												
												{{$m = false}}
											{{end}}
										{{end}}
										{{$a := print "✅ Created " $j ": " $l}}
										{{if not $m}}
											{{$a = print $a " (couldn't send the ping)"}}
										{{end}}
										{{if not $e}}
											{{$a = print $a " (couldn't pin it: the pin list may be full, or I can't pin there)"}}
										{{end}}
										{{sendResponse nil (complexMessage "content" $a "ephemeral" true)}}
									{{else}}
										{{sendResponse nil (complexMessage "content" (print "✅ Created " $j " but the prompt couldn't be sent into it — check the channel.") "ephemeral" true)}}
									{{end}}
								{{end}}
							{{end}}
						{{end}}
					{{else}}
						{{try}}
							{{$d := 0}}
							{{if ne $c 0}}
								{{$d = sendMessageRetID $f (complexMessage "content" $n "allowed_mentions" (sdict "parse" (cslice "users" "roles")))}}
							{{else}}
								{{$d = sendMessageRetID $f (complexMessage "content" $g)}}
							{{end}}
							{{$e := true}}
							{{try}}
								{{pinMessage $f $d}}
							{{catch}}
								
								{{$e = false}}
							{{end}}
							{{$a := print "✅ Sent: https://discord.com/channels/" .Guild.ID "/" $f "/" $d}}
							{{if not $e}}
								{{$a = print $a " (couldn't pin it: the pin list may be full, or I can't pin there)"}}
							{{end}}
							{{sendResponse nil (complexMessage "content" $a "ephemeral" true)}}
						{{catch}}
							{{sendResponse nil (complexMessage "content" "⚠️ Couldn't send the prompt there — check the channel." "ephemeral" true)}}
						{{end}}
					{{end}}
				{{end}}{{end}}
			{{end}}
		{{end}}
	{{end}}
{{else}}
Reached by submitting a /prompt form; use /prompt as a slash command.
{{end}}