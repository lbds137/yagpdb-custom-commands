{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `None`
  Group: `Utility`
  Dependencies: `embed_exec`, `gematria_bootstrap`
  Called by: /gematria and /hebrew (the renderer), with the text in ExecData.Description.
  Slash-only since 2026-10-04 (Lila): the text trigger is gone.
*/ -}}
{{define "buildGematriaStrings"}}
  {{$b := .}}
  {{$N := len ($b.Get "tokens")}}
  {{$v := "`"}}
  {{$w := "`"}}
  {{if gt $N 1}}
    {{$v = "`[ "}}
    {{$w = " ]`"}}
  {{end}}
  {{$aD := joinStr "" $v (joinStr " " (($b.Get "lengths")).StringSlice) $w}}
  {{$O := ""}}
  {{$x := cslice}}{{range $P := seq -1 ($b.Get "depth")}}{{$Q := ""}}{{$Z := ""}}{{if lt $P 0}}{{$x = $b.Get "values"}}{{$Q = joinStr "" $v (joinStr " " $x.StringSlice) $w}}{{else}}{{$i := cslice}}{{range $aa := seq 0 $N}}{{$ab := index ($b.Get "reductions") $aa}}{{if gt (len $ab) $P}}{{$i = $i.Append (index $ab $P)}}{{else}}{{$i = $i.Append (index $x $aa)}}{{end}}{{end}}{{$Q = joinStr "" $v (joinStr " " $i.StringSlice) $w}}{{$Z = " > "}}{{$x = $i}}{{end}}{{$O = joinStr $Z $O $Q}}{{end}}{{$b.Set "count" $N}}
  {{$b.Set "lengthString" $aD}}
  {{$b.Set "gematriaString" $O}}

  {{return $b}}
{{end}}{{define "reduce"}}
  {{$b := .}}
  {{if lt ($b.Get "reductionStep") 10}}
    {{return $b}}
  {{else}}
    {{$y := 0}}
    {{$aE := split (toString ($b.Get "reductionStep")) ""}}{{range $aF := $aE}}{{$y = add $y (toInt $aF)}}{{end}}{{$b.Set "reductionStep" $y}}
    {{$b.Set "reductions" ((($b.Get "reductions")).Append (joinStr "" $y ($b.Get "separator")))}}
    {{$b.Set "depth" (add ($b.Get "depth") 1)}}

    {{return (execTemplate "reduce" $b)}}
  {{end}}
{{end}}{{define "updateData"}}
  {{$b := .}}
  {{$d := $b.Get "dictionary"}}
  {{$d.Set "tokens" ((($d.Get "tokens")).Append ($b.Get "token"))}}
  {{$d.Set "lengths" ((($d.Get "lengths")).Append (joinStr "" ($b.Get "length") ($b.Get "separator")))}}
  {{$d.Set "values" ((($d.Get "values")).Append (joinStr "" ($b.Get "value") ($b.Get "separator")))}}
  {{$d.Set "reductions" ((($d.Get "reductions")).Append ($b.Get "reductions"))}}
  {{$d.Set "depth" (toInt (max ($b.Get "depth") ($d.Get "depth")))}}

  {{return $b}}
{{end}}{{$g := ""}}{{if .ExecData}}{{$g = toString (or .ExecData.Description "")}}{{end}}{{if not $g}}{{print "Usage: /gematria text, or /hebrew (this command renders their results)"}}
	{{return}}
{{end}}

{{$ac := ((dbGet 0 "Global")).Value}}
{{$ad := toInt ($ac.Get "Delete Trigger Delay")}}

{{$h := ((dbGet 0 "Gematria")).Value}}
{{$z := $h.Get "Values"}}
{{$o := $h.Get "Tarot Indices"}}

{{$ae := ((dbGet 0 "Commands")).Value}}
{{$A := toInt ($ae.Get "embed_exec")}}

{{$af := ((dbGet 0 "Channels")).Value}}
{{$R := toInt ($af.Get "YAGPDB")}}







{{$c := sdict "text" sdict "line" sdict "word" sdict}}{{range $ag, $aG := $c}}{{$ah := sdict "tokens" cslice "lengths" cslice "values" cslice "reductions" cslice "depth" 0}}{{$c.Set $ag $ah}}{{end}}{{$B := 0}}
{{$p := 0}}
{{$ai := cslice}}
{{$aj := 0}}
{{$S := split $g "\n"}}{{range $ak, $T := $S}}{{$q := 0}}{{$j := 0}}{{$al := cslice}}{{$am := 0}}{{$U := split $T " "}}{{range $an, $k := $U}}{{$r := 0}}{{$l := 0}}{{$ao := cslice}}{{$ap := 0}}{{$C := ""}}{{if and (ne $ak (sub (len $S) 1)) (eq $an (sub (len $U) 1))}}{{$C = " |"}}{{end}}{{$aq := split $k ""}}{{range $D := $aq}}{{$f := $z.Get $D}}{{if $f}}{{$r = add $r 1}}{{$l = add $l $f}}{{end}}{{end}}{{$ar := sdict "reductionStep" $l "reductions" $ao "depth" $ap "separator" $C}}{{$V := execTemplate "reduce" $ar}}{{$as := sdict "dictionary" ($c.Get "word") "separator" $C "token" $k "length" $r "value" $l "reductions" ($V.Get "reductions") "depth" ($V.Get "depth")}}{{$c.Set "word" (((execTemplate "updateData" $as)).Get "dictionary")}}{{$q = add $q $r}}{{$j = add $j $l}}{{end}}{{$at := sdict "reductionStep" $j "reductions" $al "depth" $am "separator" ""}}{{$W := execTemplate "reduce" $at}}{{$au := sdict "dictionary" ($c.Get "line") "separator" "" "token" $T "length" $q "value" $j "reductions" ($W.Get "reductions") "depth" ($W.Get "depth")}}{{$c.Set "line" (((execTemplate "updateData" $au)).Get "dictionary")}}{{$B = add $B $q}}{{$p = add $p $j}}{{end}}{{$av := sdict "reductionStep" $p "reductions" $ai "depth" $aj "separator" ""}}
{{$X := execTemplate "reduce" $av}}
{{$aw := sdict "dictionary" ($c.Get "text") "separator" "" "token" $g "length" $B "value" $p "reductions" ($X.Get "reductions") "depth" ($X.Get "depth")}}
{{$c.Set "text" (((execTemplate "updateData" $aw)).Get "dictionary")}}

{{$m := execTemplate "buildGematriaStrings" ($c.Get "word")}}
{{$E := execTemplate "buildGematriaStrings" ($c.Get "line")}}
{{$F := execTemplate "buildGematriaStrings" ($c.Get "text")}}{{$s := $m.Get "count"}}{{$G := $E.Get "count"}}{{$a := cslice}}{{if eq 1 $s}}{{$k := index ((($c.Get "word")).Get "tokens") 0}}{{if eq 1 (len (toRune $k))}}{{$a = $a.Append (sdict "name" "Letter Gematria" "value" ($F.Get "gematriaString"))}}{{$f := $z.Get $k}}{{if $o.HasKey $f}}{{$ax := $o.Get $f}}{{$a = $a.Append (sdict "name" "Letter Number" "value" (joinStr "" "`" (add 1 $ax) "`"))}}{{end}}{{else}}{{$a = $a.Append (sdict "name" "Word Length" "value" ($m.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Word Gematria" "value" ($m.Get "gematriaString"))}}{{end}}{{else}}{{$a = $a.Append (sdict "name" "Word Count" "value" (joinStr "" "`" $s "`"))}}{{$a = $a.Append (sdict "name" "Word Length" "value" ($m.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Word Gematria" "value" ($m.Get "gematriaString"))}}{{if and (gt $G 1) (ne $s $G)}}{{$a = $a.Append (sdict "name" "Line Count" "value" (joinStr "" "`" $G "`"))}}{{$a = $a.Append (sdict "name" "Line Length" "value" ($E.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Line Gematria" "value" ($E.Get "gematriaString"))}}{{end}}{{if gt $s 1}}{{$a = $a.Append (sdict "name" "Total Length" "value" ($F.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Total Gematria" "value" ($F.Get "gematriaString"))}}{{end}}{{end}}{{$ay := $h.Get "RWS Numerals"}}{{$az := $h.Get "Thoth Numerals"}}{{$aA := $h.Get "RWS Names"}}{{$aB := $h.Get "Thoth Names"}}{{$t := cslice}}{{$H := dict}}{{range $D := split $g ""}}{{$f := $z.Get $D}}{{if $o.HasKey $f}}{{$e := $o.Get $f}}{{$n := toInt ($H.Get $e)}}{{if eq $n 0}}{{$t = $t.Append $e}}{{end}}{{$H.Set $e (add 1 $n)}}{{end}}{{end}}{{$Y := len $t}}{{$I := cslice}}{{$J := cslice}}{{range $e := $t}}{{$K := ""}}{{$n := $H.Get $e}}{{if gt $n 1}}{{$K = joinStr "" " (" $n ")"}}{{end}}{{$I = $I.Append (joinStr "" "`" ($ay.Get $e) "` - " ($aA.Get $e) $K)}}{{$J = $J.Append (joinStr "" "`" ($az.Get $e) "` - " ($aB.Get $e) $K)}}{{end}}{{$u := joinStr "\n" $I.StringSlice}}{{$L := joinStr "\n" $J.StringSlice}}{{$aC := le $Y 11}}{{if and $u $L $aC}}{{$a = $a.Append (sdict "name" "Unique Arcana" "value" (joinStr "" "`" $Y "`"))}}{{if eq $u $L}}{{$a = $a.Append (sdict "name" "Major Arcana" "value" $u)}}{{else}}{{$a = $a.Append (sdict "name" "Major Arcana (RWS)" "value" $u)}}{{$a = $a.Append (sdict "name" "Major Arcana (Thoth)" "value" $L)}}{{end}}{{end}}{{if .ExecData.Fields}}{{$a = $a.AppendSlice .ExecData.Fields}}{{end}}{{$M := sdict "AuthorID" .User.ID "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" (or .ExecData.Title "Gematria Calculator") "Description" $g "Fields" $a}}{{if .ExecData.Respond}}{{$M.Set "Respond" true}}{{if le $A 0}}{{sendResponse nil (complexMessage "content" "⚠️ This command isn't set up on this server yet." "ephemeral" true)}}{{else}}{{try}}{{execCC $A $R 0 $M}}{{catch}}{{sendResponse nil (complexMessage "content" "⚠️ This command isn't set up on this server yet." "ephemeral" true)}}{{end}}{{end}}{{else}}{{execCC $A $R 0 $M}}{{end}}{{deleteTrigger $ad}}