{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `None`
  Group: `Utility`
  Dependencies: `embed_exec`, `gematria_bootstrap`
  Called by: /gematria and /hebrew (the renderer), with the text in ExecData.Description.
  Slash-only since 2026-10-04 (Lila): the text trigger is gone.
*/ -}}
{{define "buildGematriaStrings"}}
  {{$b := .}}
  {{$L := len ($b.Get "tokens")}}
  {{$v := "`"}}
  {{$w := "`"}}
  {{if gt $L 1}}
    {{$v = "`[ "}}
    {{$w = " ]`"}}
  {{end}}
  {{$aD := joinStr "" $v (joinStr " " (($b.Get "lengths")).StringSlice) $w}}
  {{$M := ""}}
  {{$x := cslice}}{{range $N := seq -1 ($b.Get "depth")}}{{$O := ""}}{{$X := ""}}{{if lt $N 0}}{{$x = $b.Get "values"}}{{$O = joinStr "" $v (joinStr " " $x.StringSlice) $w}}{{else}}{{$i := cslice}}{{range $Y := seq 0 $L}}{{$Z := index ($b.Get "reductions") $Y}}{{if gt (len $Z) $N}}{{$i = $i.Append (index $Z $N)}}{{else}}{{$i = $i.Append (index $x $Y)}}{{end}}{{end}}{{$O = joinStr "" $v (joinStr " " $i.StringSlice) $w}}{{$X = " > "}}{{$x = $i}}{{end}}{{$M = joinStr $X $M $O}}{{end}}{{$b.Set "count" $L}}
  {{$b.Set "lengthString" $aD}}
  {{$b.Set "gematriaString" $M}}

  {{return $b}}
{{end}}{{define "reduce"}}
  {{$b := .}}
  {{if lt ($b.Get "reductionStep") 10}}
    {{return $b}}
  {{else}}
    {{$y := 0}}
    {{$aE := split (toString ($b.Get "reductionStep")) ""}}{{range $aF := $aE}}{{$y = add $y (toInt $aF)}}{{end}}{{$b.Set "reductionStep" $y}}
    {{$b.Set "reductions" ((($b.Get "reductions")).Append (joinStr "" $y ($b.Get "separator")))}}
    {{$b.Set "depth" (add ($b.Get "depth") 1)}}

    {{return (execTemplate "reduce" $b)}}
  {{end}}
{{end}}{{define "updateData"}}
  {{$b := .}}
  {{$d := $b.Get "dictionary"}}
  {{$d.Set "tokens" ((($d.Get "tokens")).Append ($b.Get "token"))}}
  {{$d.Set "lengths" ((($d.Get "lengths")).Append (joinStr "" ($b.Get "length") ($b.Get "separator")))}}
  {{$d.Set "values" ((($d.Get "values")).Append (joinStr "" ($b.Get "value") ($b.Get "separator")))}}
  {{$d.Set "reductions" ((($d.Get "reductions")).Append ($b.Get "reductions"))}}
  {{$d.Set "depth" (toInt (max ($b.Get "depth") ($d.Get "depth")))}}

  {{return $b}}
{{end}}{{$g := ""}}{{if .ExecData}}{{$g = toString (or .ExecData.Description "")}}{{end}}{{if not $g}}{{print "Usage: /gematria text, or /hebrew (this command renders their results)"}}
	{{return}}
{{end}}

{{$aa := ((dbGet 0 "Global")).Value}}
{{$ab := toInt ($aa.Get "Delete Trigger Delay")}}

{{$h := ((dbGet 0 "Gematria")).Value}}
{{$z := $h.Get "Values"}}
{{$o := $h.Get "Tarot Indices"}}

{{$ac := ((dbGet 0 "Commands")).Value}}
{{$ad := toInt ($ac.Get "embed_exec")}}

{{$ae := ((dbGet 0 "Channels")).Value}}
{{$af := toInt ($ae.Get "YAGPDB")}}







{{$c := sdict "text" sdict "line" sdict "word" sdict}}{{range $ag, $aG := $c}}{{$ah := sdict "tokens" cslice "lengths" cslice "values" cslice "reductions" cslice "depth" 0}}{{$c.Set $ag $ah}}{{end}}{{$A := 0}}
{{$p := 0}}
{{$ai := cslice}}
{{$aj := 0}}
{{$P := split $g "\n"}}{{range $ak, $Q := $P}}{{$q := 0}}{{$j := 0}}{{$al := cslice}}{{$am := 0}}{{$R := split $Q " "}}{{range $an, $k := $R}}{{$r := 0}}{{$l := 0}}{{$ao := cslice}}{{$ap := 0}}{{$B := ""}}{{if and (ne $ak (sub (len $P) 1)) (eq $an (sub (len $R) 1))}}{{$B = " |"}}{{end}}{{$aq := split $k ""}}{{range $C := $aq}}{{$f := $z.Get $C}}{{if $f}}{{$r = add $r 1}}{{$l = add $l $f}}{{end}}{{end}}{{$ar := sdict "reductionStep" $l "reductions" $ao "depth" $ap "separator" $B}}{{$S := execTemplate "reduce" $ar}}{{$as := sdict "dictionary" ($c.Get "word") "separator" $B "token" $k "length" $r "value" $l "reductions" ($S.Get "reductions") "depth" ($S.Get "depth")}}{{$c.Set "word" (((execTemplate "updateData" $as)).Get "dictionary")}}{{$q = add $q $r}}{{$j = add $j $l}}{{end}}{{$at := sdict "reductionStep" $j "reductions" $al "depth" $am "separator" ""}}{{$T := execTemplate "reduce" $at}}{{$au := sdict "dictionary" ($c.Get "line") "separator" "" "token" $Q "length" $q "value" $j "reductions" ($T.Get "reductions") "depth" ($T.Get "depth")}}{{$c.Set "line" (((execTemplate "updateData" $au)).Get "dictionary")}}{{$A = add $A $q}}{{$p = add $p $j}}{{end}}{{$av := sdict "reductionStep" $p "reductions" $ai "depth" $aj "separator" ""}}
{{$U := execTemplate "reduce" $av}}
{{$aw := sdict "dictionary" ($c.Get "text") "separator" "" "token" $g "length" $A "value" $p "reductions" ($U.Get "reductions") "depth" ($U.Get "depth")}}
{{$c.Set "text" (((execTemplate "updateData" $aw)).Get "dictionary")}}

{{$m := execTemplate "buildGematriaStrings" ($c.Get "word")}}
{{$D := execTemplate "buildGematriaStrings" ($c.Get "line")}}
{{$E := execTemplate "buildGematriaStrings" ($c.Get "text")}}{{$s := $m.Get "count"}}{{$F := $D.Get "count"}}{{$a := cslice}}{{if eq 1 $s}}{{$k := index ((($c.Get "word")).Get "tokens") 0}}{{if eq 1 (len (toRune $k))}}{{$a = $a.Append (sdict "name" "Letter Gematria" "value" ($E.Get "gematriaString"))}}{{$f := $z.Get $k}}{{if $o.HasKey $f}}{{$ax := $o.Get $f}}{{$a = $a.Append (sdict "name" "Letter Number" "value" (joinStr "" "`" (add 1 $ax) "`"))}}{{end}}{{else}}{{$a = $a.Append (sdict "name" "Word Length" "value" ($m.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Word Gematria" "value" ($m.Get "gematriaString"))}}{{end}}{{else}}{{$a = $a.Append (sdict "name" "Word Count" "value" (joinStr "" "`" $s "`"))}}{{$a = $a.Append (sdict "name" "Word Length" "value" ($m.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Word Gematria" "value" ($m.Get "gematriaString"))}}{{if and (gt $F 1) (ne $s $F)}}{{$a = $a.Append (sdict "name" "Line Count" "value" (joinStr "" "`" $F "`"))}}{{$a = $a.Append (sdict "name" "Line Length" "value" ($D.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Line Gematria" "value" ($D.Get "gematriaString"))}}{{end}}{{if gt $s 1}}{{$a = $a.Append (sdict "name" "Total Length" "value" ($E.Get "lengthString"))}}{{$a = $a.Append (sdict "name" "Total Gematria" "value" ($E.Get "gematriaString"))}}{{end}}{{end}}{{$ay := $h.Get "RWS Numerals"}}{{$az := $h.Get "Thoth Numerals"}}{{$aA := $h.Get "RWS Names"}}{{$aB := $h.Get "Thoth Names"}}{{$t := cslice}}{{$G := dict}}{{range $C := split $g ""}}{{$f := $z.Get $C}}{{if $o.HasKey $f}}{{$e := $o.Get $f}}{{$n := toInt ($G.Get $e)}}{{if eq $n 0}}{{$t = $t.Append $e}}{{end}}{{$G.Set $e (add 1 $n)}}{{end}}{{end}}{{$V := len $t}}{{$H := cslice}}{{$I := cslice}}{{range $e := $t}}{{$J := ""}}{{$n := $G.Get $e}}{{if gt $n 1}}{{$J = joinStr "" " (" $n ")"}}{{end}}{{$H = $H.Append (joinStr "" "`" ($ay.Get $e) "` - " ($aA.Get $e) $J)}}{{$I = $I.Append (joinStr "" "`" ($az.Get $e) "` - " ($aB.Get $e) $J)}}{{end}}{{$u := joinStr "\n" $H.StringSlice}}{{$K := joinStr "\n" $I.StringSlice}}{{$aC := le $V 11}}{{if and $u $K $aC}}{{$a = $a.Append (sdict "name" "Unique Arcana" "value" (joinStr "" "`" $V "`"))}}{{if eq $u $K}}{{$a = $a.Append (sdict "name" "Major Arcana" "value" $u)}}{{else}}{{$a = $a.Append (sdict "name" "Major Arcana (RWS)" "value" $u)}}{{$a = $a.Append (sdict "name" "Major Arcana (Thoth)" "value" $K)}}{{end}}{{end}}{{if .ExecData.Fields}}{{$a = $a.AppendSlice .ExecData.Fields}}{{end}}{{$W := sdict "AuthorID" .User.ID "ChannelID" (or .ExecData.ChannelID .Channel.ID) "Title" (or .ExecData.Title "Gematria Calculator") "Description" $g "Fields" $a}}{{if .ExecData.Respond}}{{$W.Set "Respond" true}}{{end}}{{execCC $ad $af 0 $W}}{{deleteTrigger $ab}}