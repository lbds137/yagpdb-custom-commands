{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `edit`
  Group: `Staff Utility`
  Slash description: `Edit rules and database entries`
  Defer mode: `None`

  The modal front end for rule_edit and simple_db_edit (both in retired/ now): /edit
  opens a prefilled modal (the engines live in edit_modal, the delete confirm's buttons
  in edit_confirm). Defer None is mandatory, not a choice: sendModal IS the interaction's
  one response, and a deferral would eat the slot.

  Slash subcommand: `rule edit a rule's text`
  Slash option: `rule.rule integer! the rule's number`
  Slash subcommand: `entry edit a database entry`
  Slash option: `entry.category string category to prefill`
  Slash option: `entry.key string key to prefill`
  Slash option: `entry.create boolean make the category if it doesn't exist yet`
  Slash subcommand: `delete delete a rule or entry`
  Slash option: `delete.rule integer rule number`
  Slash option: `delete.category string category`
  Slash option: `delete.key string key`
*/ -}}
{{if .IsSlashCommand}}{{$G := ((dbGet 0 "Roles")).Value}}{{$H := toInt ($G.Get "Staff")}}{{if not (hasRoleID $H)}}{{sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true)}}{{else}}{{if eq .SubCommand "rule"}}{{$c := toInt (or .Options.rule 0)}}{{if or (lt $c 1) (gt $c 9999)}}{{sendResponse nil (complexMessage "content" "⚠️ Rule numbers run from 1 to 9999." "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$q := or ((dbGet 0 "Rules")).Value sdict}}{{$B := $q.HasKey $b}}{{$a := ""}}{{if $B}}{{$a = $q.Get $b}}{{end}}{{$r := sdict "label" (joinStr "" "Rule " $c " text") "custom_id" "rule_text" "style" 2 "required" true}}{{if $B}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$r.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$r.Set "value" $a}}{{end}}{{else}}{{$r.Set "placeholder" "current value isn't plain text; type a replacement"}}{{end}}{{else}}{{$r.Set "placeholder" "new rule; type its text"}}{{end}}{{sendModal (cmodal "title" (joinStr "" "Edit rule " $c) "custom_id" (print "edit:rule:" $c ":" currentTime.Unix) "fields" (cslice $r))}}{{end}}{{else}}{{if eq .SubCommand "entry"}}{{$f := toString (or .Options.category "")}}{{$g := toString (or .Options.key "")}}{{$t := or .Options.create false}}{{$C := "e.g. Admin"}}{{if $t}}{{$C = "a new or existing category"}}{{end}}{{$D := sdict "label" "Category" "custom_id" "category" "style" 1 "required" true "placeholder" $C}}{{$E := sdict "label" "Key" "custom_id" "key" "style" 1 "required" true "placeholder" "the entry's name"}}{{$x := sdict "label" "Value" "custom_id" "value" "style" 2 "required" true "placeholder" "the new text"}}{{if and $f (le (len (toRune $f)) 4000)}}{{$D.Set "value" $f}}{{end}}{{if and $g (le (len (toRune $g)) 4000)}}{{$E.Set "value" $g}}{{end}}{{$h := title $f}}{{$l := dbGet 0 $h}}{{$e := $h}}{{if gt (len (toRune $e)) 500}}{{$e = joinStr "" (slice (split $e "") 0 499) "…"}}{{end}}{{$d := ""}}{{if $f}}{{if and $t (reFind "(?i)\\A\\s*new:" $f)}}{{$d = "⚠️ Leave out `new:` — the `create` option does that now."}}{{else}}{{if and (not $t) (not $l)}}{{$d = joinStr "" "⚠️ There is no `" $e "` category. Check the spelling, or set `create` to True to make it."}}{{end}}{{end}}{{end}}{{if $d}}{{sendResponse nil (complexMessage "content" $d "ephemeral" true)}}{{else}}{{if $l}}{{$i := $l.Value}}{{$j := sdict}}{{$y := false}}{{if eq "map[string]interface {}" (printf "%T" $i)}}{{$j = sdict $i}}{{$y = true}}{{else}}{{if eq "map" (kindOf $i true)}}{{$j = $i}}{{$y = true}}{{end}}{{end}}{{if $y}}{{$b := $g}}{{if ne $h "Commands"}}{{$b = title $g}}{{end}}{{if $j.HasKey $b}}{{$a := $j.Get $b}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$x.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$x.Set "value" $a}}{{end}}{{end}}{{end}}{{end}}{{end}}{{$F := print "edit:entry:" currentTime.Unix}}{{if $t}}{{$F = print "edit:entry:new:" currentTime.Unix}}{{end}}{{sendModal (cmodal "title" "Edit entry" "custom_id" $F "fields" (cslice $D $E $x))}}{{end}}{{else}}{{if eq .SubCommand "delete"}}{{$u := false}}{{if .Options.HasKey "rule"}}{{$u = true}}{{end}}{{$f := toString (or .Options.category "")}}{{$g := toString (or .Options.key "")}}{{$I := or (and $u (not $f) (not $g)) (and $f $g (not $u))}}{{if not $I}}{{sendResponse nil (complexMessage "content" "⚠️ Give exactly one form: `rule`, or both `category` and `key`." "ephemeral" true)}}{{else}}{{if $u}}{{$c := toInt (or .Options.rule 0)}}{{if lt $c 1}}{{sendResponse nil (complexMessage "content" "⚠️ You must provide an integer greater than zero!" "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$q := or ((dbGet 0 "Rules")).Value sdict}}{{if not ($q.HasKey $b)}}{{sendResponse nil (complexMessage "content" (print "⚠️ There is no rule #" $c " to delete.") "ephemeral" true)}}{{else}}{{$a := $q.Get $b}}{{$m := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$n := slice (split $a "") 0 4095}}{{$a = joinStr "" $n "…"}}{{end}}{{$m = $a}}{{else}}{{$k := json $a true}}{{$s := sub 4096 8}}{{if gt (len (toRune $k)) $s}}{{$n := slice (split $k "") 0 (sub $s 1)}}{{$k = joinStr "" $n "…"}}{{end}}{{$m = joinStr "" "```\n" $k "\n```"}}{{end}}{{$o := .Member.User.ID}}{{$p := currentTime.Unix}}{{dbSet $o "Edit Pending" (sdict "kind" "rule" "rule" $c "stamp" $p)}}{{$z := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$A := cslice (cbutton "label" (joinStr "" "Delete rule " $c) "style" "danger" "custom_id" (print "editdel:" $o ":" $p ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $o ":" $p ":no"))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete rule #" $c "?") "color" $z "description" $m) "components" (cslice $A))}}{{end}}{{end}}{{else}}{{$h := title $f}}{{$e := $h}}{{if gt (len (toRune $e)) 500}}{{$e = joinStr "" (slice (split $e "") 0 499) "…"}}{{end}}{{$d := ""}}{{$l := dbGet 0 $h}}{{if not $l}}{{$d = joinStr "" "⚠️ There is no `" $e "` category. Check the spelling."}}{{end}}{{$j := sdict}}{{if and (not $d) $l}}{{$i := $l.Value}}{{if eq "map[string]interface {}" (printf "%T" $i)}}{{$j = sdict $i}}{{else}}{{if eq "map" (kindOf $i true)}}{{$j = $i}}{{else}}{{$d = joinStr "" "⚠️ The `" $e "` category doesn't hold a dictionary of entries."}}{{end}}{{end}}{{end}}{{$b := $g}}{{if not $d}}{{if ne $h "Commands"}}{{$b = title $g}}{{end}}{{if not ($j.HasKey $b)}}{{$v := $b}}{{if gt (len (toRune $v)) 500}}{{$v = joinStr "" (slice (split $v "") 0 499) "…"}}{{end}}{{$d = joinStr "" "⚠️ There is no `" $v "` entry in `" $e "` to remove."}}{{end}}{{end}}{{if $d}}{{sendResponse nil (complexMessage "content" $d "ephemeral" true)}}{{else}}{{$a := $j.Get $b}}{{$m := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$n := slice (split $a "") 0 4095}}{{$a = joinStr "" $n "…"}}{{end}}{{$m = $a}}{{else}}{{$k := json $a true}}{{$s := sub 4096 8}}{{if gt (len (toRune $k)) $s}}{{$n := slice (split $k "") 0 (sub $s 1)}}{{$k = joinStr "" $n "…"}}{{end}}{{$m = joinStr "" "```\n" $k "\n```"}}{{end}}{{$o := .Member.User.ID}}{{$p := currentTime.Unix}}{{dbSet $o "Edit Pending" (sdict "kind" "entry" "category" $h "key" $b "stamp" $p)}}{{$z := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$A := cslice (cbutton "label" "Delete entry" "style" "danger" "custom_id" (print "editdel:" $o ":" $p ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $o ":" $p ":no"))}}{{$w := joinStr " › " $h $b}}{{if gt (len (toRune $w)) 248}}{{$w = joinStr "" (slice (split $w "") 0 247) "…"}}{{end}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete " $w "?") "color" $z "description" $m) "components" (cslice $A))}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{else}}
Use /edit as a slash command: rule · entry · delete
{{end}}