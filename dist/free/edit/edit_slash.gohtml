{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `edit`
  Group: `Staff Utility`
  Slash description: `Edit a rule, or a stored setting or message`
  Defer mode: `None`

  The modal front end for rule_edit and simple_db_edit (both in retired/ now): /edit
  opens a prefilled modal (the engines live in edit_modal, the delete confirm's buttons
  in edit_confirm). Defer None is mandatory, not a choice: sendModal IS the interaction's
  one response, and a deferral would eat the slot.

  Slash subcommand: `rule edit a rule's text`
  Slash option: `rule.rule integer! rule number (a number that doesn't exist yet adds a new rule)`
  Slash subcommand: `entry edit a stored setting or message (advanced)`
  Slash option: `entry.section string section to edit, e.g. Inactivity Prune (capitals don't matter)`
  Slash option: `entry.name string name of the entry, e.g. Opening Announcement`
  Slash option: `entry.create boolean start a brand-new section (only if it doesn't exist yet)`
  Slash subcommand: `delete_rule delete a rule (asks you to confirm)`
  Slash option: `delete_rule.rule integer! rule number to delete`
  Slash subcommand: `delete_entry delete a stored entry (asks you to confirm)`
  Slash option: `delete_entry.section string! section of the entry, e.g. Inactivity Prune`
  Slash option: `delete_entry.name string! name of the entry, e.g. Opening Announcement`
*/ -}}
{{if .IsSlashCommand}}{{$I := ((dbGet 0 "Roles")).Value}}{{$J := toInt ($I.Get "Staff")}}{{if not (hasRoleID $J)}}{{sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true)}}{{else}}{{if eq .SubCommand "rule"}}{{$c := toInt (or .Options.rule 0)}}{{if or (lt $c 1) (gt $c 9999)}}{{sendResponse nil (complexMessage "content" "⚠️ Rule numbers run from 1 to 9999." "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$r := or ((dbGet 0 "Rules")).Value sdict}}{{$w := $r.HasKey $b}}{{$a := ""}}{{if $w}}{{$a = $r.Get $b}}{{end}}{{$s := sdict "label" (joinStr "" "Rule " $c " text") "custom_id" "rule_text" "style" 2 "required" true}}{{if $w}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$s.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$s.Set "value" $a}}{{end}}{{else}}{{$s.Set "placeholder" "current value isn't plain text; type a replacement"}}{{end}}{{else}}{{$s.Set "placeholder" "new rule; type its text"}}{{end}}{{$B := joinStr "" "Edit rule " $c}}{{if not $w}}{{$B = joinStr "" "New rule " $c " (doesn't exist yet)"}}{{end}}{{sendModal (cmodal "title" $B "custom_id" (print "edit:rule:" $c ":" currentTime.Unix) "fields" (cslice $s))}}{{end}}{{else}}{{if eq .SubCommand "entry"}}{{$k := toString (or .Options.section "")}}{{$l := toString (or .Options.name "")}}{{$u := or .Options.create false}}{{$C := "e.g. Inactivity Prune"}}{{if $u}}{{$C = "a new or existing section"}}{{end}}{{$D := sdict "label" "Section" "custom_id" "category" "style" 1 "required" true "placeholder" $C}}{{$E := sdict "label" "Name" "custom_id" "key" "style" 1 "required" true "placeholder" "e.g. Opening Announcement"}}{{$x := sdict "label" "New text" "custom_id" "value" "style" 2 "required" true "placeholder" "the new text"}}{{$F := false}}{{$G := ""}}{{if and $k (le (len (toRune $k)) 4000)}}{{$D.Set "value" $k}}{{end}}{{if and $l (le (len (toRune $l)) 4000)}}{{$E.Set "value" $l}}{{end}}{{$f := title $k}}{{$m := dbGet 0 $f}}{{$d := $f}}{{if gt (len (toRune $d)) 500}}{{$d = joinStr "" (slice (split $d "") 0 499) "…"}}{{end}}{{$e := ""}}{{if $k}}{{if and $u (reFind "(?i)\\A\\s*new:" $k)}}{{$e = "⚠️ Leave out `new:` — the `create` option does that now."}}{{else}}{{if and (not $u) (not $m)}}{{$e = joinStr "" "⚠️ There is no section called `" $d "`. Check the spelling, or set `create` to True to start a new one."}}{{end}}{{end}}{{end}}{{if $e}}{{sendResponse nil (complexMessage "content" $e "ephemeral" true)}}{{else}}{{if $m}}{{$g := $m.Value}}{{$h := sdict}}{{$y := false}}{{if eq "map[string]interface {}" (printf "%T" $g)}}{{$h = sdict $g}}{{$y = true}}{{else}}{{if eq "map" (kindOf $g true)}}{{$h = $g}}{{$y = true}}{{end}}{{end}}{{if $y}}{{$b := $l}}{{if ne $f "Commands"}}{{$b = title $l}}{{end}}{{if $h.HasKey $b}}{{$a := $h.Get $b}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$x.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$x.Set "value" $a}}{{end}}{{else}}{{$F = true}}{{$G = $b}}{{end}}{{end}}{{end}}{{end}}{{if $F}}{{$i := joinStr " › " $d $G}}{{if gt (len (toRune $i)) 500}}{{$i = joinStr "" (slice (split $i "") 0 499) "…"}}{{end}}{{sendResponse nil (complexMessage "content" (joinStr "" "⚠️ `" $i "` holds a list or a group of settings, not text, so it can't be edited here. An admin can change it with /db.") "ephemeral" true)}}{{else}}{{$H := print "edit:entry:" currentTime.Unix}}{{if $u}}{{$H = print "edit:entry:new:" currentTime.Unix}}{{end}}{{sendModal (cmodal "title" "Edit entry" "custom_id" $H "fields" (cslice $D $E $x))}}{{end}}{{end}}{{else}}{{if eq .SubCommand "delete_rule"}}{{$c := toInt (or .Options.rule 0)}}{{if lt $c 1}}{{sendResponse nil (complexMessage "content" "⚠️ Rule numbers start at 1." "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$r := or ((dbGet 0 "Rules")).Value sdict}}{{if not ($r.HasKey $b)}}{{sendResponse nil (complexMessage "content" (print "⚠️ There is no rule #" $c " to delete.") "ephemeral" true)}}{{else}}{{$a := $r.Get $b}}{{$n := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$o := slice (split $a "") 0 4095}}{{$a = joinStr "" $o "…"}}{{end}}{{$n = $a}}{{else}}{{$j := json $a true}}{{$t := sub 4096 8}}{{if gt (len (toRune $j)) $t}}{{$o := slice (split $j "") 0 (sub $t 1)}}{{$j = joinStr "" $o "…"}}{{end}}{{$n = joinStr "" "```\n" $j "\n```"}}{{end}}{{$p := .Member.User.ID}}{{$q := currentTime.Unix}}{{dbSet $p "Edit Pending" (sdict "kind" "rule" "rule" $c "stamp" $q)}}{{$z := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$A := cslice (cbutton "label" (joinStr "" "Delete rule " $c) "style" "danger" "custom_id" (print "editdel:" $p ":" $q ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $p ":" $q ":no"))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete rule #" $c "?") "color" $z "description" $n) "components" (cslice $A))}}{{end}}{{end}}{{else}}{{if eq .SubCommand "delete_entry"}}{{$k := toString (or .Options.section "")}}{{$l := toString (or .Options.name "")}}{{$f := title $k}}{{$d := $f}}{{if gt (len (toRune $d)) 500}}{{$d = joinStr "" (slice (split $d "") 0 499) "…"}}{{end}}{{$e := ""}}{{$m := dbGet 0 $f}}{{if not $m}}{{$e = joinStr "" "⚠️ There is no section called `" $d "`. Check the spelling."}}{{end}}{{$h := sdict}}{{if and (not $e) $m}}{{$g := $m.Value}}{{if eq "map[string]interface {}" (printf "%T" $g)}}{{$h = sdict $g}}{{else}}{{if eq "map" (kindOf $g true)}}{{$h = $g}}{{else}}{{$e = joinStr "" "⚠️ `" $d "` can't be edited by name: " "it holds a single value or a list. An admin can change it with /db."}}{{end}}{{end}}{{end}}{{$b := $l}}{{if not $e}}{{if ne $f "Commands"}}{{$b = title $l}}{{end}}{{if not ($h.HasKey $b)}}{{$v := $b}}{{if gt (len (toRune $v)) 500}}{{$v = joinStr "" (slice (split $v "") 0 499) "…"}}{{end}}{{$e = joinStr "" "⚠️ There is no entry called `" $v "` in `" $d "`."}}{{end}}{{end}}{{if $e}}{{sendResponse nil (complexMessage "content" $e "ephemeral" true)}}{{else}}{{$a := $h.Get $b}}{{$n := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$o := slice (split $a "") 0 4095}}{{$a = joinStr "" $o "…"}}{{end}}{{$n = $a}}{{else}}{{$j := json $a true}}{{$t := sub 4096 8}}{{if gt (len (toRune $j)) $t}}{{$o := slice (split $j "") 0 (sub $t 1)}}{{$j = joinStr "" $o "…"}}{{end}}{{$n = joinStr "" "```\n" $j "\n```"}}{{end}}{{$p := .Member.User.ID}}{{$q := currentTime.Unix}}{{dbSet $p "Edit Pending" (sdict "kind" "entry" "category" $f "key" $b "stamp" $q)}}{{$z := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$A := cslice (cbutton "label" "Delete entry" "style" "danger" "custom_id" (print "editdel:" $p ":" $q ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $p ":" $q ":no"))}}{{$i := joinStr " › " $f $b}}{{if gt (len (toRune $i)) 248}}{{$i = joinStr "" (slice (split $i "") 0 247) "…"}}{{end}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete " $i "?") "color" $z "description" $n) "components" (cslice $A))}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{else}}
Use /edit as a slash command: rule · entry · delete_rule · delete_entry
{{end}}