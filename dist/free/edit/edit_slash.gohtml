{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `edit`
  Group: `Staff Utility`
  Slash description: `Edit a rule, or a stored setting or message`
  Defer mode: `None`

  The modal front end for rule_edit and simple_db_edit (both in retired/ now): /edit
  opens a prefilled modal (the engines live in edit_modal, the delete confirm's buttons
  in edit_confirm). Defer None is mandatory, not a choice: sendModal IS the interaction's
  one response, and a deferral would eat the slot.

  Slash subcommand: `rule edit a rule's text`
  Slash option: `rule.rule integer! rule number (a number that doesn't exist yet adds a new rule)`
  Slash subcommand: `entry edit a stored setting or message (advanced)`
  Slash option: `entry.section string section to edit, e.g. Inactivity Prune (capitals don't matter)`
  Slash option: `entry.name string name of the entry, e.g. Opening Announcement`
  Slash option: `entry.create boolean start a brand-new section (only if it doesn't exist yet)`
  Slash subcommand: `delete delete a rule or entry`
  Slash option: `delete.rule integer rule number (to delete a rule)`
  Slash option: `delete.section string section of the entry (to delete an entry, with name)`
  Slash option: `delete.name string name of the entry (with section)`
*/ -}}
{{if .IsSlashCommand}}{{$J := ((dbGet 0 "Roles")).Value}}{{$K := toInt ($J.Get "Staff")}}{{if not (hasRoleID $K)}}{{sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true)}}{{else}}{{if eq .SubCommand "rule"}}{{$c := toInt (or .Options.rule 0)}}{{if or (lt $c 1) (gt $c 9999)}}{{sendResponse nil (complexMessage "content" "⚠️ Rule numbers run from 1 to 9999." "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$r := or ((dbGet 0 "Rules")).Value sdict}}{{$x := $r.HasKey $b}}{{$a := ""}}{{if $x}}{{$a = $r.Get $b}}{{end}}{{$s := sdict "label" (joinStr "" "Rule " $c " text") "custom_id" "rule_text" "style" 2 "required" true}}{{if $x}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$s.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$s.Set "value" $a}}{{end}}{{else}}{{$s.Set "placeholder" "current value isn't plain text; type a replacement"}}{{end}}{{else}}{{$s.Set "placeholder" "new rule; type its text"}}{{end}}{{$C := joinStr "" "Edit rule " $c}}{{if not $x}}{{$C = joinStr "" "New rule " $c " (doesn't exist yet)"}}{{end}}{{sendModal (cmodal "title" $C "custom_id" (print "edit:rule:" $c ":" currentTime.Unix) "fields" (cslice $s))}}{{end}}{{else}}{{if eq .SubCommand "entry"}}{{$f := toString (or .Options.section "")}}{{$g := toString (or .Options.name "")}}{{$u := or .Options.create false}}{{$D := "e.g. Inactivity Prune"}}{{if $u}}{{$D = "a new or existing section"}}{{end}}{{$E := sdict "label" "Section" "custom_id" "category" "style" 1 "required" true "placeholder" $D}}{{$F := sdict "label" "Name" "custom_id" "key" "style" 1 "required" true "placeholder" "e.g. Opening Announcement"}}{{$y := sdict "label" "New text" "custom_id" "value" "style" 2 "required" true "placeholder" "the new text"}}{{$G := false}}{{$H := ""}}{{if and $f (le (len (toRune $f)) 4000)}}{{$E.Set "value" $f}}{{end}}{{if and $g (le (len (toRune $g)) 4000)}}{{$F.Set "value" $g}}{{end}}{{$h := title $f}}{{$m := dbGet 0 $h}}{{$d := $h}}{{if gt (len (toRune $d)) 500}}{{$d = joinStr "" (slice (split $d "") 0 499) "…"}}{{end}}{{$e := ""}}{{if $f}}{{if and $u (reFind "(?i)\\A\\s*new:" $f)}}{{$e = "⚠️ Leave out `new:` — the `create` option does that now."}}{{else}}{{if and (not $u) (not $m)}}{{$e = joinStr "" "⚠️ There is no section called `" $d "`. Check the spelling, or set `create` to True to start a new one."}}{{end}}{{end}}{{end}}{{if $e}}{{sendResponse nil (complexMessage "content" $e "ephemeral" true)}}{{else}}{{if $m}}{{$i := $m.Value}}{{$j := sdict}}{{$z := false}}{{if eq "map[string]interface {}" (printf "%T" $i)}}{{$j = sdict $i}}{{$z = true}}{{else}}{{if eq "map" (kindOf $i true)}}{{$j = $i}}{{$z = true}}{{end}}{{end}}{{if $z}}{{$b := $g}}{{if ne $h "Commands"}}{{$b = title $g}}{{end}}{{if $j.HasKey $b}}{{$a := $j.Get $b}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$y.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$y.Set "value" $a}}{{end}}{{else}}{{$G = true}}{{$H = $b}}{{end}}{{end}}{{end}}{{end}}{{if $G}}{{$k := joinStr " › " $d $H}}{{if gt (len (toRune $k)) 500}}{{$k = joinStr "" (slice (split $k "") 0 499) "…"}}{{end}}{{sendResponse nil (complexMessage "content" (joinStr "" "⚠️ `" $k "` holds a list or a group of settings, not text, so it can't be edited here. An admin can change it with /db.") "ephemeral" true)}}{{else}}{{$I := print "edit:entry:" currentTime.Unix}}{{if $u}}{{$I = print "edit:entry:new:" currentTime.Unix}}{{end}}{{sendModal (cmodal "title" "Edit entry" "custom_id" $I "fields" (cslice $E $F $y))}}{{end}}{{end}}{{else}}{{if eq .SubCommand "delete"}}{{$v := false}}{{if .Options.HasKey "rule"}}{{$v = true}}{{end}}{{$f := toString (or .Options.section "")}}{{$g := toString (or .Options.name "")}}{{$L := or (and $v (not $f) (not $g)) (and $f $g (not $v))}}{{if not $L}}{{sendResponse nil (complexMessage "content" "⚠️ To delete a rule, give only `rule`. To delete an entry, give both `section` and `name`." "ephemeral" true)}}{{else}}{{if $v}}{{$c := toInt (or .Options.rule 0)}}{{if lt $c 1}}{{sendResponse nil (complexMessage "content" "⚠️ Rule numbers start at 1." "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$r := or ((dbGet 0 "Rules")).Value sdict}}{{if not ($r.HasKey $b)}}{{sendResponse nil (complexMessage "content" (print "⚠️ There is no rule #" $c " to delete.") "ephemeral" true)}}{{else}}{{$a := $r.Get $b}}{{$n := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$o := slice (split $a "") 0 4095}}{{$a = joinStr "" $o "…"}}{{end}}{{$n = $a}}{{else}}{{$l := json $a true}}{{$t := sub 4096 8}}{{if gt (len (toRune $l)) $t}}{{$o := slice (split $l "") 0 (sub $t 1)}}{{$l = joinStr "" $o "…"}}{{end}}{{$n = joinStr "" "```\n" $l "\n```"}}{{end}}{{$p := .Member.User.ID}}{{$q := currentTime.Unix}}{{dbSet $p "Edit Pending" (sdict "kind" "rule" "rule" $c "stamp" $q)}}{{$A := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$B := cslice (cbutton "label" (joinStr "" "Delete rule " $c) "style" "danger" "custom_id" (print "editdel:" $p ":" $q ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $p ":" $q ":no"))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete rule #" $c "?") "color" $A "description" $n) "components" (cslice $B))}}{{end}}{{end}}{{else}}{{$h := title $f}}{{$d := $h}}{{if gt (len (toRune $d)) 500}}{{$d = joinStr "" (slice (split $d "") 0 499) "…"}}{{end}}{{$e := ""}}{{$m := dbGet 0 $h}}{{if not $m}}{{$e = joinStr "" "⚠️ There is no section called `" $d "`. Check the spelling."}}{{end}}{{$j := sdict}}{{if and (not $e) $m}}{{$i := $m.Value}}{{if eq "map[string]interface {}" (printf "%T" $i)}}{{$j = sdict $i}}{{else}}{{if eq "map" (kindOf $i true)}}{{$j = $i}}{{else}}{{$e = joinStr "" "⚠️ The `" $d "` category doesn't hold a dictionary of entries."}}{{end}}{{end}}{{end}}{{$b := $g}}{{if not $e}}{{if ne $h "Commands"}}{{$b = title $g}}{{end}}{{if not ($j.HasKey $b)}}{{$w := $b}}{{if gt (len (toRune $w)) 500}}{{$w = joinStr "" (slice (split $w "") 0 499) "…"}}{{end}}{{$e = joinStr "" "⚠️ There is no entry called `" $w "` in `" $d "`."}}{{end}}{{end}}{{if $e}}{{sendResponse nil (complexMessage "content" $e "ephemeral" true)}}{{else}}{{$a := $j.Get $b}}{{$n := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$o := slice (split $a "") 0 4095}}{{$a = joinStr "" $o "…"}}{{end}}{{$n = $a}}{{else}}{{$l := json $a true}}{{$t := sub 4096 8}}{{if gt (len (toRune $l)) $t}}{{$o := slice (split $l "") 0 (sub $t 1)}}{{$l = joinStr "" $o "…"}}{{end}}{{$n = joinStr "" "```\n" $l "\n```"}}{{end}}{{$p := .Member.User.ID}}{{$q := currentTime.Unix}}{{dbSet $p "Edit Pending" (sdict "kind" "entry" "category" $h "key" $b "stamp" $q)}}{{$A := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$B := cslice (cbutton "label" "Delete entry" "style" "danger" "custom_id" (print "editdel:" $p ":" $q ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $p ":" $q ":no"))}}{{$k := joinStr " › " $h $b}}{{if gt (len (toRune $k)) 248}}{{$k = joinStr "" (slice (split $k "") 0 247) "…"}}{{end}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete " $k "?") "color" $A "description" $n) "components" (cslice $B))}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{else}}
Use /edit as a slash command: rule · entry · delete
{{end}}