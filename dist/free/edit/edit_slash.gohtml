{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `edit`
  Group: `Staff Utility`
  Defer mode: `None`

  The modal front end for rule_edit and simple_db_edit (the text commands stay): /edit
  opens a prefilled modal (the engines live in edit_modal, the delete confirm's buttons
  in edit_confirm). Defer None is mandatory, not a choice: sendModal IS the interaction's
  one response, and a deferral would eat the slot.

  Slash subcommand: `rule edit a rule's text`
  Slash option: `rule.rule integer! the rule's number`
  Slash subcommand: `entry edit a database entry`
  Slash option: `entry.category string category to prefill`
  Slash option: `entry.key string key to prefill`
  Slash subcommand: `delete delete a rule or entry`
  Slash option: `delete.rule integer rule number`
  Slash option: `delete.category string category`
  Slash option: `delete.key string key`
*/ -}}
{{if .IsSlashCommand}}{{$B := ((dbGet 0 "Roles")).Value}}{{$C := toInt ($B.Get "Staff")}}{{if not (hasRoleID $C)}}{{sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true)}}{{else}}{{if eq .SubCommand "rule"}}{{$c := toInt (or .Options.rule 0)}}{{if lt $c 1}}{{sendResponse nil (complexMessage "content" "⚠️ You must provide an integer greater than zero!" "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$p := or ((dbGet 0 "Rules")).Value sdict}}{{$y := $p.HasKey $b}}{{$a := ""}}{{if $y}}{{$a = $p.Get $b}}{{end}}{{$q := sdict "label" (joinStr "" "Rule " $c " text") "custom_id" "rule_text" "style" 2 "required" true}}{{if $y}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$q.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$q.Set "value" $a}}{{end}}{{else}}{{$q.Set "placeholder" "current value isn't plain text; type a replacement"}}{{end}}{{else}}{{$q.Set "placeholder" "new rule; type its text"}}{{end}}{{sendModal (cmodal "title" (joinStr "" "Edit rule " $c) "custom_id" (print "edit:rule:" $c ":" currentTime.Unix) "fields" (cslice $q))}}{{end}}{{else}}{{if eq .SubCommand "entry"}}{{$d := toString (or .Options.category "")}}{{$f := toString (or .Options.key "")}}{{$z := sdict "label" "Category" "custom_id" "category" "style" 1 "required" true "placeholder" "e.g. Admin — new:Name creates one"}}{{$A := sdict "label" "Key" "custom_id" "key" "style" 1 "required" true "placeholder" "the entry's name"}}{{$u := sdict "label" "Value" "custom_id" "value" "style" 2 "required" true "placeholder" "the new text"}}{{if $d}}{{$z.Set "value" $d}}{{end}}{{if $f}}{{$A.Set "value" $f}}{{end}}{{$r := reFind "(?i)\\Anew:" $d}}{{$o := $d}}{{if $r}}{{$o = trimSpace (reReplace "(?i)\\Anew:" $d "")}}{{end}}{{$e := title $o}}{{$k := dbGet 0 $e}}{{if $k}}{{$g := $k.Value}}{{$h := sdict}}{{$v := false}}{{if eq "map[string]interface {}" (printf "%T" $g)}}{{$h = sdict $g}}{{$v = true}}{{else}}{{if eq "map" (kindOf $g true)}}{{$h = $g}}{{$v = true}}{{end}}{{end}}{{if $v}}{{$b := $f}}{{if ne $e "Commands"}}{{$b = title $f}}{{end}}{{if $h.HasKey $b}}{{$a := $h.Get $b}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$u.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$u.Set "value" $a}}{{end}}{{end}}{{end}}{{end}}{{end}}{{sendModal (cmodal "title" "Edit entry" "custom_id" (print "edit:entry:" currentTime.Unix) "fields" (cslice $z $A $u))}}{{else}}{{if eq .SubCommand "delete"}}{{$t := false}}{{if .Options.HasKey "rule"}}{{$t = true}}{{end}}{{$d := toString (or .Options.category "")}}{{$f := toString (or .Options.key "")}}{{$D := or (and $t (not $d) (not $f)) (and $d $f (not $t))}}{{if not $D}}{{sendResponse nil (complexMessage "content" "⚠️ Give exactly one form: `rule`, or both `category` and `key`." "ephemeral" true)}}{{else}}{{if $t}}{{$c := toInt (or .Options.rule 0)}}{{if lt $c 1}}{{sendResponse nil (complexMessage "content" "⚠️ You must provide an integer greater than zero!" "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$p := or ((dbGet 0 "Rules")).Value sdict}}{{if not ($p.HasKey $b)}}{{sendResponse nil (complexMessage "content" (print "⚠️ There is no rule #" $c " to delete.") "ephemeral" true)}}{{else}}{{$a := $p.Get $b}}{{$l := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$m := slice (split $a "") 0 4095}}{{$a = joinStr "" $m "…"}}{{end}}{{$l = $a}}{{else}}{{$i := json $a true}}{{$s := sub 4096 8}}{{if gt (len (toRune $i)) $s}}{{$m := slice (split $i "") 0 (sub $s 1)}}{{$i = joinStr "" $m "…"}}{{end}}{{$l = joinStr "" "```\n" $i "\n```"}}{{end}}{{$n := .Member.User.ID}}{{dbSet $n "Edit Pending" (sdict "kind" "rule" "rule" $c)}}{{$w := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$x := cslice (cbutton "label" (joinStr "" "Delete rule " $c) "style" "danger" "custom_id" (print "editdel:" $n ":" currentTime.Unix ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $n ":" currentTime.Unix ":no"))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete rule #" $c "?") "color" $w "description" $l) "components" (cslice $x))}}{{end}}{{end}}{{else}}{{$r := reFind "(?i)\\Anew:" $d}}{{$o := $d}}{{if $r}}{{$o = trimSpace (reReplace "(?i)\\Anew:" $d "")}}{{end}}{{$e := title $o}}{{$j := ""}}{{if and $r (not $o)}}{{$j = "⚠️ Give a category name after `new:`."}}{{end}}{{$k := ""}}{{if not $j}}{{$k = dbGet 0 $e}}{{if and (not $r) (not $k)}}{{$j = joinStr "" "⚠️ There is no `" $e "` category. Check the spelling, or use `new:" $e "` to create it."}}{{end}}{{end}}{{$h := sdict}}{{if and (not $j) $k}}{{$g := $k.Value}}{{if eq "map[string]interface {}" (printf "%T" $g)}}{{$h = sdict $g}}{{else}}{{if eq "map" (kindOf $g true)}}{{$h = $g}}{{else}}{{$j = joinStr "" "⚠️ The `" $e "` category doesn't hold a dictionary of entries."}}{{end}}{{end}}{{end}}{{$b := $f}}{{if not $j}}{{if ne $e "Commands"}}{{$b = title $f}}{{end}}{{if not ($h.HasKey $b)}}{{$j = joinStr "" "⚠️ There is no `" $b "` entry in `" $e "` to remove."}}{{end}}{{end}}{{if $j}}{{sendResponse nil (complexMessage "content" $j "ephemeral" true)}}{{else}}{{$a := $h.Get $b}}{{$l := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$m := slice (split $a "") 0 4095}}{{$a = joinStr "" $m "…"}}{{end}}{{$l = $a}}{{else}}{{$i := json $a true}}{{$s := sub 4096 8}}{{if gt (len (toRune $i)) $s}}{{$m := slice (split $i "") 0 (sub $s 1)}}{{$i = joinStr "" $m "…"}}{{end}}{{$l = joinStr "" "```\n" $i "\n```"}}{{end}}{{$n := .Member.User.ID}}{{dbSet $n "Edit Pending" (sdict "kind" "entry" "category" $e "key" $b)}}{{$w := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$x := cslice (cbutton "label" "Delete entry" "style" "danger" "custom_id" (print "editdel:" $n ":" currentTime.Unix ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $n ":" currentTime.Unix ":no"))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete " $e " › " $b "?") "color" $w "description" $l) "components" (cslice $x))}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{else}}
Use /edit as a slash command: rule · entry · delete
{{end}}