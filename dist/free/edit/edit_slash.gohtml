{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `edit`
  Group: `Staff Utility`
  Slash description: `Edit rules and database entries`
  Defer mode: `None`

  The modal front end for rule_edit and simple_db_edit (both in retired/ now): /edit
  opens a prefilled modal (the engines live in edit_modal, the delete confirm's buttons
  in edit_confirm). Defer None is mandatory, not a choice: sendModal IS the interaction's
  one response, and a deferral would eat the slot.

  Slash subcommand: `rule edit a rule's text`
  Slash option: `rule.rule integer! the rule's number`
  Slash subcommand: `entry edit a database entry`
  Slash option: `entry.category string category to prefill`
  Slash option: `entry.key string key to prefill`
  Slash subcommand: `delete delete a rule or entry`
  Slash option: `delete.rule integer rule number`
  Slash option: `delete.category string category`
  Slash option: `delete.key string key`
*/ -}}
{{if .IsSlashCommand}}{{$F := ((dbGet 0 "Roles")).Value}}{{$G := toInt ($F.Get "Staff")}}{{if not (hasRoleID $G)}}{{sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true)}}{{else}}{{if eq .SubCommand "rule"}}{{$c := toInt (or .Options.rule 0)}}{{if or (lt $c 1) (gt $c 9999)}}{{sendResponse nil (complexMessage "content" "⚠️ Rule numbers run from 1 to 9999." "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$r := or ((dbGet 0 "Rules")).Value sdict}}{{$C := $r.HasKey $b}}{{$a := ""}}{{if $C}}{{$a = $r.Get $b}}{{end}}{{$s := sdict "label" (joinStr "" "Rule " $c " text") "custom_id" "rule_text" "style" 2 "required" true}}{{if $C}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$s.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$s.Set "value" $a}}{{end}}{{else}}{{$s.Set "placeholder" "current value isn't plain text; type a replacement"}}{{end}}{{else}}{{$s.Set "placeholder" "new rule; type its text"}}{{end}}{{sendModal (cmodal "title" (joinStr "" "Edit rule " $c) "custom_id" (print "edit:rule:" $c ":" currentTime.Unix) "fields" (cslice $s))}}{{end}}{{else}}{{if eq .SubCommand "entry"}}{{$d := toString (or .Options.category "")}}{{$e := toString (or .Options.key "")}}{{$D := sdict "label" "Category" "custom_id" "category" "style" 1 "required" true "placeholder" "e.g. Admin — new:Name creates one"}}{{$E := sdict "label" "Key" "custom_id" "key" "style" 1 "required" true "placeholder" "the entry's name"}}{{$y := sdict "label" "Value" "custom_id" "value" "style" 2 "required" true "placeholder" "the new text"}}{{if and $d (le (len (toRune $d)) 4000)}}{{$D.Set "value" $d}}{{end}}{{if and $e (le (len (toRune $e)) 4000)}}{{$E.Set "value" $e}}{{end}}{{$t := reFind "(?i)\\Anew:" $d}}{{$q := $d}}{{if $t}}{{$q = trimSpace (reReplace "(?i)\\Anew:" $d "")}}{{end}}{{$j := title $q}}{{$k := dbGet 0 $j}}{{if $k}}{{$f := $k.Value}}{{$g := sdict}}{{$z := false}}{{if eq "map[string]interface {}" (printf "%T" $f)}}{{$g = sdict $f}}{{$z = true}}{{else}}{{if eq "map" (kindOf $f true)}}{{$g = $f}}{{$z = true}}{{end}}{{end}}{{if $z}}{{$b := $e}}{{if ne $j "Commands"}}{{$b = title $e}}{{end}}{{if $g.HasKey $b}}{{$a := $g.Get $b}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4000}}{{$y.Set "placeholder" "current text is too long for this box; type a replacement"}}{{else}}{{$y.Set "value" $a}}{{end}}{{end}}{{end}}{{end}}{{end}}{{sendModal (cmodal "title" "Edit entry" "custom_id" (print "edit:entry:" currentTime.Unix) "fields" (cslice $D $E $y))}}{{else}}{{if eq .SubCommand "delete"}}{{$v := false}}{{if .Options.HasKey "rule"}}{{$v = true}}{{end}}{{$d := toString (or .Options.category "")}}{{$e := toString (or .Options.key "")}}{{$H := or (and $v (not $d) (not $e)) (and $d $e (not $v))}}{{if not $H}}{{sendResponse nil (complexMessage "content" "⚠️ Give exactly one form: `rule`, or both `category` and `key`." "ephemeral" true)}}{{else}}{{if $v}}{{$c := toInt (or .Options.rule 0)}}{{if lt $c 1}}{{sendResponse nil (complexMessage "content" "⚠️ You must provide an integer greater than zero!" "ephemeral" true)}}{{else}}{{$b := joinStr "" "Rule #" $c}}{{$r := or ((dbGet 0 "Rules")).Value sdict}}{{if not ($r.HasKey $b)}}{{sendResponse nil (complexMessage "content" (print "⚠️ There is no rule #" $c " to delete.") "ephemeral" true)}}{{else}}{{$a := $r.Get $b}}{{$l := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$m := slice (split $a "") 0 4095}}{{$a = joinStr "" $m "…"}}{{end}}{{$l = $a}}{{else}}{{$h := json $a true}}{{$u := sub 4096 8}}{{if gt (len (toRune $h)) $u}}{{$m := slice (split $h "") 0 (sub $u 1)}}{{$h = joinStr "" $m "…"}}{{end}}{{$l = joinStr "" "```\n" $h "\n```"}}{{end}}{{$n := .Member.User.ID}}{{$o := currentTime.Unix}}{{dbSet $n "Edit Pending" (sdict "kind" "rule" "rule" $c "stamp" $o)}}{{$A := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$B := cslice (cbutton "label" (joinStr "" "Delete rule " $c) "style" "danger" "custom_id" (print "editdel:" $n ":" $o ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $n ":" $o ":no"))}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete rule #" $c "?") "color" $A "description" $l) "components" (cslice $B))}}{{end}}{{end}}{{else}}{{$t := reFind "(?i)\\Anew:" $d}}{{$q := $d}}{{if $t}}{{$q = trimSpace (reReplace "(?i)\\Anew:" $d "")}}{{end}}{{$j := title $q}}{{$p := $j}}{{if gt (len (toRune $p)) 500}}{{$p = joinStr "" (slice (split $p "") 0 499) "…"}}{{end}}{{$i := ""}}{{if and $t (not $q)}}{{$i = "⚠️ Give a category name after `new:`."}}{{end}}{{$k := ""}}{{if not $i}}{{$k = dbGet 0 $j}}{{if and (not $t) (not $k)}}{{$i = joinStr "" "⚠️ There is no `" $p "` category. Check the spelling, or use `new:" $p "` to create it."}}{{end}}{{end}}{{$g := sdict}}{{if and (not $i) $k}}{{$f := $k.Value}}{{if eq "map[string]interface {}" (printf "%T" $f)}}{{$g = sdict $f}}{{else}}{{if eq "map" (kindOf $f true)}}{{$g = $f}}{{else}}{{$i = joinStr "" "⚠️ The `" $p "` category doesn't hold a dictionary of entries."}}{{end}}{{end}}{{end}}{{$b := $e}}{{if not $i}}{{if ne $j "Commands"}}{{$b = title $e}}{{end}}{{if not ($g.HasKey $b)}}{{$w := $b}}{{if gt (len (toRune $w)) 500}}{{$w = joinStr "" (slice (split $w "") 0 499) "…"}}{{end}}{{$i = joinStr "" "⚠️ There is no `" $w "` entry in `" $p "` to remove."}}{{end}}{{end}}{{if $i}}{{sendResponse nil (complexMessage "content" $i "ephemeral" true)}}{{else}}{{$a := $g.Get $b}}{{$l := ""}}{{if eq "string" (printf "%T" $a)}}{{if gt (len (toRune $a)) 4096}}{{$m := slice (split $a "") 0 4095}}{{$a = joinStr "" $m "…"}}{{end}}{{$l = $a}}{{else}}{{$h := json $a true}}{{$u := sub 4096 8}}{{if gt (len (toRune $h)) $u}}{{$m := slice (split $h "") 0 (sub $u 1)}}{{$h = joinStr "" $m "…"}}{{end}}{{$l = joinStr "" "```\n" $h "\n```"}}{{end}}{{$n := .Member.User.ID}}{{$o := currentTime.Unix}}{{dbSet $n "Edit Pending" (sdict "kind" "entry" "category" $j "key" $b "stamp" $o)}}{{$A := toInt (((dbGet 0 "Global")).Value.Get "Embed Color")}}{{$B := cslice (cbutton "label" "Delete entry" "style" "danger" "custom_id" (print "editdel:" $n ":" $o ":go")) (cbutton "label" "Dismiss" "style" "secondary" "custom_id" (print "editdel:" $n ":" $o ":no"))}}{{$x := joinStr " › " $j $b}}{{if gt (len (toRune $x)) 248}}{{$x = joinStr "" (slice (split $x "") 0 247) "…"}}{{end}}{{sendResponse nil (complexMessage "ephemeral" true "embed" (cembed "title" (joinStr "" "Delete " $x "?") "color" $A "description" $l) "components" (cslice $B))}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{end}}{{else}}
Use /edit as a slash command: rule · entry · delete
{{end}}