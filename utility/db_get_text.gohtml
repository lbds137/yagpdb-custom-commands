{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `db_get_text`
  Dependencies: `embed_exec`
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $plainMapType := "map[string]interface {}" }}
{{ $stringType := "string" }}
{{ $noResult := "(no result found)" }}

{{ $key := "" }}
{{ $userID := .User.ID }}
{{ if .ExecData.Key }}
    {{ $key = .ExecData.Key }}
    {{ $userID = or .ExecData.UserID $userID }}
{{ else if gt (len .CmdArgs) 0 }}
    {{ if gt (len .CmdArgs) 1 }}
        {{ if reFind "\\A\\d+\\z" (index .CmdArgs 0) }}
            {{ $userID = toInt (index .CmdArgs 0) }}
        {{ end }}
        {{ $key = index .CmdArgs 1 }}
    {{ else }}
        {{ $key = index .CmdArgs 0 }}
    {{ end }}
{{ end }}

{{ $title := "" }}
{{ $result := "" }}
{{ if $key }}
    {{/* $found: the key exists (its value may be false, 0 or "") */}}
    {{ $value := "" }}
    {{ $found := false }}

    {{ $keyArray := split $key ":" }}
    {{ with dbGet $userID (index $keyArray 0) }}
        {{ $found = true }}
        {{ $value = .Value }}
    {{ end }}
    {{ $title = index $keyArray 0 }}
    {{- range $i, $subkey := $keyArray -}}
        {{- if eq $i 0 }}{{ continue }}{{ end -}}
        {{ $title = joinStr " > " $title $subkey }}
        {{ if and $found (eq "map" (kindOf $value true)) }}
            {{/* a dictionary inside stored JSON is a plain map, without Get: copy it */}}
            {{ if eq $plainMapType (printf "%T" $value) }}
                {{ $value = sdict $value }}
            {{ end }}
            {{ $found = $value.HasKey $subkey }}
            {{ $value = $value.Get $subkey }}
        {{ else }}
            {{ $found = false }}
        {{ end }}
    {{- end -}}

    {{ $result = $noResult }}
    {{ if $found }}
        {{ $result = $value }}
        {{- /* format the value for user-friendly viewing */ -}}
        {{ if ne $stringType (printf "%T" $value) }}
            {{ $result = joinStr "" "```\n" (json $value true) "\n```" }}
        {{ else if not $value }}
            {{ $result = "\"\"" }}
        {{ end }}
    {{ end }}
{{ else }}
    {{ $title = "Missing Argument" }}
    {{ $result = "⚠️ You did not provide a key to look up!" }}
{{ end }}

{{ sendMessage nil (joinStr "" "### " $title "\n\n" $result) }}

{{ deleteTrigger $deleteTriggerDelay }}
