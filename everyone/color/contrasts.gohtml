{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `contrasts`
  Dependencies: `embed_exec`, `contrast`
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}
{{ $deleteResponseDelay := toInt ($globalDict.Get "Delete Response Delay") }}
{{/* the loop below is this run's only execCC fan-out (the invalid-argument branch is
  mutually exclusive), so clamp straight to YAGPDB's 10-per-run premium cap */}}
{{ $execCCLimit := toInt (min (toInt ($globalDict.Get "ExecCC Limit")) 10) }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}
{{ $contrast := toInt ($commandsDict.Get "contrast") }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $colorRegex := "\\A#?(\\d|[A-F]|[a-f]){6}\\z" }}
{{ $discordIDRegex := "\\A\\d{16,}\\z" }}

{{ $args := parseArgs 1 "Usage: `[colors as hex codes]` OR `[role IDs]`"
  (carg "string" "colors as hex codes OR role IDs")
}}

{{/* each word (split on anything but # and hex digits) that is a color or a role ID, up
  to the execCC limit; extras beyond the limit are counted for the warning below */}}
{{ $channelID := .Channel.ID }}
{{ $chosenArg := cslice }}
{{ $droppedCount := 0 }}
{{- range $word := reSplit "[^#0-9A-Fa-f]+" ($args.Get 0) -}}
  {{- $isValid := false -}}
  {{- if reFind $colorRegex $word -}}
    {{- $isValid = true -}}
  {{- else if reFind $discordIDRegex $word -}}
    {{- if $.Guild.GetRole (toInt $word) -}}
      {{- $isValid = true -}}
    {{- end -}}
  {{- end -}}
  {{- if $isValid -}}
    {{- if lt (len $chosenArg) $execCCLimit -}}
      {{- $chosenArg = $chosenArg.Append $word -}}
    {{- else -}}
      {{- $droppedCount = add 1 $droppedCount -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{ $validArgPresent := gt (len $chosenArg) 0 }}

{{ if $validArgPresent }}
  {{/* the dropped-colors warning doesn't depend on the execCC loop below, so it goes out
    before the loop fans out; a sendMessage here is a blocking REST call and always lands
    before an execCC child, which YAGPDB runs in its own goroutine */}}
  {{ if gt $droppedCount 0 }}
    {{ $subjectAndVerb := "" }}
    {{ if eq 1 $droppedCount }}
      {{ $subjectAndVerb = "color was" }}
    {{ else }}
      {{ $subjectAndVerb = "colors were" }}
    {{ end }}
    {{ $limitNoun := "colors" }}
    {{ if eq 1 $execCCLimit }}
      {{ $limitNoun = "color" }}
    {{ end }}
    {{ $errorMsgID := sendMessageRetID $channelID (joinStr " "
      "⚠️ Warning:" $droppedCount $subjectAndVerb "not analyzed because only" $execCCLimit $limitNoun "can be analyzed at a time."
    ) }}
    {{ deleteMessage $channelID $errorMsgID $deleteResponseDelay }}
  {{ end }}
  {{- range $i, $curArg := $chosenArg -}}
    {{- execCC $contrast $yagpdbChannelID 0 (sdict
      "ChannelID" $channelID
      "Parameter" $curArg
    ) -}}
  {{- end -}}
{{ else }}
  {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
    "ChannelID" .Channel.ID
    "Title" "Invalid Argument"
    "Description" "⚠️ You must enter one or more role IDs **OR** colors in the required format (e.g. `#ff0000` for red)!"
    "DeleteResponse" true
    "DeleteDelay" $deleteResponseDelay
  ) }}
{{ end }}

{{ deleteTrigger $deleteTriggerDelay }}
