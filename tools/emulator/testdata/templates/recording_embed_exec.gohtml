{{- /* Mock embed_exec that sends its embed, so tests can assert the channel, title and fields */ -}}
{{ $embed := sdict "title" .ExecData.Title "description" (or .ExecData.Description "") }}
{{ with .ExecData.Fields }}{{ $embed.Set "fields" . }}{{ end }}
{{ sendMessage (or .ExecData.ChannelID nil) (cembed $embed) }}
