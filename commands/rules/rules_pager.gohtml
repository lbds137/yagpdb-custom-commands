{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Message Component`
  Trigger: `^rules:`
  Group: `Utility`
  Dependencies: none (`rule_slash` execCCs this for the first page)
*/ -}}
{{- /* Browse view for the rulebook: one rule per page. `/rule` (rule_slash) execCCs this
  with ExecData {Page: 1}; the child inherits the slash interaction, so the first render
  answers it with sendResponse (public) instead of sendMessage; a click rebuilds the page
  in place — the ◀/▶ buttons carry the page in the custom ID (rules:<page>:<opener>),
  the jump select (rules:jump:<opener>) carries the rule number in .Values, and Dismiss
  is rules:close:<opener>. <opener> is the snowflake of the member who ran `/rule`; it
  rides through every re-render so
  Dismiss stays theirs however many members page the browser. A click on an old id
  without it (rules:<page>, rules:jump) falls back to the clicker, as before. Utility,
  NOT Staff Utility: members click these buttons (the panel group gates every run — the
  reason unhiatus sits in Utility too). Defer mode stays None, as on
  channel_activity_pager: an updateMessage under Update Message Response is refused
  (Discord 40060). */ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $embedColor := toInt ($globalDict.Get "Embed Color") }}
{{ $serverURL := or ($globalDict.Get "Server URL") "" }}
{{ $guildPremiumTier := toInt ($globalDict.Get "Guild Premium Tier") }}

{{ $rulesDict := or (dbGet 0 "Rules").Value sdict }}

{{/* existing rule numbers ascending (a deleted middle rule leaves a gap): collected from
  the keys, then ordered with `sort` — never a `seq` over 1..max, which errors past
  10,000 and so lets one stored "Rule #1000000" break the whole browser */}}
{{ $unsorted := cslice }}
{{- range $k, $v := $rulesDict -}}
    {{- if reFind "\\ARule #(\\d+)\\z" $k -}}
        {{- $ruleN := toInt (reReplace "\\ARule #" $k "") -}}
        {{- $canonical := $rulesDict.HasKey (joinStr "" "Rule #" $ruleN) -}}
        {{- if and (ge $ruleN 1) $canonical (not (in $unsorted $ruleN)) -}}
            {{- $unsorted = $unsorted.Append $ruleN -}}
        {{- end -}}
    {{- end -}}
{{- end -}}
{{ $nums := sort $unsorted }}
{{ $count := len $nums }}

{{/* the guild author, the same block rules.gohtml puts on every rule embed */}}
{{ $gIconExtension := ".png" }}
{{ if ge $guildPremiumTier 1 }}
    {{ $gIconExtension = ".gif" }}
{{ end }}
{{ $gIcon := "" }}
{{ if .Guild.Icon }}
    {{ $gIcon = (joinStr "" "https://cdn.discordapp.com/icons/" (toString .Guild.ID) "/" .Guild.Icon $gIconExtension) }}
{{ else }}
    {{ $gIcon = $globalDict.Get "Default Avatar" }}
{{ end }}
{{ $author := sdict "name" .Guild.Name "url" $serverURL "icon_url" $gIcon }}

{{/* which page: a button carries it in the custom ID, the select the rule number in
  .Values, `Page` in ExecData; every id's third segment is the opener's user id */}}
{{ $page := 1 }}
{{ $jumpN := 0 }}
{{ $action := "" }}
{{ $parts := cslice }}
{{ $opener := toString .User.ID }}
{{/* the first render is identified by ExecData.Page (set only by `rule_slash`),
  not by .Interaction: an execCC child of a slash run inherits the interaction and has no
  CustomID. `and` doesn't short-circuit, so the checks nest */}}
{{ $firstRender := false }}
{{- if .ExecData -}}
    {{- if .ExecData.Page -}}
        {{- $firstRender = true -}}
    {{- end -}}
{{- end -}}
{{ $isClick := false }}
{{- if .Interaction -}}
    {{- if not $firstRender -}}
        {{- $isClick = true -}}
    {{- end -}}
{{- end -}}
{{- if $isClick -}}
    {{- $parts = split .CustomID ":" -}}
    {{- $action = index $parts 1 -}}
    {{- if ge (len $parts) 3 -}}
        {{- if reFind "\\A\\d+\\z" (index $parts 2) -}}
            {{- $opener = index $parts 2 -}}
        {{- end -}}
    {{- end -}}
    {{- if eq $action "jump" -}}
        {{- $jumpN = toInt (index .Values 0) -}}
    {{- else if ne $action "close" -}}
        {{- $page = toInt (index $parts 1) -}}
    {{- end -}}
{{- else -}}
    {{- $page = toInt (or .ExecData.Page 1) -}}
{{- end -}}

{{/* the dismiss button: only the member who opened the browser may use it (the opener's
  id rides in every custom ID, parsed above; a clicker is .User on a component run). On
  the first render, an execCC child, .User is the caller — the member who ran `/rule`
  — and an old id without an opener falls back to the clicker */}}
{{ $closeID := printf "rules:close:%s" $opener }}
{{/* Tzurot design language (consult 2026-09-30): every button carries text, and red is
  reserved for deleting entities — closing a UI the user spawned is a non-action, so
  Dismiss is secondary-styled with a label, not danger-styled */}}
{{ $closeButton := cbutton "emoji" (sdict "name" "🗑") "label" "Dismiss"
    "style" "secondary" "custom_id" $closeID }}

{{- if and (eq $action "close") (ge (len $parts) 3) -}}
    {{- if eq (toString .User.ID) (index $parts 2) -}}
        {{- deleteMessage .Channel.ID .Message.ID 0 -}}
        {{- sendResponse nil (complexMessage "content" "Rule browser dismissed." "ephemeral" true) -}}
    {{- else -}}
        {{- sendResponse nil (complexMessage
            "content" "Only the person who opened this browser can dismiss it."
            "ephemeral" true) -}}
    {{- end -}}
{{- else if eq $count 0 -}}
    {{- $msg := complexMessage
        "embed" (cembed
            "title" "Rules"
            "description" "No rules are configured yet."
            "color" $embedColor
            "author" $author
            "image" (sdict "url" "")
            "thumbnail" (sdict "url" ""))
        "components" (cslice (cslice $closeButton)) -}}
    {{- if $isClick -}}
        {{- updateMessage $msg -}}
    {{- else if .Interaction -}}
        {{- sendResponse nil $msg -}}
    {{- else -}}
        {{- sendMessage nil $msg -}}
    {{- end -}}
{{- else -}}
    {{/* resolve a jump to the nearest existing rule at or after it (the last page when
      that rule was deleted between renders), then clamp any page into range */}}
    {{- if gt $jumpN 0 -}}
        {{- $jumped := false -}}
        {{- $page = $count -}}
        {{- range $idx, $n := $nums -}}
            {{- if and (not $jumped) (ge $n $jumpN) -}}
                {{- $page = add $idx 1 -}}
                {{- $jumped = true -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
    {{- if lt $page 1 -}}{{- $page = 1 -}}{{- end -}}
    {{- if gt $page $count -}}{{- $page = $count -}}{{- end -}}

    {{ $ruleN := index $nums (sub $page 1) }}
    {{ $key := joinStr "" "Rule #" $ruleN }}
    {{ $title := $key }}
    {{- if eq (len $rulesDict) 1 -}}
        {{- $title = "Rules" -}}
    {{- end -}}

    {{/* the rule text, cut to fit the description inside Discord's 4,096-character cap
      and the 6,000-character whole-embed cap, in code points — the cutting embed_exec
      does for `/rule <number>`, done here since the pager owns its embed. No summary
      line (Lila, 2026-09-30): one rule per page makes "page X of Y" redundant with the Page X/Y
      button, and the rule count shows in the jump menu */}}
    {{- $otherLen := add (len (toRune $title)) (len (toRune (print (or $author.name "")))) -}}
    {{- $textMax := toInt (min 4096 (sub 6000 $otherLen)) -}}
    {{- $full := $rulesDict.Get $key -}}
    {{- $text := $full -}}
    {{- if gt (len (toRune $full)) $textMax -}}
        {{- $text = "" -}}
        {{- if ge $textMax 1 -}}
            {{- $kept := slice (split $full "") 0 (sub $textMax 1) -}}
            {{- $text = joinStr "" $kept "…" -}}
        {{- end -}}
    {{- end -}}
    {{- $description := $text -}}

    {{/* the jump select: every existing rule as an option, the shown one selected.
      Discord caps a select at 25 options; the server has 13. Past 25 the rest stay
      reachable by paging only — a range-grouped redesign is filed in
      docs/FUTURE_IMPROVEMENTS.md, trigger: the 26th rule */}}
    {{- $options := cslice -}}
    {{- range $n := $nums -}}
        {{- if lt (len $options) 25 -}}
            {{- $opt := sdict "label" (joinStr "" "Rule #" $n) "value" (toString $n) -}}
            {{- if eq $n $ruleN -}}
                {{- $opt.Set "default" true -}}
            {{- end -}}
            {{- $options = $options.Append $opt -}}
        {{- end -}}
    {{- end -}}
    {{ $row1 := cslice (cmenu "custom_id" (printf "rules:jump:%s" $opener)
        "placeholder" "Jump to rule" "options" $options) }}
    {{/* the trailing "noop" keeps the indicator's ID distinct from every page number */}}
    {{ $row2 := cslice
        (cbutton "emoji" (sdict "name" "◀") "style" "secondary"
            "custom_id" (printf "rules:%d:%s" (sub $page 1) $opener) "disabled" (le $page 1))
        (cbutton "label" (printf "Page %d/%d" $page $count) "style" "secondary"
            "custom_id" "rules:noop" "disabled" true)
        (cbutton "emoji" (sdict "name" "▶") "style" "secondary"
            "custom_id" (printf "rules:%d:%s" (add $page 1) $opener) "disabled" (ge $page $count))
        $closeButton
    }}
    {{ $msg := complexMessage
        "embed" (cembed "title" $title "description" $description "color" $embedColor
            "author" $author "image" (sdict "url" "") "thumbnail" (sdict "url" ""))
        "components" (cslice $row1 $row2)
    }}
    {{- if $isClick -}}
        {{- updateMessage $msg -}}
    {{- else if .Interaction -}}
        {{- sendResponse nil $msg -}}
    {{- else -}}
        {{- sendMessage nil $msg -}}
    {{- end -}}
{{- end -}}
