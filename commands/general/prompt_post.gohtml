{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Modal Submission`
  Trigger: `^prompt:post:`
  Group: `Staff Utility`
  Defer mode: `None`

  The /prompt form's writer (prompt opens it): posts the submitted prompt where the
  form's custom ID points. Thread mode: in a forum channel, a post titled
  `YYYY-MM-DD: ...` whose role ping — if the form has one — goes in as a second
  message (the thread-start endpoint's first message never notifies); anywhere else,
  a createThread thread with the prompt sent into it mention-first. Inline mode: a
  plain message. The date is local time by the Global dict's `Timezone Offset` in
  hours (default -4 = ET). Everything the staff member sees is ephemeral; the post
  is the public artifact.
*/ -}}
{{ if .IsModal }}
	{{ $rolesDict := (dbGet 0 "Roles").Value }}
	{{ $staffRoleID := toInt ($rolesDict.Get "Staff") }}
	{{ if not (hasRoleID $staffRoleID) }}
		{{ sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true) }}
	{{ else }}
		{{/* prompt wrote the custom ID: prompt:post:<t|i>:<target channel ID>:<role ID,
			0 = none>. Nothing else produces this trigger, but a foreign or hand-made ID
			must fail soft — and each part is checked before it is indexed or converted,
			since "or" isn't short-circuiting here */}}
		{{ $parts := split .CustomID ":" }}
		{{ if ne (len $parts) 5 }}
			{{ sendResponse nil (complexMessage
				"content" "⚠️ Malformed prompt form — run /prompt again." "ephemeral" true) }}
		{{ else }}
			{{ $mode := index $parts 2 }}
			{{ $targetID := toInt (index $parts 3) }}
			{{ $roleID := toInt (index $parts 4) }}
			{{ if or (and (ne $mode "t") (ne $mode "i"))
				(not (reFind "\\A\\d+\\z" (index $parts 3)))
				(not (reFind "\\A\\d+\\z" (index $parts 4))) }}
				{{ sendResponse nil (complexMessage
					"content" "⚠️ Malformed prompt form — run /prompt again." "ephemeral" true) }}
			{{ else }}
				{{ $titleInput := "" }}
				{{ if eq $mode "t" }}
					{{ $titleInput = .ModalValues.prompt_title.value }}
				{{ end }}
				{{ $body := .ModalValues.prompt_body.value }}
				{{ $content := $body }}
				{{ if ne $roleID 0 }}
					{{ $content = joinStr " " (mentionRoleID $roleID) $body }}
				{{ end }}
				{{/* thread mode's path is the target's type: a forum channel (type 15)
					takes createForumPost, anything else a createThread thread. The probe
					passes the target ID, never a channel object — the create functions
					read snowflakes only, and an unknown channel comes back nil with no
					error (the empty string is the "no channel" sentinel: a nil literal
					can't seed a variable) */}}
				{{ $isForum := false }}
				{{ if eq $mode "t" }}
					{{ $ch := "" }}
					{{ try }}
						{{ $ch = getChannelOrThread $targetID }}
					{{ catch }}
					{{ end }}
					{{ if $ch }}
						{{ $isForum = eq $ch.Type 15 }}
					{{ end }}
				{{ end }}
				{{/* Discord's client caps the fields, but the role mention is added here,
					so the content that is actually sent gets its own check — never
					clamped. The forum post is the one exception: it carries the bare body
					(its ping is a second message), so the role ping's share of the budget
					applies everywhere but there */}}
				{{ $bodyLen := len (toRune $body) }}
				{{ $contentLen := len (toRune $content) }}
				{{ if gt $bodyLen 2000 }}
					{{ sendResponse nil (complexMessage "content" (print
						"⚠️ The prompt is " $bodyLen " characters — the limit is 2000.")
						"ephemeral" true) }}
				{{ else if and (gt $contentLen 2000) (not $isForum) }}
					{{ sendResponse nil (complexMessage "content" (print
						"⚠️ The role ping puts the prompt at " $contentLen
						" characters — the limit is 2000. Shorten the prompt or drop the role.")
						"ephemeral" true) }}
				{{ else }}
					{{ $offset := -4 }}
					{{ $globalDict := (dbGet 0 "Global").Value }}
					{{ if $globalDict }}
						{{ if $globalDict.HasKey "Timezone Offset" }}
							{{ $offset = toInt ($globalDict.Get "Timezone Offset") }}
						{{ end }}
					{{ end }}
					{{ $local := currentTime.Add (toInt64 (mult $offset 3600000000000)) }}
					{{ $date := $local.Format "2006-01-02" }}
					{{ if eq $mode "t" }}
						{{ $title := print $date ": " $titleInput }}
						{{ $titleLen := len (toRune $title) }}
						{{ if gt $titleLen 100 }}
							{{ sendResponse nil (complexMessage "content" (print
								"⚠️ The thread title is " $titleLen
								" characters — the limit is 100.") "ephemeral" true) }}
						{{ else }}
							{{ if $isForum }}
								{{/* the post carries the bare body: the thread-start
									endpoint's first message never notifies (2026-10-02
									smoke), so the role ping goes in as a second message —
									the shape that does */}}
								{{ $post := "" }}
								{{ try }}
									{{ $post = createForumPost $targetID $title (complexMessage
										"content" $body) }}
								{{ catch }}
								{{ end }}
								{{ if not $post }}
									{{ sendResponse nil (complexMessage
										"content" "⚠️ Couldn't create the post." "ephemeral" true) }}
								{{ else }}
									{{ $pingOK := true }}
									{{ if ne $roleID 0 }}
										{{ try }}
											{{/* the returned ID is captured, not printed: leftover
												template output becomes a followup message */}}
											{{ $pingID := sendMessageRetID $post.ID (complexMessage
												"content" (mentionRoleID $roleID)
												"allowed_mentions" (sdict "parse" (cslice "users" "roles"))) }}
										{{ catch }}
											{{/* the post landed; only the ping failed */}}
											{{ $pingOK = false }}
										{{ end }}
									{{ end }}
									{{ $ack := print "✅ Posted " $title
										": https://discord.com/channels/" .Guild.ID "/" $post.ID }}
									{{ if not $pingOK }}
										{{ $ack = print $ack " (couldn't send the ping message)" }}
									{{ end }}
									{{ sendResponse nil (complexMessage "content" $ack
										"ephemeral" true) }}
								{{ end }}
							{{ else }}
								{{/* a text channel or thread target: Discord is two calls —
									the thread, then the prompt into it. A refusal in the
									second leaves the empty thread behind; that is Discord's
									two-call reality, not a lost post */}}
								{{ $post := "" }}
								{{ try }}
									{{ $post = createThread $targetID 0 $title }}
								{{ catch }}
								{{ end }}
								{{ if not $post }}
									{{ sendResponse nil (complexMessage
										"content" "⚠️ Couldn't create the post." "ephemeral" true) }}
								{{ else }}
									{{ $msgID := 0 }}
									{{ try }}
										{{ if ne $roleID 0 }}
											{{ $msgID = sendMessageRetID $post.ID (complexMessage
												"content" $content
												"allowed_mentions" (sdict "parse" (cslice "users" "roles"))) }}
										{{ else }}
											{{ $msgID = sendMessageRetID $post.ID (complexMessage
												"content" $body) }}
										{{ end }}
									{{ catch }}
									{{ end }}
									{{ if $msgID }}
										{{ sendResponse nil (complexMessage "content" (print
											"✅ Created " $title ": https://discord.com/channels/"
											.Guild.ID "/" $post.ID "/" $msgID) "ephemeral" true) }}
									{{ else }}
										{{ sendResponse nil (complexMessage "content" (print
											"✅ Created " $title
											" but the prompt couldn't be sent into it — check the channel.")
											"ephemeral" true) }}
									{{ end }}
								{{ end }}
							{{ end }}
						{{ end }}
					{{ else }}
						{{ try }}
							{{ $msgID := 0 }}
							{{ if ne $roleID 0 }}
								{{ $msgID = sendMessageRetID $targetID (complexMessage
									"content" $content
									"allowed_mentions" (sdict "parse" (cslice "users" "roles"))) }}
							{{ else }}
								{{ $msgID = sendMessageRetID $targetID (complexMessage
									"content" $body) }}
							{{ end }}
							{{ sendResponse nil (complexMessage "content" (print
								"✅ Sent: https://discord.com/channels/" .Guild.ID "/"
								$targetID "/" $msgID) "ephemeral" true) }}
						{{ catch }}
							{{ sendResponse nil (complexMessage
								"content" "⚠️ Couldn't send the prompt there — check the channel."
								"ephemeral" true) }}
						{{ end }}
					{{ end }}
				{{ end }}
			{{ end }}
		{{ end }}
	{{ end }}
{{ else }}
Reached by submitting a /prompt form; use /prompt as a slash command.
{{ end }}
