{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `staff_roles`
  Group: `Staff Utility`
  Dependencies: `embed_exec`
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}
{{ $deleteResponseDelay := toInt ($globalDict.Get "Delete Response Delay") }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}

{{ $rolesDict := or (dbGet 0 "Roles").Value sdict }}
{{ $staffRoleID := toString ($rolesDict.Get "Staff") }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $staffDict := or (dbGet 0 "Staff").Value sdict }}

{{/* the /staff path (staff_slash execCCs this with ExecData.Staff): the roles come from
  ExecData.Roles, every reply answers the inherited interaction (embed_exec Respond;
  DeleteResponse makes it ephemeral), and there is no trigger message to delete */}}
{{ $staff := false }}
{{ $trigger := "" }}
{{- if .ExecData -}}
    {{- if .ExecData.Staff -}}
        {{- $staff = true -}}
        {{- $trigger = toString (or .ExecData.Roles "") -}}
    {{- end -}}
{{- end -}}
{{ if not $staff }}
    {{ $trigger = .Message.Content }}
{{ end }}
{{/* the /staff path answers through execCCs, and an id that isn't in the Commands dict
  would leave the interaction unanswered: refuse before any side effect */}}
{{ if and $staff (le $embed_exec 0) }}
    {{ sendResponse nil (complexMessage
        "content" "⚠️ Part of this command isn't installed on this server yet. Please tell an admin."
        "ephemeral" true) }}
    {{ return }}
{{ end }}
{{ $roleIDs := reFindAll "\\d{16,}" $trigger }}
{{ if gt (len $roleIDs) 0 }}
    {{/* the text path: the configured Staff role rides along when missing, so a
      partial list never silently drops staff access */}}
    {{ if $staffRoleID }}
        {{ if not (reFind $staffRoleID $trigger) }}
            {{ $trigger = joinStr " " $trigger $staffRoleID }}
        {{ end }}
    {{ end }}
    {{ $roleIDs = reFindAll "\\d{16,}" $trigger }}
    {{ $count := len $roleIDs }}
    {{ if gt $count 0 }}
        {{ $guildRoleIDs := sdict }}
        {{- range $guildRole := .Guild.Roles -}}
            {{- $guildRoleIDs.Set (toString $guildRole.ID) true -}}
        {{- end -}}

        {{ $validRoleIDs := cslice }}
        {{ $ignoredRoleIDs := cslice }}
        {{- range $roleID := $roleIDs -}}
            {{- if $guildRoleIDs.Get $roleID -}}
                {{- $validRoleIDs = $validRoleIDs.Append $roleID -}}
            {{- else -}}
                {{- $ignoredRoleIDs = $ignoredRoleIDs.Append $roleID -}}
            {{- end -}}
        {{- end -}}

        {{ if gt (len $validRoleIDs) 0 }}
            {{ $staffDict.Set "Roles" $validRoleIDs }}
            {{ dbSet 0 "Staff" $staffDict }}
            {{ $result := "The following roles have been designated as staff roles: " }}
            {{- range $validRoleID := $validRoleIDs -}}
                {{- $result = joinStr "" $result "\n- <@&" $validRoleID ">" -}}
            {{- end -}}

            {{ if gt (len $ignoredRoleIDs) 0 }}
                {{- $result = joinStr "\n\n" $result "The following role IDs provided were invalid: " -}}
                {{- range $ignoredRoleID := $ignoredRoleIDs -}}
                    {{- $result = joinStr "" $result "\n- `" $ignoredRoleID "`" -}}
                {{- end -}}
            {{ end }}

            {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
                "ChannelID" .Channel.ID
                "Title" "Staff Roles Configuration"
                "Description" $result
                "AuthorID" .Member.User.ID
                "Respond" $staff
            ) }}
        {{ else }}
            {{ $result := "⚠️ None of the provided role IDs were valid: " }}
            {{- range $ignoredRoleID := $ignoredRoleIDs -}}
                {{- $result = joinStr "" $result "\n- `" $ignoredRoleID "`" -}}
            {{- end -}}

            {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
                "ChannelID" .Channel.ID
                "Title" "Invalid Role IDs"
                "Description" $result
                "DeleteResponse" true
                "DeleteDelay" $deleteResponseDelay
                "Respond" $staff
            ) }}
        {{ end }}
    {{ end }}
{{ else }}
    {{/* bare run: post the picker panel (staff_roles_pick handles the select). The old
      append-and-save clobber is gone; resetting to just the Staff role is now "pick
      only the Staff role in the panel and submit" */}}
    {{ $current := or ($staffDict.Get "Roles") cslice }}
    {{ $result := "No staff roles have been designated yet. Pick them below." }}
    {{ if gt (len $current) 0 }}
        {{ $result = "The following roles have been designated as staff roles: " }}
        {{- range $roleID := $current -}}
            {{- $result = joinStr "" $result "\n- <@&" $roleID ">" -}}
        {{- end -}}
    {{ end }}

    {{ $defaults := cslice }}
    {{- range $roleID := $current -}}
        {{- if lt (len $defaults) 25 -}}
            {{- $defaults = $defaults.Append (sdict "id" $roleID "type" "role") -}}
        {{- end -}}
    {{- end -}}

    {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
        "ChannelID" .Channel.ID
        "Title" "Staff Roles Configuration"
        "Description" $result
        "AuthorID" .Member.User.ID
        "Components" (cslice
            (cmenu "type" "role"
                "custom_id" (print "sr:" .Member.User.ID)
                "min_values" 1
                "max_values" 25
                "placeholder" "Pick the staff roles…"
                "default_values" $defaults))
        "Respond" $staff
    ) }}
{{ end }}

{{ if not $staff }}
    {{ deleteTrigger $deleteTriggerDelay }}
{{ end }}
