{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `hiatus`
  Group: `Staff Utility`
  Slash description: `Step away from staff duties (removes your staff roles)`
  Defer mode: `Ephemeral Message Response`
  Dependencies: `embed_exec`

  The slash version of hiatus. Every reply is ephemeral: the deferred ack goes out before
  the role calls, and the reply is the run's printed output, which fills the deferred
  response. The record goes to Mod Log (the current channel when unset) through ONE
  execCC to embed_exec without `Respond`.
*/ -}}
{{- if .IsSlashCommand -}}
	{{- $globalDict := (dbGet 0 "Global").Value -}}
	{{- $defaultAvatar := $globalDict.Get "Default Avatar" -}}

	{{- $commandsDict := (dbGet 0 "Commands").Value -}}
	{{- $embed_exec := toInt ($commandsDict.Get "embed_exec") -}}

	{{- $channelsDict := (dbGet 0 "Channels").Value -}}
	{{- $modLogChannelID := toInt ($channelsDict.Get "Mod Log") -}}
	{{- $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") -}}

	{{- $staffDict := (dbGet 0 "Staff").Value -}}
	{{- $staffRoleIDs := or ($staffDict.Get "Roles") cslice -}}
	{{- $hiatusDict := or ($staffDict.Get "Hiatus") sdict -}}

	{{- $userID := .User.ID -}}
	{{- $held := cslice -}}
	{{- range $roleID := $staffRoleIDs -}}
		{{- if hasRoleID $roleID -}}
			{{- if not (in $held $roleID) -}}
				{{- $held = $held.Append $roleID -}}
			{{- end -}}
		{{- end -}}
	{{- end -}}

	{{- if le $embed_exec 0 -}}
		{{- print "⚠️ This command isn't set up on this server yet." -}}
	{{- else if eq (len $staffRoleIDs) 0 -}}
		{{- print "⚠️ Staff role IDs must be defined before using this command!" -}}
	{{- else if eq (len $held) 0 -}}
		{{- print "⚠️ You don't hold any of the staff roles! (If you're already on hiatus, /unhiatus restores them.)" -}}
	{{- else -}}
		{{- $mentions := cslice -}}
		{{- range $roleID := $held -}}
			{{- takeRoleID $userID $roleID -}}
			{{- $mentions = $mentions.Append (print "<@&" $roleID ">") -}}
		{{- end -}}
		{{- /* A role re-granted during a hiatus joins the earlier record, not replaces it */ -}}
		{{- $record := or ($hiatusDict.Get (toString $userID)) cslice -}}
		{{- range $roleID := $held -}}
			{{- if not (in $record $roleID) -}}
				{{- $record = $record.Append $roleID -}}
			{{- end -}}
		{{- end -}}
		{{- $hiatusDict.Set (toString $userID) $record -}}
		{{- $staffDict.Set "Hiatus" $hiatusDict -}}
		{{- dbSet 0 "Staff" $staffDict -}}

		{{- $userAvatar := .User.AvatarURL "128" -}}
		{{- $title := "Staff Hiatus Record" -}}
		{{- $description := (joinStr ""
			"💤 Staff member **" .User.String "** (ID: " .User.ID ") has elected to take a hiatus from staff duties."
		) -}}
		{{- $modLogTarget := $modLogChannelID -}}
		{{- if not $modLogTarget -}}
			{{- $modLogTarget = .Channel.ID -}}
		{{- end -}}
		{{- $execChannel := $yagpdbChannelID -}}
		{{- if not $execChannel -}}
			{{- $execChannel = .Channel.ID -}}
		{{- end -}}
		{{- execCC $embed_exec $execChannel 0 (sdict
			"ChannelID" $modLogTarget
			"Title" $title
			"Description" $description
			"ThumbnailURL" (or $userAvatar $defaultAvatar)
		) -}}

		{{- print (joinStr "" "💤 You're on hiatus. Removed: " (joinStr ", " $mentions.StringSlice) ". Use /unhiatus to return.") -}}
	{{- end -}}
{{ else }}
Use /hiatus as a slash command
{{ end }}
