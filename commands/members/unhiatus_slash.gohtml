{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `unhiatus`
  Group: `Utility`
  Slash description: `Return from a staff hiatus (restores your staff roles)`
  Defer mode: `Ephemeral Message Response`
  Dependencies: `embed_exec`

  The slash version of unhiatus. In the Utility group on purpose: a staff member on hiatus
  has lost the roles the Staff Utility group requires, so only recorded roles still in
  Staff.Roles come back (Lila, 2026-10-04). Every reply is ephemeral: the deferred ack
  goes out before the role calls, and the reply is the run's printed output, which
  fills the deferred response. The record goes to Mod Log (the current channel when
  unset) through ONE execCC to embed_exec without `Respond`.
*/ -}}
{{- if .IsSlashCommand -}}
	{{- $globalDict := (dbGet 0 "Global").Value -}}
	{{- $defaultAvatar := $globalDict.Get "Default Avatar" -}}

	{{- $commandsDict := (dbGet 0 "Commands").Value -}}
	{{- $embed_exec := toInt ($commandsDict.Get "embed_exec") -}}

	{{- $channelsDict := (dbGet 0 "Channels").Value -}}
	{{- $modLogChannelID := toInt ($channelsDict.Get "Mod Log") -}}
	{{- $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") -}}

	{{- $staffDict := (dbGet 0 "Staff").Value -}}
	{{- $staffRoleIDs := or ($staffDict.Get "Roles") cslice -}}
	{{- $hiatusDict := or ($staffDict.Get "Hiatus") sdict -}}

	{{- $userID := .User.ID -}}
	{{- $userHiatusSlice := $hiatusDict.Get (toString $userID) -}}

	{{- /* toString keys: `in` doesn't match across int/uint kinds (msgpack IDs) */ -}}
	{{- $staffSet := sdict -}}
	{{- range $staffRoleIDs -}}
		{{- $staffSet.Set (toString .) true -}}
	{{- end -}}
	{{- $restore := cslice -}}
	{{- $dropped := cslice -}}
	{{- range $userHiatusSlice -}}
		{{- if $staffSet.Get (toString .) -}}
			{{- $restore = $restore.Append . -}}
		{{- else -}}
			{{- $dropped = $dropped.Append . -}}
		{{- end -}}
	{{- end -}}

	{{- if le $embed_exec 0 -}}
		{{- print "⚠️ This command isn't set up on this server yet." -}}
	{{- else if eq (len $staffRoleIDs) 0 -}}
		{{- print "⚠️ Staff role IDs must be defined before using this command!" -}}
	{{- else if not $userHiatusSlice -}}
		{{- print "⚠️ You are not a staff member on hiatus!" -}}
	{{- else if eq (len $restore) 0 -}}
		{{- print "⚠️ None of your recorded roles are staff roles anymore, so nothing was restored." -}}
	{{- else -}}
		{{- $mentions := cslice -}}
		{{- range $roleID := $restore -}}
			{{- giveRoleID $userID $roleID -}}
			{{- $mentions = $mentions.Append (print "<@&" $roleID ">") -}}
		{{- end -}}
		{{- $droppedMentions := cslice -}}
		{{- range $roleID := $dropped -}}
			{{- $droppedMentions = $droppedMentions.Append (print "<@&" $roleID ">") -}}
		{{- end -}}
		{{- $hiatusDict.Del (toString $userID) -}}
		{{- $staffDict.Set "Hiatus" $hiatusDict -}}
		{{- /* lint:ignore permission-conditional-staff implicit-via-hiatus-dict */ -}}
		{{- /* lint:ignore database-global-write intentional-staff-hiatus-tracking */ -}}
		{{- dbSet 0 "Staff" $staffDict -}}

		{{- $userAvatar := .User.AvatarURL "128" -}}
		{{- $title := "Staff Unhiatus Record" -}}
		{{- $description := (joinStr ""
			"👋 Staff member **" .User.String "** (ID: " .User.ID ") has elected to return from hiatus and resume staff duties."
		) -}}
		{{- $modLogTarget := $modLogChannelID -}}
		{{- if not $modLogTarget -}}
			{{- $modLogTarget = .Channel.ID -}}
		{{- end -}}
		{{- $execChannel := $yagpdbChannelID -}}
		{{- if not $execChannel -}}
			{{- $execChannel = .Channel.ID -}}
		{{- end -}}
		{{- execCC $embed_exec $execChannel 0 (sdict
			"ChannelID" $modLogTarget
			"Title" $title
			"Description" $description
			"ThumbnailURL" (or $userAvatar $defaultAvatar)
		) -}}

		{{- $reply := joinStr "" "👋 Welcome back! Restored: " (joinStr ", " $mentions.StringSlice) "." -}}
		{{- if $droppedMentions -}}
			{{- $reply = joinStr "" $reply " Not restored (no longer staff roles): " (joinStr ", " $droppedMentions.StringSlice) "." -}}
		{{- end -}}
		{{- print $reply -}}
	{{- end -}}
{{ else }}
Use /unhiatus as a slash command
{{ end }}
