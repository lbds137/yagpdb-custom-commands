{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `inactivity`
  Group: `Staff Utility`
  Dependencies: `embed_exec`, `db_slash`
*/ -}}

{{/* the /staff path (staff_slash execCCs this with ExecData.Staff and Action, Date, User):
  the options come from ExecData instead of parseArgs, refusals answer the inherited
  interaction ephemerally, the announcements stay real channel posts with an ephemeral ack,
  and there is no trigger message to delete */}}
{{ $staff := false }}
{{- if .ExecData -}}
    {{- if .ExecData.Staff -}}
        {{- $staff = true -}}
    {{- end -}}
{{- end -}}
{{ $action := "" }}
{{ $param := "" }}
{{ if $staff }}
    {{ $action = toString (or .ExecData.Action "") }}
    {{ if eq $action "date" }}
        {{ $param = toString (or .ExecData.Date "") }}
    {{ else if eq $action "prune" }}
        {{ $param = toString (or .ExecData.User "") }}
    {{ end }}
{{ else }}
    {{ $args := parseArgs 1 "Please specify an action: `date`, `end`, `prune`, `remind`, or `start`."
        (carg "string" "action")
        (carg "string" "param (optional)")
    }}
    {{ $action = $args.Get 0 }}
    {{ if $args.IsSet 1 }}
        {{ $param = $args.Get 1 }}
    {{ end }}
{{ end }}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}
{{ $deleteResponseDelay := toInt ($globalDict.Get "Delete Response Delay") }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}
{{ $db := toInt ($commandsDict.Get "db_slash") }}
{{ $prunePick := toInt ($commandsDict.Get "inactivity_prune_pick") }}

{{/* the /staff path answers through execCCs (embed_exec for every action,
  inactivity_prune_pick for prune only; db_slash is the text path's only), and an id that
  isn't in the Commands dict would leave the interaction unanswered: refuse before any
  side effect */}}
{{ if and $staff (or (le $embed_exec 0) (and (eq $action "prune") (le $prunePick 0))) }}
    {{ sendResponse nil (complexMessage
        "content" "⚠️ Part of this command isn't installed on this server yet. Please tell an admin."
        "ephemeral" true) }}
    {{ return }}
{{ end }}

{{ $rolesDict := (dbGet 0 "Roles").Value }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $pruneCategory := "Inactivity Prune" }}
{{ $pruneDict := (dbGet 0 $pruneCategory).Value }}
{{ $prevDate := $pruneDict.Get "Previous Date" }}
{{ $nextDate := $pruneDict.Get "Next Date" }}
{{ $messageThreshold := $pruneDict.Get "Message Threshold" }}
{{ $minuteThreshold := $pruneDict.Get "Minute Threshold" }}

{{ $isDate := eq $action "date" }}
{{ $isEnd := eq $action "end" }}
{{ $isPrune := eq $action "prune" }}
{{ $isRemind := eq $action "remind" }}
{{ $isStart := eq $action "start" }}

{{ if or $isDate $isEnd $isPrune $isRemind $isStart }}
    {{ $heading := "" }}
    {{ $result := "" }}
    {{ if or $isEnd $isRemind $isStart }}
        {{ $roleID := "" }}
        {{ if $isStart }}
            {{ $heading = "Opening Announcement" }}
            {{ $roleID = toInt ($rolesDict.Get "Member") }}
        {{ else if $isEnd }}
            {{ $heading = "Closing Announcement" }}
            {{ $roleID = toInt ($rolesDict.Get "Member") }}
        {{ else }}
            {{ $heading = "Reminder" }}
            {{ $roleID = toInt ($rolesDict.Get "Inactive") }}
        {{ end }}

        {{ $result = $pruneDict.Get $heading }}
        {{ $result = reReplace "\\#\\{previous_date\\}" $result $prevDate }}
        {{ $result = reReplace "\\#\\{next_date\\}" $result $nextDate }}
        {{ $result = reReplace "\\#\\{message_threshold\\}" $result $messageThreshold }}
        {{ $result = reReplace "\\#\\{minute_threshold\\}" $result $minuteThreshold }}

        {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
            "ChannelID" .Channel.ID
            "Title" (joinStr " " $pruneCategory $heading)
            "Description" $result
        ) }}

        {{ if $staff }}
            {{/* printed output would become the interaction response here, so the ping is
              an explicit send whose allowed_mentions carry the role (sendMessage keeps a
              complexMessage's allowed mentions); then the ephemeral ack */}}
            {{ $ping := mentionRoleID $roleID }}
            {{ if $ping }}
                {{ sendMessage nil (complexMessage
                    "content" $ping
                    "allowed_mentions" (sdict "roles" (cslice $roleID))) }}
            {{ end }}
            {{ sendResponse nil (complexMessage
                "content" (print "Posted the " $heading ".")
                "ephemeral" true) }}
        {{ else }}
            {{ mentionRoleID $roleID }}
        {{ end }}
    {{ else if $isDate }}
        {{ if $param }}
            {{ $heading = "Inactivity Prune Date Editing" }}
            {{ if $staff }}
                {{/* the dict is written here: root, inactivity, db_slash, embed_exec would
                  be depth 3, which YAGPDB refuses. The reply is a plain previous/next embed */}}
                {{ $newPrune := sdict (or $pruneDict (sdict)) }}
                {{ $_ := $newPrune.Set "Previous Date" $nextDate }}
                {{ $_ := $newPrune.Set "Next Date" $param }}
                {{ dbSet 0 $pruneCategory $newPrune }}
                {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
                    "ChannelID" .Channel.ID
                    "Title" "Next prune date updated"
                    "Description" (joinStr "\n"
                        (joinStr "" "**Previous:** " (or $nextDate "_not set_"))
                        (joinStr "" "**Next:** " $param))
                    "Respond" true
                ) }}
            {{ else }}
                {{ execCC $db $yagpdbChannelID 0 (sdict
                    "ChannelID" .Channel.ID
                    "UserID" 0
                    "Operation" "add"
                    "Key" $pruneCategory
                    "Value" (sdict "Previous Date" $nextDate "Next Date" $param)
                    "Title" $heading
                ) }}
            {{ end }}
        {{ else }}
            {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
                "ChannelID" .Channel.ID
                "Title" "Date needed"
                "Description" "⚠️ Give the new prune date, for example `March 1`."
                "DeleteResponse" true
                "DeleteDelay" $deleteResponseDelay
                "Respond" $staff
            ) }}
        {{ end }}
    {{ else if $isPrune }}
        {{ if $param }}
            {{ $userArg := userArg $param }}
            {{ if $userArg }}
                {{/* the kick is behind the panel's confirm now, on both paths: hand
                  the target to the picker, which posts the confirm state */}}
                {{ execCC $prunePick .Channel.ID 0 (sdict
                    "User" $userArg.ID
                    "Spawner" .Member.User.ID
                ) }}
            {{ else }}
                {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
                    "ChannelID" .Channel.ID
                    "Title" "Member not found"
                    "Description" "⚠️ I couldn't find that member. Pick one with `user`, or leave it empty to choose from a menu."
                    "DeleteResponse" true
                    "DeleteDelay" $deleteResponseDelay
                    "Respond" $staff
                ) }}
            {{ end }}
        {{ else }}
            {{/* bare prune: post the picker panel (inactivity_prune_pick handles it) */}}
            {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
                "ChannelID" .Channel.ID
                "Title" $pruneCategory
                "Description" (joinStr "\n"
                    (joinStr "" "Previous prune: " (or $prevDate "_not set yet (use /staff inactivity, action date)_"))
                    (joinStr "" "Next prune: " (or $nextDate "_not set yet (use /staff inactivity, action date)_"))
                    ""
                    "Pick a member to review for pruning.")
                "AuthorID" .Member.User.ID
                "Components" (cslice
                    (cmenu "type" "user"
                        "custom_id" (print "ip:" .Member.User.ID)
                        "max_values" 1
                        "placeholder" "Pick a member to review…"))
                "Respond" $staff
            ) }}
        {{ end }}
    {{ end }}
{{ else }}
    {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
        "ChannelID" .Channel.ID
        "Title" "Unknown action"
        "Description" "⚠️ Choose one of: `start`, `end`, `remind`, `date` or `prune`."
        "DeleteResponse" true
        "DeleteDelay" $deleteResponseDelay
        "Respond" $staff
    ) }}
{{ end }}

{{ if not $staff }}
    {{ deleteTrigger $deleteTriggerDelay }}
{{ end }}
