{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `pointer`
  Group: `Utility`
  Slash description: `Post a pointer to a message`
  Defer mode: `None`
  Dependencies: `embed_exec`

  The slash version of message_pointer, its logic inlined. ONE execCC to embed_exec with
  `Respond`: the child inherits the interaction and answers it (public), so this run
  prints nothing on that path. An invalid link and a missing embed_exec are ephemeral
  sendResponses of this run, never alongside the execCC (an interaction takes one
  response).

  A link to a message in a channel the invoker can't view (View Channel, 1024) is refused
  with the invalid-link text, so it doesn't confirm the message exists (Lila, 2026-10-04).

  Slash option: `link string! the message link`
  Slash option: `comment string a note to post with it`
*/ -}}
{{ if .IsSlashCommand }}
	{{ $commandsDict := (dbGet 0 "Commands").Value }}
	{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}

	{{ $baseURLRegex := "https://(ptb.|canary.)?discord(?:app)?.com/channels/" }}
	{{ $fullRegex := joinStr "" $baseURLRegex "\\d{16,}/\\d{16,}/\\d{16,}" }}
	{{ $title := "Message Pointer" }}
	{{ $embedFieldLimit := 1024 }}

	{{ $linkArg := or .Options.link "" }}
	{{ $commentArg := or .Options.comment "" }}

	{{ $messageLink := reFind $fullRegex $linkArg }}
	{{ $messageID := "" }}
	{{ $targetChannel := "" }}
	{{ $msg := "" }}
	{{ if $messageLink }}
		{{ $gcmString := reReplace $baseURLRegex $messageLink "" }}
		{{ $gcmSlice := split $gcmString "/" }}
		{{ $channelID := index $gcmSlice 1 }}
		{{ $messageID = index $gcmSlice 2 }}
		{{ $targetChannel = getChannelOrThread $channelID }}
		{{ $msg = getMessage $channelID $messageID }}
		{{ if $msg }}
			{{ if not (bitwiseAnd (getTargetPermissionsIn .User.ID $channelID) 1024) }}
				{{ $msg = "" }}
			{{ end }}
		{{ end }}
	{{ end }}

	{{ if not $msg }}
		{{ sendResponse nil (complexMessage
			"content" "⚠️ The message link argument does not match any valid message sent within the server."
			"ephemeral" true) }}
	{{ else if le $embed_exec 0 }}
		{{ sendResponse nil (complexMessage
			"content" "⚠️ This command isn't set up on this server yet."
			"ephemeral" true) }}
	{{ else }}
		{{ $fields := cslice }}
		{{ if $commentArg }}
			{{ $trimmedComment := $commentArg }}
			{{ if gt (len (toRune $commentArg)) $embedFieldLimit }}
				{{ $trimmedComment = joinStr ""
					(slice (split $commentArg "") 0 (sub $embedFieldLimit 1)) "…" }}
			{{ end }}
			{{ $fields = $fields.Append (sdict
				"name" "Comment"
				"value" $trimmedComment
				"inline" false
			) }}
		{{ end }}
		{{ $fields = $fields.Append (sdict
			"name" "Original Channel"
			"value" (joinStr "" "#️⃣ [" $targetChannel.Name "](" (index (split $messageLink $messageID) 0) ")")
			"inline" false
		) }}
		{{ $fields = $fields.Append (sdict
			"name" "Original Message"
			"value" (joinStr "" "🔗 [Click or tap here to view the message.](" $messageLink ")")
			"inline" false
		) }}

		{{ execCC $embed_exec .Channel.ID 0 (sdict
			"AuthorID" .User.ID
			"ChannelID" .Channel.ID
			"Title" $title
			"Description" ""
			"Fields" $fields
			"Respond" true
		) }}
	{{ end }}
{{ else }}
Use /pointer as a slash command with the message link and an optional comment
{{ end }}
