{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `db`
  Group: `Utility`
  Slash description: `Advanced: read or change stored server settings`
  Defer mode: `None`
  Dependencies: `embed_exec` (the ExecData path only)

  The slash version of retired/db.gohtml (text /db retired 2026-10-01): same engine,
  ephemeral sendResponse instead of embed_exec. inactivity's "date" execCC still
  arrives on the ExecData path, which keeps db.gohtml's behavior, embed_exec included.

  Slash subcommand: `view show one stored value`
  Slash option: `view.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `view.user user another member's own data (staff)`
  Slash subcommand: `browse list the names inside a group`
  Slash option: `browse.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `browse.user user another member's own data (staff)`
  Slash subcommand: `set replace a stored value`
  Slash option: `set.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `set.value string! the new value (JSON for lists and groups)`
  Slash option: `set.user user another member's own data (staff)`
  Slash subcommand: `add add an item to a list or group`
  Slash option: `add.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `add.value string! the new value (JSON for lists and groups)`
  Slash option: `add.user user another member's own data (staff)`
  Slash subcommand: `remove take an item out of a list or group`
  Slash option: `remove.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `remove.value string! the item to take out (JSON for lists and groups)`
  Slash option: `remove.user user another member's own data (staff)`
  Slash subcommand: `delete delete a stored entry`
  Slash option: `delete.key string! name of the entry; use : to go inside a group, e.g. Roles:Staff`
  Slash option: `delete.user user another member's own data (staff)`
  Slash subcommand: `export download entries as a JSON file`
  Slash option: `export.key string empty = all entries`
  Slash option: `export.user user another member's own data (staff)`

  view = get, browse = keys, export = dump. Rows: staff default to the global row 0
  (the old `:0` without the colon), a picked `user` targets that member, everyone
  else their own row.
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}
{{ $embedColor := toInt ($globalDict.Get "Embed Color") }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}

{{ $rolesDict := (dbGet 0 "Roles").Value }}
{{ $staffRoleID := toInt ($rolesDict.Get "Staff") }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $plainMapType := "map[string]interface {}" }}
{{ $stringType := "string" }}

{{ $userID := .Member.User.ID }}
{{ $operation := "" }}
{{ $subcommand := "" }}
{{ $key := "" }}
{{ $value := "" }}
{{ $valueType := "" }}
{{ $title := "" }}
{{ $isSlash := false }}
{{ $targeted := false }}

{{ $isExec := or .ExecData.UserID .ExecData.Operation .ExecData.Key .ExecData.Value .ExecData.Title }}

{{ if $isExec }}
    {{ $userID = .ExecData.UserID }}
    {{ $operation = .ExecData.Operation }}
    {{ $key = .ExecData.Key }}
    {{ $value = .ExecData.Value }}
    {{ $valueType = printf "%T" $value }}
    {{ $title = .ExecData.Title }}
{{ else if .IsSlashCommand }}
    {{ $isSlash = true }}
    {{ $subcommand = .SubCommand }}
    {{ $operation = .SubCommand }}
    {{ if eq $operation "view" }}
        {{ $operation = "get" }}
    {{ else if eq $operation "browse" }}
        {{ $operation = "keys" }}
    {{ else if eq $operation "export" }}
        {{ $operation = "dump" }}
    {{ end }}
    {{ $key = or .Options.key "" }}
    {{ $value = or .Options.value "" }}
    {{ $valueType = printf "%T" $value }}
    {{/* staff default to the GLOBAL row (0) — the text command's `:0`, no colon needed;
        a picked `user` targets that member (self included); others keep their own row */}}
    {{ if hasRoleID $staffRoleID }}
        {{ $userID = 0 }}
        {{ if .Options.user }}
            {{ $userID = toInt .Options.user.ID }}
            {{ $targeted = true }}
        {{ end }}
    {{ end }}
{{ end }}

{{ $isKeys := eq "keys" $operation }}
{{ $isDelete := eq "delete" $operation }}
{{ $isGet := eq "get" $operation }}
{{ $isSet := eq "set" $operation }}
{{ $isAdd := eq "add" $operation }}
{{ $isRemove := eq "remove" $operation }}
{{ $isDump := eq "dump" $operation }}
{{ $operationCheck := or $isKeys $isDelete $isGet $isSet $isAdd $isRemove $isDump }}
{{ $valueCheck := or $value $isKeys $isDelete $isGet $isDump }}

{{ $nil := "(nil)" }}
{{ $invalidValueText := "Invalid value provided! Please double check your input and try again." }}
{{ $resultText := "" }}
{{ $resultEmoji := "✅" }}
{{ $displayUserID := $userID }}
{{/* For dump operation, key is optional (defaults to "all") */}}
{{ if and $isDump (not $key) }}
    {{ $key = "all" }}
{{ end }}
{{ if and $operationCheck $key $valueCheck }}
    {{/* the engine below is retired/db.gohtml's verbatim; its comments live there
        (kept out here: YAGPDB's panel double-counts newlines against the 20k limit).
        Every .Set/.Del is a `$_ :=` declaration: one never prints (a nil receiver would
        print "<no value>"), which lets yagmin drop the whitespace around it */}}
    {{ $existingValue := "" }}
    {{ $found := false }}

    {{ $keyArray := split $key ":" }}
    {{ $parentExistingValue := "" }}
    {{ $lastParentExistingValue := "" }}
    {{ $parentFound := false }}
    {{ $firstSubkey := index $keyArray 0 }}
    {{ $lastSubkey := index $keyArray (sub (len $keyArray) 1) }}
    {{ if ge (len $keyArray) 2 }}
        {{ $parentExistingValue = (dbGet $userID $firstSubkey).Value }}
        {{ if eq $plainMapType (printf "%T" $parentExistingValue) }}
            {{ $parentExistingValue = sdict $parentExistingValue }}
        {{ end }}
        {{ $existingValue = $parentExistingValue }}
        {{ $found = true }}
        {{ $key = $firstSubkey }}
        {{- range $subkey := slice $keyArray 1 -}}
            {{ $key = joinStr " > " $key $subkey }}
            {{ if and $found (eq "map" (kindOf $existingValue true)) }}
                {{ $lastParentExistingValue = $existingValue }}
                {{ $parentFound = true }}
                {{ $found = $existingValue.HasKey $subkey }}
                {{ $existingValue = $existingValue.Get $subkey }}
                {{/* plain map inside stored JSON: promote to sdict in its parent */}}
                {{ if eq $plainMapType (printf "%T" $existingValue) }}
                    {{ $existingValue = sdict $existingValue }}
                    {{ $_ := $lastParentExistingValue.Set $subkey $existingValue }}
                {{ end }}
            {{ else }}
                {{ $found = false }}
                {{ $parentFound = false }}
                {{ $existingValue = "" }}
            {{ end }}
        {{- end -}}
    {{ else }}
        {{ with dbGet $userID $key }}
            {{ $found = true }}
            {{ $existingValue = .Value }}
            {{ if eq $plainMapType (printf "%T" $existingValue) }}
                {{ $existingValue = sdict $existingValue }}
            {{ end }}
        {{ end }}
    {{ end }}
    {{ $existingType := printf "%T" $existingValue }}
    {{ $errorText := "" }}

    {{ $ptAction := "" }}
    {{ if $isDump }}
        {{/* one rule everywhere now: staff default row 0, staff `user` = that row,
            others own — dump needs no special case anymore */}}
        {{ $dumpUserID := $userID }}
        {{ $dumpData := sdict }}
        {{ if and $key (ne $key "all") }}
            {{/* Dump specific key only */}}
            {{ $entry := dbGet $dumpUserID $key }}
            {{ if and $entry $entry.Value }}
                {{ $_ := $dumpData.Set $key $entry.Value }}
            {{ end }}
        {{ else }}
            {{/* build from dbGetPattern's own entries (1 interaction, 100/call max);
                rationale in retired/db.gohtml's copy of this loop */}}
            {{- range $entry := dbGetPattern $dumpUserID "%" 100 0 -}}
                {{- if $entry.Value -}}
                    {{- $_ := $dumpData.Set $entry.Key $entry.Value -}}
                {{- end -}}
            {{- end -}}
        {{ end }}
        {{ $ptAction = "dumped" }}
        {{ $displayUserID = $dumpUserID }}
        {{ $jsonData := json $dumpData true }}
        {{ $filename := joinStr "" "db_dump_" (toString $dumpUserID) "_" (currentTime.Unix) }}
        {{ if $isSlash }}
            {{/* the summary rides beside the file, like channel_activity's CSV */}}
            {{ sendResponse nil (complexMessage
                "content" (joinStr "" "Exported " (len $dumpData) " entries to file")
                "file" $jsonData
                "filename" $filename
                "ephemeral" true
            ) }}
        {{ else }}
            {{ sendMessage nil (complexMessage "file" $jsonData "filename" $filename) }}
        {{ end }}
        {{ $value = joinStr "" "Exported " (len $dumpData) " entries to file" }}
    {{ else if $isKeys }}
        {{ if eq "map" (kindOf $existingValue true) }}
            {{ $ptAction = "inspected" }}
            {{ $value = cslice }}
            {{- range $k, $v := $existingValue -}}
                {{- $value = $value.Append $k -}}
            {{- end -}}
        {{ else }}
            {{ $errorText = "No dictionary found for the given key!" }}
        {{ end }}
    {{ else if or $isDelete $isGet }}
        {{ if $found }}
            {{ $value = $existingValue }}
            {{ if $isDelete }}
                {{ $ptAction = "deleted" }}
                {{ if ge (len $keyArray) 2 }}
                    {{ $_ := $lastParentExistingValue.Del $lastSubkey }}
                    {{ dbSet $userID $firstSubkey $parentExistingValue }}
                {{ else }}
                    {{ dbDel $userID $key }}
                {{ end }}
            {{ else if $isGet }}
                {{ $ptAction = "retrieved" }}
            {{ end }}
        {{ else }}
            {{ $errorText = "No value found!" }}
        {{ end }}
    {{ else if or $isAdd $isRemove }}
        {{ try }}
            {{ $parsedValue := $value }}
            {{ if eq $stringType $valueType }}
                {{ if and (gt (len $value) 0) (eq "{" (index $value 0 | printf "%c")) }}
                    {{ $parsedValue = jsonToSdict $value }}
                {{ end }}
            {{ end }}
            {{ if $isAdd }}
                {{ $ptAction = "added" }}
            {{ else }}
                {{ $ptAction = "removed" }}
            {{ end }}
            {{ $existingIsSlice := and $found (eq "slice" (kindOf $existingValue true)) }}
            {{ $existingIsDict := and $found (eq "map" (kindOf $existingValue true)) }}
            {{ $parsedIsDict := eq "map" (kindOf $parsedValue true) }}
            {{ if and $existingIsSlice $isAdd }}
                {{ $newSlice := cslice }}
                {{ range $item := $existingValue }}
                    {{ $newSlice = $newSlice.Append $item }}
                {{ end }}
                {{ $newSlice = $newSlice.Append $parsedValue }}
                {{ $existingValue = $newSlice }}
                {{ if ge (len $keyArray) 2 }}
                    {{ $_ := $lastParentExistingValue.Set $lastSubkey $existingValue }}
                    {{ dbSet $userID $firstSubkey $parentExistingValue }}
                {{ else }}
                    {{ dbSet $userID $key $existingValue }}
                {{ end }}
                {{ $value = $parsedValue }}
            {{ else if and $existingIsSlice $isRemove }}
                {{ $newSlice := cslice }}
                {{ $removed := false }}
                {{ range $item := $existingValue }}
                    {{ if and (not $removed) (eq (str $item) (str $parsedValue)) }}
                        {{ $removed = true }}
                    {{ else }}
                        {{ $newSlice = $newSlice.Append $item }}
                    {{ end }}
                {{ end }}
                {{ if $removed }}
                    {{ $existingValue = $newSlice }}
                    {{ if ge (len $keyArray) 2 }}
                        {{ $_ := $lastParentExistingValue.Set $lastSubkey $existingValue }}
                        {{ dbSet $userID $firstSubkey $parentExistingValue }}
                    {{ else }}
                        {{ dbSet $userID $key $existingValue }}
                    {{ end }}
                    {{ $value = $parsedValue }}
                {{ else }}
                    {{ $errorText = "No value found!" }}
                {{ end }}
            {{ else if and $existingIsDict $parsedIsDict }}
                {{/* Dict operations: add/remove keys of the target dictionary */}}
                {{ $value = $parsedValue }}
                {{ $removedAny := false }}
                {{- range $k, $v := $value -}}
                    {{- if $isAdd -}}
                        {{- $existingAtK := $existingValue.Get $k -}}
                        {{- if and (eq "slice" (kindOf $existingAtK true)) (eq "slice" (kindOf $v true)) -}}
                            {{- /* both slices: append to a cslice copy (plain ones lack Append) */ -}}
                            {{- $newSlice := cslice -}}
                            {{- range $item := $existingAtK -}}
                                {{- $newSlice = $newSlice.Append $item -}}
                            {{- end -}}
                            {{- range $item := $v -}}
                                {{- $newSlice = $newSlice.Append $item -}}
                            {{- end -}}
                            {{- $_ := $existingValue.Set $k $newSlice -}}
                        {{- else -}}
                            {{- $_ := $existingValue.Set $k $v -}}
                        {{- end -}}
                    {{- else if $existingValue.HasKey $k -}}
                        {{- $_ := $value.Set $k ($existingValue.Get $k) -}}
                        {{- $_ := $existingValue.Del $k -}}
                        {{- $removedAny = true -}}
                    {{- else -}}
                        {{- $_ := $value.Del $k -}}
                    {{- end -}}
                {{- end -}}

                {{ if or $isAdd $removedAny }}
                    {{ if ge (len $keyArray) 2 }}
                        {{ dbSet $userID $firstSubkey $parentExistingValue }}
                    {{ else }}
                        {{ dbSet $userID $key $existingValue }}
                    {{ end }}
                {{ else }}
                    {{ $errorText = "No value found!" }}
                {{ end }}
            {{ else if $existingIsDict }}
                {{ $errorText = $invalidValueText }}
            {{ else }}
                {{ $errorText = "No array or dictionary found for the given key!" }}
            {{ end }}
        {{ catch }}
            {{ $errorText = $invalidValueText }}
        {{ end }}
    {{ else if and (ge (len $keyArray) 2) (not $parentFound) }}
        {{ $errorText = "No dictionary found for the given key!" }}
    {{ else }}
        {{ try }}
            {{ if eq $stringType $valueType }}
                {{ $value = jsonToSdict $value }}
            {{ end }}
            {{ $ptAction = "set" }}
            {{ if ge (len $keyArray) 2 }}
                {{ $_ := $lastParentExistingValue.Set $lastSubkey $value }}
                {{ dbSet $userID $firstSubkey $parentExistingValue }}
            {{ else }}
                {{ dbSet $userID $key $value }}
            {{ end }}
        {{ catch }}
            {{ $errorText = $invalidValueText }}
        {{ end }}
    {{ end }}

    {{ $valueType = printf "%T" $value }}

    {{ if $errorText }}
        {{ $resultEmoji = "⚠️" }}
        {{ $resultText = $errorText }}
        {{ $value = "" }}
    {{ else }}
        {{- /* format the value for user-friendly viewing */ -}}
        {{ if and (eq $stringType $valueType) (not $value) }}
            {{ $value = "\"\"" }}
        {{ else if ne $stringType $valueType }}
            {{ try }}
                {{ $value = json $value true }}
            {{ catch }}
                {{ $value = joinStr "" "(unable to render type " $valueType ")" }}
            {{ end }}
        {{ end }}
        {{ $resultText = joinStr "" "Value successfully " $ptAction "!" }}
        {{/* nothing to delete on the slash path; ExecData keeps deleteTrigger */}}
        {{ if not $isSlash }}
            {{ deleteTrigger $deleteTriggerDelay }}
        {{ end }}
    {{ end }}
{{ else }}
    {{ $resultEmoji = "⚠️" }}
    {{ if not $operationCheck }}
        {{ $resultText = joinStr "" "Invalid operation provided: " (or $operation $nil) "" }}
    {{ else if not $key }}
        {{ $resultText = "You must provide a key!" }}
    {{ else if not $valueCheck }}
        {{ $resultText = "You must provide a value!" }}
    {{ end }}
{{ end }}

{{ $resultText = joinStr " " $resultEmoji $resultText }}

{{/* the description keeps up to 4096 characters (Discord's limit): leave room
  for the code fence (8) and the "…" */}}
{{ $embedDescriptionLimit := sub 4096 9 }}
{{ if gt (len (toRune $value)) $embedDescriptionLimit }}
    {{ $value = joinStr "" (slice (split $value "") 0 $embedDescriptionLimit) "…" }}
{{ end }}

{{/* the Key field holds 1024: cut the key before fencing (fence 7, "…" 1) */}}
{{ $keyShown := or $key $nil }}
{{ if gt (len (toRune $keyShown)) 1017 }}
    {{ $keyShown = joinStr "" (slice (split $keyShown "") 0 1016) "…" }}
{{ end }}

{{ if $isSlash }}
    {{/* export answered with the file already; others reply with the embed */}}
    {{ if not $isDump }}
        {{ $title = joinStr "" "Database Operation: `" $subcommand "`" }}
        {{ $embed := cembed
            "title" $title
            "color" $embedColor
            "description" (joinStr "" "```\n" (or $value $nil) "\n```")
            "fields" (cslice
                (sdict "name" "User ID" "value" (joinStr "" "```\n" $displayUserID "```") "inline" true)
                (sdict "name" "Key" "value" (joinStr "" "```\n" $keyShown "```") "inline" true)
                (sdict "name" "Result" "value" (joinStr "" "```\n" $resultText "```") "inline" false)
            )
        }}
        {{ sendResponse nil (complexMessage "ephemeral" true "embed" $embed) }}
    {{ end }}
{{ else if $isExec }}
    {{ if not (and $isExec .ExecData.Title) }}
        {{ $title = joinStr "" "Database Operation: `" $operation "`" }}
    {{ end }}

    {{ execCC $embed_exec $yagpdbChannelID 0 (sdict
        "ChannelID" (or .ExecData.ChannelID .Channel.ID)
        "Title" $title
        "Description" (joinStr "" "```\n" (or $value $nil) "\n```")
        "AuthorID" $displayUserID
        "Fields" (cslice
            (sdict "name" "User ID" "value" (joinStr "" "```\n" $displayUserID "```") "inline" true)
            (sdict "name" "Key" "value" (joinStr "" "```\n" $keyShown "```") "inline" true)
            (sdict "name" "Result" "value" (joinStr "" "```\n" $resultText "```") "inline" false)
        )
    ) }}
{{ else }}
Use /db as a slash command: view · browse · set · add · remove · delete · export
{{ end }}
