{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `simple_db_edit`
  Group: `Staff Utility`
  Dependencies: `embed_exec`
*/ -}}

{{ $args := parseArgs 3
    (joinStr ""
        "Usage: `[Category]` `[Key]` `[Value]`\n\n"
        "The category is the section of the database that you want to update (e.g. \"Admin\" or \"Knowledge\"), "
        "the key is the name of the entry to edit, and the value is the text that goes with it.\n\n"
        "Prefix the category with `new:` (e.g. `new:Widgets`) to create it if it doesn't exist yet.\n\n"
        "In order to __delete__ an entry, please use `(nil)` for the value."
    )
    (carg "string" "category")
    (carg "string" "key")
    (carg "string" "value")
}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $plainMapType := "map[string]interface {}" }}
{{ $stringType := "string" }}

{{ $categoryArg := $args.Get 0 }}
{{ $isNew := reFind "(?i)\\Anew:" $categoryArg }}
{{ $categoryName := $categoryArg }}
{{ if $isNew }}
    {{ $categoryName = trimSpace (reReplace "(?i)\\Anew:" $categoryArg "") }}
{{ end }}
{{ $category := title $categoryName }}

{{ $title := "" }}
{{ $description := "" }}
{{ $fields := cslice }}
{{ $refused := false }}

{{ if and $isNew (not $categoryName) }}
    {{ $refused = true }}
    {{ $title = "Missing category name" }}
    {{ $description = "⚠️ Give a category name after `new:`." }}
{{ end }}

{{ $categoryEntry := "" }}
{{ if not $refused }}
    {{ $categoryEntry = dbGet 0 $category }}
    {{ if and (not $isNew) (not $categoryEntry) }}
        {{ $refused = true }}
        {{ $title = "Unknown category" }}
        {{ $description = joinStr "" "⚠️ There is no `" $category "` category. Check the spelling, or use `new:" $category "` to create it." }}
    {{ end }}
{{ end }}

{{ if not $refused }}
    {{ $categoryDict := sdict }}
    {{ if $categoryEntry }}
        {{ $categoryValue := $categoryEntry.Value }}
        {{ if eq $plainMapType (printf "%T" $categoryValue) }}
            {{ $categoryDict = sdict $categoryValue }}
        {{ else if eq "map" (kindOf $categoryValue true) }}
            {{ $categoryDict = $categoryValue }}
        {{ else }}
            {{ $refused = true }}
            {{ $title = "Not a dictionary" }}
            {{ $description = joinStr "" "⚠️ The `" $category "` category doesn't hold a dictionary of entries." }}
        {{ end }}
    {{ end }}

    {{ if not $refused }}
        {{ $typedKey := $args.Get 1 }}
        {{ $key := $typedKey }}
        {{ if ne $category "Commands" }}
            {{ $key = title $typedKey }}
        {{ end }}
        {{ $storedKeyDiffers := ne $key $typedKey }}

        {{ $value := $args.Get 2 }}
        {{ $isDelete := eq $value "(nil)" }}

        {{ $found := $categoryDict.HasKey $key }}
        {{ $old := "" }}
        {{ if $found }}
            {{ $old = $categoryDict.Get $key }}
        {{ end }}
        {{ $oldIsString := eq $stringType (printf "%T" $old) }}
        {{/* "and" isn't short-circuiting in Go templates: eq $old $value would still run
          (and error) on a non-comparable $old if inlined into one "and" condition */}}
        {{ $isUnchanged := false }}
        {{ if $oldIsString }}
            {{ $isUnchanged = eq $old $value }}
        {{ end }}

        {{ $label := joinStr " › " $category $key }}

        {{ $storedAs := $key }}
        {{ if gt (len (toRune $storedAs)) 1024 }}
            {{ $kept := slice (split $storedAs "") 0 1023 }}
            {{ $storedAs = joinStr "" $kept "…" }}
        {{ end }}

        {{ if $isDelete }}
            {{ if $found }}
                {{ $categoryDict.Del $key }}
                {{ dbSet 0 $category $categoryDict }}
                {{ $title = joinStr " " $label "removed" }}
                {{ if $oldIsString }}
                    {{ $description = $old }}
                {{ else }}
                    {{/* cut the json first, then fence: fencing after a truncation drops
                      the closing fence and breaks the embed's markdown */}}
                    {{ $oldJSON := json $old true }}
                    {{ $oldJSONMax := sub 4096 8 }}
                    {{ if gt (len (toRune $oldJSON)) $oldJSONMax }}
                        {{ $kept := slice (split $oldJSON "") 0 (sub $oldJSONMax 1) }}
                        {{ $oldJSON = joinStr "" $kept "…" }}
                    {{ end }}
                    {{ $description = joinStr "" "```\n" $oldJSON "\n```" }}
                {{ end }}
            {{ else }}
                {{ $title = joinStr " " $label "not found" }}
                {{ $description = joinStr "" "⚠️ There is no `" $key "` entry in `" $category "` to remove." }}
            {{ end }}
        {{ else if not $found }}
            {{ $categoryDict.Set $key $value }}
            {{ dbSet 0 $category $categoryDict }}
            {{ $title = joinStr " " $label "added" }}
            {{ $description = $value }}
            {{ if $storedKeyDiffers }}
                {{ $fields = $fields.Append (sdict "name" "Stored as" "value" $storedAs) }}
            {{ end }}
        {{ else if $isUnchanged }}
            {{ $title = joinStr " " $label "unchanged" }}
            {{ $description = $value }}
            {{ if $storedKeyDiffers }}
                {{ $fields = $fields.Append (sdict "name" "Stored as" "value" $storedAs) }}
            {{ end }}
        {{ else }}
            {{ $categoryDict.Set $key $value }}
            {{ dbSet 0 $category $categoryDict }}
            {{ $title = joinStr " " $label "updated" }}
            {{ $description = $value }}
            {{ $was := $old }}
            {{ if $oldIsString }}
                {{ if gt (len (toRune $was)) 1024 }}
                    {{ $kept := slice (split $was "") 0 1023 }}
                    {{ $was = joinStr "" $kept "…" }}
                {{ end }}
            {{ else }}
                {{/* cut the json first, then fence: fencing after a truncation drops
                  the closing fence and breaks the embed's markdown */}}
                {{ $wasJSON := json $was true }}
                {{ $wasJSONMax := sub 1024 8 }}
                {{ if gt (len (toRune $wasJSON)) $wasJSONMax }}
                    {{ $kept := slice (split $wasJSON "") 0 (sub $wasJSONMax 1) }}
                    {{ $wasJSON = joinStr "" $kept "…" }}
                {{ end }}
                {{ $was = joinStr "" "```\n" $wasJSON "\n```" }}
            {{ end }}
            {{ $fields = $fields.Append (sdict "name" "Was" "value" $was) }}
            {{ if $storedKeyDiffers }}
                {{ $fields = $fields.Append (sdict "name" "Stored as" "value" $storedAs) }}
            {{ end }}
        {{ end }}
    {{ end }}
{{ end }}

{{ execCC $embed_exec $yagpdbChannelID 0 (sdict
    "ChannelID" .Channel.ID
    "Title" $title
    "Description" $description
    "Fields" $fields
) }}

{{ deleteTrigger $deleteTriggerDelay }}
