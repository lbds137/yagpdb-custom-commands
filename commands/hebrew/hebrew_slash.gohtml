{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `hebrew`
  Group: `Utility`
  Slash description: `Hebrew tools`
  Defer mode: `None`
  Dependencies: `gematria`

  The slash version of atbash, alefbet, pyramid and rand_hebrew, one root with four
  subcommands. The logic and dictionaries are inlined from them. A result (public) is ONE
  execCC to gematria with `Respond`: the child inherits the interaction and answers it, so
  this run prints nothing on that path (an empty run sends no response). Errors and usage
  refusals are ephemeral sendResponses of this run, never alongside the execCC.

  A pyramid of several words answers the interaction itself FIRST (a public message with
  the word count, plus the skipped-words warning), then schedules one delayed run of this
  command per word (ExecData `Description`, `AuthorID`, `ChannelID`; the Commands key
  `hebrew_slash`). The stored interaction was responded to by then, so each delayed run's
  embed is a followup. A delayed run restores `.Interaction` but not `.IsSlashCommand`,
  `.SubCommand` or `.Options`, so the ExecData is checked before them.

  Slash subcommand: `atbash atbash cipher of Hebrew, Greek, Arabic, Latin, runes and digits`
  Slash option: `atbash.text string! the text to encipher`
  Slash subcommand: `alefbet Paleo-Hebrew and Arabic letters converted to Hebrew`
  Slash option: `alefbet.text string! the text to convert`
  Slash subcommand: `pyramid gematria of a word's pyramid, one embed per word`
  Slash option: `pyramid.text string! one or more words`
  Slash subcommand: `random random Hebrew letters, with their gematria`
  Slash option: `random.letters integer! letters per group`
  Slash option: `random.groups integer how many groups (default 1)`
*/ -}}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $gematria := toInt ($commandsDict.Get "gematria") }}
{{ $hebrewSlash := toInt ($commandsDict.Get "hebrew_slash") }}
{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $gematriaDict := (dbGet 0 "Gematria").Value }}
{{ $sofitDict := $gematriaDict.Get "Final Letters" }}
{{/* the pyramid's per-word delayed execCCs are clamped to YAGPDB's 10-per-run premium
	cap, as pyramid.gohtml clamps them */}}
{{ $execCCLimit := toInt (min (toInt ($globalDict.Get "ExecCC Limit")) 10) }}

{{/* a delayed run (a pyramid word scheduled below) is told by its ExecData, which comes
	before .IsSlashCommand: handle_timed.go restores .Interaction but not the handler's keys */}}
{{ $delayedWord := .ExecData.Description }}
{{ $subcommand := "" }}
{{ if $delayedWord }}
	{{ $subcommand = "pyramid" }}
{{ else if .IsSlashCommand }}
	{{ $subcommand = .SubCommand }}
{{ end }}

{{ $userID := or .ExecData.AuthorID .User.ID }}
{{ $channelID := or .ExecData.ChannelID .Channel.ID }}
{{ $refusal := "" }}
{{ $result := sdict }}

{{ if eq $subcommand "atbash" }}
	{{ $text := .Options.text }}

{{- $atbashDict := sdict
  "0" "9" "1" "8" "2" "7" "3" "6" "4" "5" "5" "4" "6" "3" "7" "2" "8" "1" "9" "0"
  "א" "ת" "ב" "ש" "ג" "ר" "ד" "ק" "ה" "צ" "ו" "פ" "ז" "ע" "ח" "ס" "ט" "נ"
  "י" "מ" "כ" "ל" "ל" "כ" "מ" "י" "נ" "ט" "ס" "ח" "ע" "ז" "פ" "ו" "צ" "ה"
  "ק" "ד" "ר" "ג" "ש" "ב" "ת" "א" "ך" "ל" "ם" "י" "ן" "ט" "ף" "ו" "ץ" "ה"
  "𐤀" "𐤕" "𐤁" "𐤔" "𐤂" "𐤓" "𐤃" "𐤒" "𐤄" "𐤑" "𐤅" "𐤐" "𐤆" "𐤏" "𐤇" "𐤎" "𐤈" "𐤍"
  "𐤉" "𐤌" "𐤊" "𐤋" "𐤋" "𐤊" "𐤌" "𐤉" "𐤍" "𐤈" "𐤎" "𐤇" "𐤏" "𐤆" "𐤐" "𐤅" "𐤑" "𐤄"
  "𐤒" "𐤃" "𐤓" "𐤂" "𐤔" "𐤁" "𐤕" "𐤀"
  "Α" "Ω" "Β" "Ψ" "Γ" "Χ" "Δ" "Φ" "Ε" "Υ" "Ϝ" "Ϡ" "Ϛ" "Ϙ" "Ζ" "Τ" "Η" "Σ" "Θ" "Ρ"
  "Ι" "Π" "Κ" "Ο" "Λ" "Ξ" "Μ" "Ν" "Ν" "Μ" "Ξ" "Λ" "Ο" "Κ" "Π" "Ι" "Ϙ" "Ϛ"
  "Ρ" "Θ" "Σ" "Η" "Τ" "Ζ" "Υ" "Ε" "Φ" "Δ" "Χ" "Γ" "Ψ" "Β" "Ω" "Α" "Ϡ" "Ϝ"
  "ᾼ" "Ω" "Ά" "Ω" "Ὰ" "Ω" "Ἀ" "Ω" "ᾈ" "Ω" "Ἄ" "Ω" "ᾌ" "Ω" "Ἂ" "Ω" "ᾊ" "Ω" "Ἆ" "Ω"
  "ᾎ" "Ω" "Ἁ" "Ω" "ᾉ" "Ω" "Ἅ" "Ω" "ᾍ" "Ω" "Ἃ" "Ω" "ᾋ" "Ω" "Ἇ" "Ω" "ᾏ" "Ω" "Ᾱ" "Ω"
  "Ᾰ" "Ω" "Έ" "Υ" "Ὲ" "Υ" "Ἐ" "Υ" "Ἔ" "Υ" "Ἒ" "Υ" "Ἑ" "Υ" "Ἕ" "Υ" "Ἓ" "Υ" "ῌ" "Υ"
  "Ή" "Σ" "Ὴ" "Σ" "Ἠ" "Σ" "ᾘ" "Σ" "Ἤ" "Σ" "ᾜ" "Σ" "Ἢ" "Σ" "ᾚ" "Σ" "Ἦ" "Σ" "ᾞ" "Σ"
  "Ἡ" "Σ" "ᾙ" "Σ" "Ἥ" "Σ" "ᾝ" "Σ" "Ἣ" "Σ" "ᾛ" "Σ" "Ἧ" "Σ" "ᾟ" "Σ"
  "Ί" "Π" "Ὶ" "Π" "Ἰ" "Π" "Ἴ" "Π" "Ἲ" "Π" "Ἶ" "Π" "Ἱ" "Π" "Ἵ" "Π" "Ἳ" "Π" "Ἷ" "Π"
  "Ϊ" "Π" "Ῑ" "Π" "Ῐ" "Π" "Ό" "Κ" "Ὸ" "Κ" "Ὀ" "Κ" "Ὄ" "Κ" "Ὂ" "Κ" "Ὁ" "Κ" "Ὅ" "Κ"
  "Ὃ" "Κ"
  "Ῥ" "Θ" "Ύ" "Ε" "Ὺ" "Ε" "Ὑ" "Ε" "Ὕ" "Ε" "Ὓ" "Ε" "Ὗ" "Ε" "Ϋ" "Ε" "Ῡ" "Ε" "Ῠ" "Ε"
  "Ώ" "Α" "Ὼ" "Α" "Ὠ" "Α" "ᾨ" "Α" "Ὤ" "Α" "ᾬ" "Α" "Ὢ" "Α" "ᾪ" "Α" "Ὦ" "Α" "ᾮ" "Α"
  "Ὡ" "Α" "ᾩ" "Α" "Ὥ" "Α" "ᾭ" "Α" "Ὣ" "Α" "ᾫ" "Α" "Ὧ" "Α" "ᾯ" "Α"
  "α" "ω" "β" "ψ" "γ" "χ" "δ" "φ" "ε" "υ" "ϝ" "ϡ" "ϛ" "ϙ" "ζ" "τ" "η" "σ" "θ" "ρ"
  "ι" "π" "κ" "ο" "λ" "ξ" "μ" "ν" "ν" "μ" "ξ" "λ" "ο" "κ" "π" "ι" "ϙ" "ϛ"
  "ρ" "θ" "σ" "η" "ς" "η" "τ" "ζ" "υ" "ε" "φ" "δ" "χ" "γ" "ψ" "β" "ω" "α" "ϡ" "ϝ"
  "ᾳ" "ω" "ά" "ω" "ᾴ" "ω" "ὰ" "ω" "ᾲ" "ω" "ᾶ" "ω" "ᾷ" "ω" "ἀ" "ω" "ᾀ" "ω" "ἄ" "ω"
  "ᾄ" "ω" "ἂ" "ω" "ᾂ" "ω" "ἆ" "ω" "ᾆ" "ω" "ἁ" "ω" "ᾁ" "ω" "ἅ" "ω" "ᾅ" "ω" "ἃ" "ω"
  "ᾃ" "ω" "ἇ" "ω" "ᾇ" "ω" "ᾱ" "ω" "ᾰ" "ω" "έ" "υ" "ὲ" "υ" "ἐ" "υ" "ἔ" "υ" "ἒ" "υ"
  "ἑ" "υ" "ἕ" "υ" "ἓ" "υ" "ῃ" "σ" "ή" "σ" "ῄ" "σ" "ὴ" "σ" "ῂ" "σ" "ῆ" "σ" "ῇ" "σ"
  "ἠ" "σ" "ᾐ" "σ" "ἤ" "σ" "ᾔ" "σ" "ἢ" "σ" "ᾒ" "σ" "ἦ" "σ" "ᾖ" "σ" "ἡ" "σ" "ᾑ" "σ"
  "ἥ" "σ" "ᾕ" "σ" "ἣ" "σ" "ᾓ" "σ" "ἧ" "σ" "ᾗ" "σ"
  "ί" "π" "ὶ" "π" "ῖ" "π" "ἰ" "π" "ἴ" "π" "ἲ" "π" "ἶ" "π" "ἱ" "π" "ἵ" "π" "ἳ" "π"
  "ἷ" "π" "ϊ" "π" "ΐ" "π" "ῒ" "π" "ῗ" "π" "ῑ" "π" "ῐ" "π" "ό" "κ" "ὸ" "κ" "ὀ" "κ"
  "ὄ" "κ" "ὂ" "κ" "ὁ" "κ" "ὅ" "κ" "ὃ" "κ"
  "ῤ" "θ" "ῥ" "θ" "ύ" "ε" "ὺ" "ε" "ῦ" "ε" "ὐ" "ε" "ὔ" "ε" "ὒ" "ε" "ὖ" "ε" "ὑ" "ε"
  "ὕ" "ε" "ὓ" "ε" "ὗ" "ε" "ϋ" "ε" "ΰ" "ε" "ῢ" "ε" "ῧ" "ε" "ῡ" "ε" "ῠ" "ε" "ῳ" "α"
  "ώ" "α" "ῴ" "α" "ὼ" "α" "ῲ" "α" "ῶ" "α" "ῷ" "α" "ὠ" "α" "ᾠ" "α" "ὤ" "α" "ᾤ" "α"
  "ὢ" "α" "ᾢ" "α" "ὦ" "α" "ᾦ" "α" "ὡ" "α" "ᾡ" "α" "ὥ" "α" "ᾥ" "α" "ὣ" "α" "ᾣ" "α"
  "ὧ" "α" "ᾧ" "α"
  "ا" "غ" "ب" "ظ" "ج" "ض" "د" "ذ" "ه" "خ" "ة" "خ" "و" "ث" "ز" "ت" "ح" "ش" "ط" "ر"
  "ي" "ق" "ك" "ص" "ل" "ف" "م" "ع" "ن" "س" "س" "ن" "ع" "م" "ف" "ل" "ص" "ك"
  "ق" "ي" "ر" "ط" "ش" "ح" "ت" "ز" "ث" "و" "خ" "ه" "ذ" "د" "ض" "ج" "ظ" "ب"
  "غ" "ا"
  "ى" "غ" "آ" "غ" "أ" "غ" "إ" "غ" "پ" "ظ" "چ" "ض" "ؤ" "ث" "ژ" "ت"
  "ئ" "ق" "گ" "ص"
  "A" "Z" "B" "Y" "C" "X" "D" "W" "E" "V" "F" "U" "G" "T" "H" "S" "I" "R"
  "K" "P" "L" "O" "M" "N" "N" "M" "O" "L" "P" "K" "Q" "J" "R" "I" "S" "H"
  "T" "G" "U" "F" "X" "C" "Y" "B" "Z" "A" "J" "Q" "V" "E" "W" "D"
  "a" "z" "b" "y" "c" "x" "d" "w" "e" "v" "f" "u" "g" "t" "h" "s" "i" "r"
  "k" "p" "l" "o" "m" "n" "n" "m" "o" "l" "p" "k" "q" "j" "r" "i" "s" "h"
  "t" "g" "u" "f" "x" "c" "y" "b" "z" "a" "j" "q" "v" "e" "w" "d"
  "Ă" "Z" "Â" "Z" "À" "Z" "Â" "Z" "Ç" "X" "É" "V" "È" "V" "Ê" "V" "Ë" "V" "Æ" "ZV"
  "Î" "R" "Ï" "R"
  "Ñ" "M" "Ô" "L" "Œ" "LV" "Ș" "H"
  "Ț" "G" "Ù" "F" "Û" "F" "Ü" "F" "Ÿ" "B"
  "ă" "z" "â" "z" "à" "z" "â" "z" "ç" "x" "é" "v" "è" "v" "ê" "v" "ë" "v" "æ" "zv"
  "î" "r" "ï" "r"
  "ñ" "m" "ô" "l" "œ" "lv" "ș" "h"
  "ț" "g" "ù" "f" "û" "f" "ü" "f" "ÿ" "b"
  "ᚠ" "ᛟ" "ᚢ" "ᛞ" "ᚦ" "ᛜ" "ᚨ" "ᛚ" "ᚱ" "ᛗ" "ᚲ" "ᛖ" "ᚷ" "ᛒ" "ᚹ" "ᛏ" "ᚺ" "ᛊ"
  "ᚾ" "ᛉ" "ᛁ" "ᛈ" "ᛃ" "ᛇ" "ᛇ" "ᛃ" "ᛈ" "ᛁ" "ᛉ" "ᚾ" "ᛊ" "ᚺ" "ᛏ" "ᚹ" "ᛒ" "ᚷ"
  "ᛖ" "ᚲ" "ᛗ" "ᚱ" "ᛚ" "ᚨ" "ᛜ" "ᚦ" "ᛞ" "ᚢ" "ᛟ" "ᚠ"
  "ᚡ" "ᛟ" "ᚣ" "ᛞ" "ᚤ" "ᛞ" "ᚥ" "ᛞ" "ᚧ" "ᛜ" "ᚩ" "ᛚ" "ᚪ" "ᛚ" "ᚫ" "ᛚ" "ᚬ" "ᛚ" "ᚭ" "ᛚ"
  "ᚮ" "ᛚ" "ᚯ" "ᛚ" "ᚰ" "ᛚ" "ᚳ" "ᛖ" "ᚴ" "ᛖ" "ᚵ" "ᛖ" "ᚶ" "ᛖ" "ᚸ" "ᛒ" "ᚻ" "ᛊ" "ᚼ" "ᛊ"
  "ᚽ" "ᛊ" "ᚿ" "ᛉ" "ᛀ" "ᛉ" "ᛂ" "ᛈ" "ᛄ" "ᛇ" "ᛅ" "ᛇ" "ᛆ" "ᛇ" "ᛡ" "ᛇ" "ᛦ" "ᚾ" "ᛧ" "ᚾ"
  "ᛨ" "ᚾ" "ᛋ" "ᚺ" "ᛌ" "ᚺ" "ᛍ" "ᚺ" "ᛎ" "ᚺ" "ᛐ" "ᚹ" "ᛑ" "ᚹ" "ᛠ" "ᚹ" "ᛓ" "ᚷ" "ᛔ" "ᚷ"
  "ᛕ" "ᚷ" "ᛘ" "ᚱ" "ᛙ" "ᚱ" "ᛛ" "ᚨ" "ᛝ" "ᚦ" -}}


	{{- $atbashString := "" -}}
	{{- $hasMappedChar := false -}}
	{{- $words := reSplit "[[:space:]]+" $text -}}
	{{- $spaces := reSplit "[^[:space:]]+" $text -}}
	{{- range $i, $word := $words -}}
		{{- $atbashWord := "" -}}
		{{- $wordChars := split $word "" -}}
		{{- $wordLength := len $wordChars -}}
		{{- range $j, $char := $wordChars -}}
			{{- $atbashLetter := index $atbashDict $char -}}
			{{- if $atbashLetter -}}
				{{- $hasMappedChar = true -}}
				{{- if and (gt $wordLength 1) (eq $j (sub $wordLength 1)) -}}
					{{- $sofitLetter := index $sofitDict $atbashLetter -}}
					{{- if $sofitLetter -}}
						{{- $atbashLetter = $sofitLetter -}}
					{{- end -}}
				{{- end -}}
			{{- else -}}
				{{- $atbashLetter = $char -}}
			{{- end -}}
			{{- $atbashWord = joinStr "" $atbashWord $atbashLetter -}}
		{{- end -}}
		{{- $atbashString = joinStr (index $spaces $i) $atbashString $atbashWord -}}
	{{- end -}}

	{{ if $hasMappedChar }}
		{{ $result.Set "Title" "Atbash Ciphertext" }}
		{{ $result.Set "Description" $atbashString }}
		{{ $result.Set "Fields" (cslice (sdict "name" "Plaintext" "value" $text "inline" false)) }}
	{{ else }}
		{{ $refusal = joinStr "" "⚠️ There was nothing to encipher: atbash supports Hebrew, "
			"Paleo-Hebrew, Greek, Arabic, Latin, runes, and digits. Please try again." }}
	{{ end }}
{{ else if eq $subcommand "alefbet" }}
	{{ $text := .Options.text }}

{{- $dAlefbet := sdict
  "𐤀" "א" "𐤁" "ב" "𐤂" "ג" "𐤃" "ד" "𐤄" "ה" "𐤅" "ו" "𐤆" "ז" "𐤇" "ח" "𐤈" "ט"
  "𐤉" "י" "𐤊" "כ" "𐤋" "ל" "𐤌" "מ" "𐤍" "נ" "𐤎" "ס" "𐤏" "ע" "𐤐" "פ" "𐤑" "צ"
  "𐤒" "ק" "𐤓" "ר" "𐤔" "ש" "𐤕" "ת"
  "ا" "א" "ب" "ב" "ج" "ג" "د" "ד" "ه" "ה" "ة" "ה" "و" "ו" "ز" "ז" "ح" "ח" "ط" "ט"
  "ي" "י" "ك" "כ" "ل" "ל" "م" "מ" "ن" "נ" "س" "ס" "ع" "ע" "ف" "פ" "ص" "צ"
  "ق" "ק" "ر" "ר" "ش" "ש" "ت" "ת" "ث" "ש" "خ" "ח" "ذ" "ז" "ض" "צ" "ظ" "צ"
  "غ" "ע"
  "ى" "א" "آ" "א" "أ" "א" "إ" "א" "پ" "ב" "چ" "ג" "ؤ" "ו" "ژ" "ז"
  "ئ" "י" "گ" "כ" -}}


	{{ $hasHebrew := false }}
	{{ $hebrewText := "" }}
	{{ $chars := split $text "" }}
	{{ $textLength := len $chars }}
	{{- range $i := seq 0 $textLength -}}
		{{- $char := index $chars $i -}}
		{{- $hebrewChar := index $dAlefbet $char -}}
		{{- if $hebrewChar -}}
			{{- $hasHebrew = true -}}
			{{- if eq $i (sub $textLength 1) -}}
				{{- $hebrewChar = index $sofitDict $hebrewChar -}}
			{{- else -}}
				{{- $nextChar := index $chars (add 1 $i) -}}
				{{- $nextHebrewChar := index $dAlefbet $nextChar -}}
				{{- if not $nextHebrewChar -}}
					{{- $hebrewChar = index $sofitDict $hebrewChar -}}
				{{- end -}}
			{{- end -}}
			{{- $hebrewText = joinStr "" $hebrewText $hebrewChar -}}
		{{- else -}}
			{{- $hebrewText = joinStr "" $hebrewText $char -}}
		{{- end -}}
	{{- end -}}

	{{ if $hasHebrew }}
		{{ $result.Set "Title" "Hebrew Converter" }}
		{{ $result.Set "Description" $hebrewText }}
		{{ $result.Set "Fields" (cslice (sdict "name" "Original Text" "value" $text "inline" false)) }}
	{{ else }}
		{{ $refusal = "⚠️ The argument provided does not contain any valid text for conversion to Hebrew. Please try again." }}
	{{ end }}
{{ else if eq $subcommand "pyramid" }}
	{{/* trimmed, so a leading or trailing space isn't an empty word */}}
	{{ $text := "" }}
	{{ if $delayedWord }}
		{{ $text = trimSpace $delayedWord }}
	{{ else }}
		{{ $text = trimSpace .Options.text }}
	{{ end }}
	{{ $valuesDict := $gematriaDict.Get "Values" }}
	{{ $words := reSplit "[[:space:]]+" $text }}
	{{ if $delayedWord }}
		{{/* a scheduled run is always one word */}}
		{{ $words = cslice $text }}
	{{ end }}
	{{ if gt (len $words) 1 }}
		{{/* answer the interaction first, so every scheduled run's stored frame is
			responded to and its embed is a followup */}}
		{{ $kept := cslice }}
		{{ $skippedCount := 0 }}
		{{- range $i, $word := $words -}}
			{{- if lt $i $execCCLimit -}}
				{{- $kept = $kept.Append $word -}}
			{{- else -}}
				{{- $skippedCount = add 1 $skippedCount -}}
			{{- end -}}
		{{- end -}}
		{{ $keptNoun := "words" }}
		{{ if eq 1 (len $kept) }}
			{{ $keptNoun = "word" }}
		{{ end }}
		{{ $lines := cslice (joinStr "" "Pyramid gematria of **" (len $kept) "** " $keptNoun
			" follows, one embed per word.") }}
		{{ if gt $skippedCount 0 }}
			{{ $subjectAndVerb := "words were" }}
			{{ if eq 1 $skippedCount }}
				{{ $subjectAndVerb = "word was" }}
			{{ end }}
			{{ $limitNoun := "words" }}
			{{ if eq 1 $execCCLimit }}
				{{ $limitNoun = "word" }}
			{{ end }}
			{{ $lines = $lines.Append (joinStr " "
				"⚠️ Warning:" $skippedCount $subjectAndVerb "not processed because only" $execCCLimit $limitNoun "can be processed at a time."
			) }}
		{{ end }}
		{{ sendResponse nil (complexMessage "content" (joinStr "\n" $lines.StringSlice)) }}
		{{- range $word := $kept -}}
			{{- execCC $hebrewSlash $channelID 1 (sdict
				"AuthorID" $userID
				"ChannelID" $channelID
				"Description" $word
			) -}}
		{{- end -}}
	{{ else }}
		{{ $pyramidString := "" }}
		{{ $prevLine := "" }}
		{{- range $letter := split (index $words 0) "" -}}
			{{- if $valuesDict.Get $letter -}}
				{{- $curLine := joinStr "" $prevLine $letter -}}
				{{- $pyramidString = joinStr "\n" $pyramidString $curLine -}}
				{{- $prevLine = $curLine -}}
			{{- end -}}
		{{- end -}}
		{{ if $pyramidString }}
			{{ $result.Set "Title" "Pyramid Gematria" }}
			{{ $result.Set "Description" $pyramidString }}
			{{ $result.Set "Fields" (cslice (sdict "name" "Word" "value" $text "inline" false)) }}
		{{ else }}
			{{ $refusal = "⚠️ That word has no letters with a gematria value, so there is no pyramid to build." }}
		{{ end }}
	{{ end }}
{{ else if eq $subcommand "random" }}
	{{ $hebrewDict := sdict
		"0" "א" "1" "ב" "2" "ג" "3" "ד" "4" "ה" "5" "ו" "6" "ז" "7" "ח" "8" "ט" "9" "י" "10" "כ"
		"11" "ל" "12" "מ" "13" "נ" "14" "ס" "15" "ע" "16" "פ" "17" "צ" "18" "ק" "19" "ר" "20" "ש" "21" "ת"
	}}
	{{ $numLetters := toInt .Options.letters }}
	{{/* absent is 1; a given 0 stays 0 and is refused below (`or` would turn it into 1) */}}
	{{ $numGroups := 1 }}
	{{ if .Options.HasKey "groups" }}
		{{ $numGroups = toInt .Options.groups }}
	{{ end }}
	{{/* each is checked before the product: `or` evaluates every argument and mult wraps int64 */}}
	{{ $refuse := or (lt $numLetters 1) (lt $numGroups 1) (gt $numLetters 1000) (gt $numGroups 1000) }}
	{{ if not $refuse }}
		{{ $refuse = gt (mult $numLetters $numGroups) 1000 }}
	{{ end }}
	{{ if $refuse }}
		{{ $refusal = "⚠️ Give `letters` and `groups` of at least 1, and no more than 1000 letters in all." }}
	{{ else }}
		{{ $groups := cslice }}
		{{- range $i := seq 0 $numGroups -}}
			{{- $curGroup := "" -}}
			{{- range $j := seq 0 $numLetters -}}
				{{- $randLetter := index $hebrewDict (toString (randInt 0 22)) -}}
				{{- if and (gt $numLetters 1) (eq $j (sub $numLetters 1)) -}}
					{{- $randLetter = index $sofitDict $randLetter -}}
				{{- end -}}
				{{- $curGroup = joinStr "" $curGroup $randLetter -}}
			{{- end -}}
			{{- $groups = $groups.Append $curGroup -}}
		{{- end -}}
		{{ $result.Set "Title" "Hebrew Generator" }}
		{{ $result.Set "Description" (joinStr " " $groups.StringSlice) }}
	{{ end }}
{{ else }}
Use /hebrew as a slash command: atbash, alefbet, pyramid or random
{{ end }}

{{ if $refusal }}
	{{ sendResponse nil (complexMessage "content" $refusal "ephemeral" true) }}
{{ else if $result.Title }}
	{{ $result.Set "AuthorID" $userID }}
	{{ $result.Set "ChannelID" $channelID }}
	{{ $result.Set "Respond" true }}
	{{ execCC $gematria $channelID 0 $result }}
{{ end }}
