{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Command`
  Trigger: `pyramid`
  Group: `Utility`
  Dependencies: `embed_exec`, `gematria`
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $deleteTriggerDelay := toInt ($globalDict.Get "Delete Trigger Delay") }}
{{ $deleteResponseDelay := toInt ($globalDict.Get "Delete Response Delay") }}
{{/* the multi-word loop below is this run's only execCC fan-out: each iteration's
  execCC $pyramid recurses into its OWN new context (a fresh call-counter), so its
  nested gematria call doesn't count against this run; clamp straight to YAGPDB's
  10-per-run premium cap */}}
{{ $execCCLimit := toInt (min (toInt ($globalDict.Get "ExecCC Limit")) 10) }}

{{ $commandsDict := (dbGet 0 "Commands").Value }}
{{ $embed_exec := toInt ($commandsDict.Get "embed_exec") }}
{{ $gematria := toInt ($commandsDict.Get "gematria") }}
{{ $pyramid := toInt ($commandsDict.Get "pyramid") }}

{{ $channelsDict := (dbGet 0 "Channels").Value }}
{{ $yagpdbChannelID := toInt ($channelsDict.Get "YAGPDB") }}

{{ $gematriaDict := (dbGet 0 "Gematria").Value }}
{{ $valuesDict := $gematriaDict.Get "Values" }}

{{ $args := parseArgs 1 "Usage: [text from which to generate pyramid gematria]"
  (carg "string" "text") }}
{{ $text := or .ExecData.Description ($args.Get 0) }}
{{ $userID := (or .ExecData.AuthorID .User.ID) }}
{{ $channelID := (or .ExecData.ChannelID .Channel.ID) }}

{{ $pyramidString := "" }}
{{ $prevLine := "" }}
{{ $words := reSplit "[[:space:]]+" $text }}
{{- if gt (len $words) 1 -}}
  {{- $skippedCount := 0 -}}
  {{- range $i, $word := $words -}}
    {{- if lt $i $execCCLimit -}}
      {{- execCC $pyramid $yagpdbChannelID 1 (sdict
        "AuthorID" $userID
        "ChannelID" $channelID
        "Description" $word
      ) -}}
    {{- else -}}
      {{- $skippedCount = add 1 $skippedCount -}}
    {{- end -}}
  {{- end -}}
  {{/* the skipped-words warning doesn't depend on the execCC loop above having run (they're
    scheduled, not run now), so one summary is sent after the loop rather than one message
    per skipped word (matches hugemoji's/contrasts's single-warning pattern) */}}
  {{- if gt $skippedCount 0 -}}
    {{- $subjectAndVerb := "" -}}
    {{- if eq 1 $skippedCount -}}
      {{- $subjectAndVerb = "word was" -}}
    {{- else -}}
      {{- $subjectAndVerb = "words were" -}}
    {{- end -}}
    {{- $limitNoun := "words" -}}
    {{- if eq 1 $execCCLimit -}}
      {{- $limitNoun = "word" -}}
    {{- end -}}
    {{- $skipWarningMsgID := sendMessageRetID $channelID (joinStr " "
      "⚠️ Warning:" $skippedCount $subjectAndVerb "not processed because only" $execCCLimit $limitNoun "can be processed at a time."
    ) -}}
    {{- deleteMessage $channelID $skipWarningMsgID $deleteResponseDelay -}}
  {{- end -}}
{{- else -}}
  {{- range $i, $letter := split (index $words 0) "" -}}
    {{- $valLetter := $valuesDict.Get $letter -}}
    {{- if $valLetter -}}
      {{- $curLine := joinStr "" $prevLine $letter -}}
      {{- $pyramidString = joinStr "\n" $pyramidString $curLine -}}
      {{- $prevLine = $curLine -}}
    {{- end -}}
  {{- end -}}

  {{ execCC $gematria $yagpdbChannelID 0 (sdict
    "AuthorID" $userID
    "ChannelID" $channelID
    "Title" "Pyramid Gematria"
    "Description" $pyramidString
    "Fields" (cslice (sdict "name" "Word" "value" $text "inline" false))
  ) }}
{{- end -}}

{{ deleteTrigger $deleteTriggerDelay }}
