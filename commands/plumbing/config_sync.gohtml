{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Hourly interval`
  Interval: `1`
  Group: `Staff Utility`
  Dependencies: none

  Generated by scripts/gen-config-sync.py from deploy/panel.json: edit panel.json and
  run `make config-sync`, never edit this file by hand.

  Merges every managed command's panel id into the Commands dict (keys it doesn't know
  stay), as a string, for this server only (a server not in panel.json is left alone).
  One dbGet and one dbSet per run, no output (an interval run's output would post).
*/ -}}

{{- $ids := sdict -}}
{{- if eq .Guild.ID 462036216909398026 -}}
    {{- /* main */ -}}
    {{- $ids = sdict
        "alefbet" "83"
        "atbash" "68"
        "avatar_menu" "94"
        "avatar_viewer" "31"
        "batch_delrep" "76"
        "bootstrap" "78"
        "bump_check" "44"
        "bump_remind" "43"
        "bump_reset" "54"
        "channel_activity" "86"
        "channel_activity_pager" "87"
        "channel_link" "14"
        "channel_tracker" "85"
        "config_sync" "88"
        "contrast" "61"
        "contrasts" "69"
        "db" "15"
        "db_get_embed" "22"
        "db_get_text" "77"
        "db_slash" "90"
        "define" "84"
        "directory" "38"
        "dismiss" "96"
        "edit_confirm" "93"
        "edit_modal" "92"
        "edit_slash" "91"
        "embed_exec" "3"
        "emoji_menu" "95"
        "gematria" "52"
        "gematria_bootstrap" "73"
        "hex_to_int" "18"
        "hiatus" "81"
        "hugemoji" "51"
        "inactivity" "40"
        "message_link" "32"
        "message_pointer" "74"
        "pyramid" "75"
        "rand_color" "67"
        "rand_hebrew" "65"
        "role_ping" "70"
        "rule" "1"
        "rule_edit" "47"
        "rules" "48"
        "rules_pager" "89"
        "simple_db_edit" "37"
        "simple_db_lookup" "79"
        "staff_roles" "80"
        "ticket_clean" "29"
        "timestamp" "64"
        "unhiatus" "82" -}}
{{- else if eq .Guild.ID 833216349932224562 -}}
    {{- /* lotv */ -}}
    {{- $ids = sdict
        "alefbet" "14"
        "atbash" "17"
        "avatar_viewer" "7"
        "bootstrap" "1"
        "channel_link" "10"
        "contrast" "18"
        "db" "3"
        "db_get_embed" "5"
        "directory" "19"
        "embed_exec" "2"
        "gematria" "9"
        "gematria_bootstrap" "20"
        "hex_to_int" "6"
        "hugemoji" "8"
        "message_link" "11"
        "message_pointer" "21"
        "pyramid" "22"
        "rand_color" "16"
        "simple_db_edit" "23"
        "timestamp" "13" -}}
{{- end -}}

{{- if $ids -}}
    {{- $commandsDict := or (dbGet 0 "Commands").Value sdict -}}
    {{- range $key, $id := $ids -}}
        {{- $commandsDict.Set $key $id -}}
    {{- end -}}
    {{- dbSet 0 "Commands" $commandsDict -}}
{{- end -}}
