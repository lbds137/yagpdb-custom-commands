{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `None`
  Group: `Utility`
*/ -}}

{{ $globalDict := (dbGet 0 "Global").Value }}
{{ $serverURL := or ($globalDict.Get "Server URL") "" }}
{{ $dbEmbedColor := toInt ($globalDict.Get "Embed Color") }}
{{ $guildPremiumTier := toInt ($globalDict.Get "Guild Premium Tier") }}
{{ $deleteResponseDelay := toInt ($globalDict.Get "Delete Response Delay") }}

{{ $author := "" }}
{{ $authorColor := 0 }}
{{ $execAuthorValid := reFind "\\A\\d{16,}\\z" (toString .ExecData.AuthorID) }}
{{ $execAuthorNotGuild := ne (toString .ExecData.AuthorID) (toString .Guild.ID) }}
{{ if and $execAuthorValid $execAuthorNotGuild }}
    {{ $member := getMember .ExecData.AuthorID }}
    {{ $userFull := $member.User.String }}
    {{ if $member.Nick }}
        {{ $userFull = joinStr "" $member.Nick " (" $member.User.String ")" }}
    {{ end }}
    {{ $userLink := joinStr "" "https://discordapp.com/users/" $member.User.ID }}
    {{ $author = sdict "name" $userFull "url" $userLink "icon_url" ($member.User.AvatarURL "128") }}
    {{ $position := 0 }}
    {{ $roles := $member.Roles }}
    {{- range .Guild.Roles -}}
        {{- if and (in $roles .ID) (.Color) (lt $position .Position) -}}
            {{- $position = .Position -}}
            {{- $authorColor = .Color -}}
        {{- end -}}
    {{- end -}}
{{ else }}
    {{ $gIconExtension := ".png" }}
    {{ if ge (toInt $guildPremiumTier) 1 }}
        {{ $gIconExtension = ".gif" }}
    {{ end }}
    {{ $gIcon := "" }}
    {{ if .Guild.Icon }}
        {{ $gIcon = (joinStr "" "https://cdn.discordapp.com/icons/" (toString .Guild.ID) "/" .Guild.Icon $gIconExtension) }}
    {{ else }}
        {{ $gIcon = $globalDict.Get "Default Avatar" }}
    {{ end }}
    {{ $author = sdict "name" .Guild.Name "url" $serverURL "icon_url" $gIcon }}
    {{ $authorColor = $dbEmbedColor }}
{{ end }}

{{/* ExecData is one embed's keys (Title, Description, Fields, Color, ImageURL,
  ThumbnailURL); a caller may instead pass Embeds, a list of such sdicts: each is built
  below exactly as the single embed is, and all go out as ONE message (Discord keeps
  the first 10) */}}
{{ $specs := cslice (or .ExecData (sdict)) }}
{{ if .ExecData.Embeds }}
    {{ $specs = .ExecData.Embeds }}
{{ end }}
{{ $built := cslice }}
{{/* Discord's 6000 covers every embed of a message together: $builtLen is what the
  embeds built so far already take */}}
{{ $builtLen := 0 }}
{{- range $spec := $specs -}}
    {{- /* Discord allows 256 characters for the title, 4096 for the description, and 6000
      for the title, description, field names and values and author name together: cut
      the title and description to fit all three */ -}}
    {{- $title := print (or $spec.Title "") -}}
    {{- if gt (len (toRune $title)) 256 -}}
        {{- $kept := slice (split $title "") 0 255 -}}
        {{- $title = joinStr "" $kept "…" -}}
    {{- end -}}
    {{- $otherLen := add (len (toRune $title))
        (len (toRune (print (or $author.name "")))) -}}
    {{- range $spec.Fields -}}
        {{- $otherLen = add $otherLen
            (len (toRune (print (or .name ""))))
            (len (toRune (print (or .value "")))) -}}
    {{- end -}}
    {{- $descriptionMaxLen := toInt (min 4096 (sub 6000 (add $builtLen $otherLen))) -}}
    {{- $description := $spec.Description -}}
    {{- if $description -}}
        {{- if gt (len (toRune $description)) $descriptionMaxLen -}}
            {{- $description = "" -}}
            {{- if ge $descriptionMaxLen 1 -}}
                {{- $kept := slice (split $spec.Description "") 0 (sub $descriptionMaxLen 1) -}}
                {{- $description = joinStr "" $kept "…" -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
    {{- $builtLen = add $builtLen $otherLen (len (toRune (print (or $description "")))) -}}
    {{- $built = $built.Append (cembed
        "title" $title
        "description" $description
        "fields" $spec.Fields
        "color" (or $spec.Color $authorColor)
        "author" $author
        "image" (sdict "url" $spec.ImageURL)
        "thumbnail" (sdict "url" $spec.ThumbnailURL)
    ) -}}
{{- end -}}
{{/* one embed stays a bare embed, so callers that pass no Embeds send as before */}}
{{ $embed := index $built 0 }}
{{ if .ExecData.Embeds }}
    {{ $embed = $built }}
{{ end }}

{{ $targetChannel := or .ExecData.ChannelID .Channel.ID }}
{{ $message := sdict "embed" $embed }}
{{ if .ExecData.Components }}
    {{ $message.Set "components" .ExecData.Components }}
{{ end }}
{{ if .ExecData.Respond }}
    {{/* answer the interaction this run inherited (a slash root's execCC): public, or
      ephemeral for DeleteResponse, which then deletes nothing: an interaction
      response's delete caps at 10 seconds */}}
    {{ if .ExecData.DeleteResponse }}
        {{ $message.Set "ephemeral" true }}
    {{ end }}
    {{ sendResponse nil (complexMessage $message) }}
{{ else }}
    {{/* callers that pass neither Components nor Embeds keep the bare-embed send, byte
      for byte (sendMessage takes a list of embeds only inside a complexMessage) */}}
    {{ $messageID := "" }}
    {{ if or .ExecData.Components .ExecData.Embeds }}
        {{ $messageID = sendMessageRetID $targetChannel (complexMessage $message) }}
    {{ else }}
        {{ $messageID = sendMessageRetID $targetChannel $embed }}
    {{ end }}
    {{ if .ExecData.DeleteResponse }}
        {{ deleteMessage $targetChannel $messageID (or .ExecData.DeleteDelay $deleteResponseDelay) }}
    {{ end }}
{{ end }}
