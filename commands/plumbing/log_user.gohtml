{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Regex`
  Trigger: `.*`
  Group: `Utility`
  Dependencies: `message_link`
  Limited one-off logger for watching one user; unlisted. The live copy holds the
  real user ID: edit it in the panel, never deploy this file over it. The watched-user
  key below (999999999999999999) is a placeholder, not the real ID.
  The watched-user key and both channel IDs are placeholders; the live copy holds the
  real ones.
*/ -}}

{{ $message_link := 32 }}
{{ $yagpdbChannelID := 888888888888888888 }}
{{ $watchLogChannelID := 777777777777777777 }}
{{ $usersToWatch := (sdict 
  "999999999999999999" true
) }}
{{ if index $usersToWatch (toString .User.ID) }}
  {{ execCC $message_link $yagpdbChannelID 0 (sdict
    "Message" .Message
    "MessageLink" .Message.Link
    "ChannelID" $watchLogChannelID
    "DisableAuthor" true
    "DisableQuote" true
    "KeepTrigger" true
) }}
{{ end }}
