{{- /*
  Author: Vladlena Costescu (@lbds137)
  Trigger type: `Slash Command`
  Trigger: `edit`
  Group: `Staff Utility`
  Slash description: `Edit a rule, or a stored setting or message`
  Defer mode: `None`

  The modal front end for rule_edit and simple_db_edit (both in retired/ now): /edit
  opens a prefilled modal (the engines live in edit_modal, the delete confirm's buttons
  in edit_confirm). Defer None is mandatory, not a choice: sendModal IS the interaction's
  one response, and a deferral would eat the slot.

  Slash subcommand: `rule edit a rule's text`
  Slash option: `rule.rule integer! rule number (a number that doesn't exist yet adds a new rule)`
  Slash subcommand: `entry edit a stored setting or message (advanced)`
  Slash option: `entry.section string section to edit, e.g. Inactivity Prune (capitals don't matter)`
  Slash option: `entry.name string name of the entry, e.g. Opening Announcement`
  Slash option: `entry.create boolean start a brand-new section (only if it doesn't exist yet)`
  Slash subcommand: `delete_rule delete a rule (asks you to confirm)`
  Slash option: `delete_rule.rule integer! rule number to delete`
  Slash subcommand: `delete_entry delete a stored entry (asks you to confirm)`
  Slash option: `delete_entry.section string! section of the entry, e.g. Inactivity Prune`
  Slash option: `delete_entry.name string! name of the entry, e.g. Opening Announcement`
*/ -}}
{{ if .IsSlashCommand }}
	{{ $rolesDict := (dbGet 0 "Roles").Value }}
	{{ $staffRoleID := toInt ($rolesDict.Get "Staff") }}
	{{ if not (hasRoleID $staffRoleID) }}
		{{ sendResponse nil (complexMessage "content" "⚠️ Staff only." "ephemeral" true) }}
	{{ else if eq .SubCommand "rule" }}
		{{ $n := toInt (or .Options.rule 0) }}
		{{ if or (lt $n 1) (gt $n 9999) }}
			{{ sendResponse nil (complexMessage
				"content" "⚠️ Rule numbers run from 1 to 9999." "ephemeral" true) }}
		{{ else }}
			{{ $key := joinStr "" "Rule #" $n }}
			{{ $rulesDict := or (dbGet 0 "Rules").Value sdict }}
			{{ $found := $rulesDict.HasKey $key }}
			{{ $old := "" }}
			{{ if $found }}
				{{ $old = $rulesDict.Get $key }}
			{{ end }}
			{{ $field := sdict "label" (joinStr "" "Rule " $n " text")
				"custom_id" "rule_text" "style" 2 "required" true }}
			{{ if $found }}
				{{ if eq "string" (printf "%T" $old) }}
					{{ if gt (len (toRune $old)) 4000 }}
						{{/* never prefill-truncate: a silent cut would store the truncation on save */}}
						{{ $field.Set "placeholder"
							"current text is too long for this box; type a replacement" }}
					{{ else }}
						{{ $field.Set "value" $old }}
					{{ end }}
				{{ else }}
					{{ $field.Set "placeholder"
						"current value isn't plain text; type a replacement" }}
				{{ end }}
			{{ else }}
				{{ $field.Set "placeholder" "new rule; type its text" }}
			{{ end }}
			{{ $modalTitle := joinStr "" "Edit rule " $n }}
			{{ if not $found }}
				{{ $modalTitle = joinStr "" "New rule " $n " (doesn't exist yet)" }}
			{{ end }}
			{{ sendModal (cmodal
				"title" $modalTitle
				"custom_id" (print "edit:rule:" $n ":" currentTime.Unix)
				"fields" (cslice $field)
			) }}
		{{ end }}
	{{ else if eq .SubCommand "entry" }}
		{{/* the options are section/name; the modal ids and the stored keys keep category/key */}}
		{{ $categoryArg := toString (or .Options.section "") }}
		{{ $keyArg := toString (or .Options.name "") }}
		{{/* "or" returns the option's own value: a bool when given, false when absent */}}
		{{ $create := or .Options.create false }}
		{{ $catPlaceholder := "e.g. Inactivity Prune" }}
		{{ if $create }}
			{{ $catPlaceholder = "a new or existing section" }}
		{{ end }}
		{{ $catField := sdict "label" "Section" "custom_id" "category" "style" 1 "required" true
			"placeholder" $catPlaceholder }}
		{{ $keyField := sdict "label" "Name" "custom_id" "key" "style" 1 "required" true
			"placeholder" "e.g. Opening Announcement" }}
		{{ $valueField := sdict "label" "New text" "custom_id" "value" "style" 2 "required" true
			"placeholder" "the new text" }}
		{{ $nonText := false }}
		{{ $nonTextName := "" }}
		{{/* fields echo the raw input: transformation at store time shows up in the ack */}}
		{{/* a text input holds 4000: past that the prefill is skipped, never cut (a cut
			prefill would save the truncation) */}}
		{{ if and $categoryArg (le (len (toRune $categoryArg)) 4000) }}
			{{ $catField.Set "value" $categoryArg }}
		{{ end }}
		{{ if and $keyArg (le (len (toRune $keyArg)) 4000) }}
			{{ $keyField.Set "value" $keyArg }}
		{{ end }}
		{{ $category := title $categoryArg }}
		{{ $categoryEntry := dbGet 0 $category }}
		{{/* the refusals quote it in a 2000-character message: show a cut copy */}}
		{{ $catShown := $category }}
		{{ if gt (len (toRune $catShown)) 500 }}
			{{ $catShown = joinStr "" (slice (split $catShown "") 0 499) "…" }}
		{{ end }}
		{{ $refused := "" }}
		{{ if $categoryArg }}
			{{ if and $create (reFind "(?i)\\A\\s*new:" $categoryArg) }}
				{{ $refused = "⚠️ Leave out `new:` — the `create` option does that now." }}
			{{ else if and (not $create) (not $categoryEntry) }}
				{{ $refused = joinStr "" "⚠️ There is no section called `" $catShown
					"`. Check the spelling, or set `create` to True to start a new one." }}
			{{ end }}
		{{ end }}
		{{ if $refused }}
			{{ sendResponse nil (complexMessage "content" $refused "ephemeral" true) }}
		{{ else }}
			{{ if $categoryEntry }}
				{{ $categoryValue := $categoryEntry.Value }}
				{{ $categoryDict := sdict }}
				{{ $isDict := false }}
				{{ if eq "map[string]interface {}" (printf "%T" $categoryValue) }}
					{{ $categoryDict = sdict $categoryValue }}
					{{ $isDict = true }}
				{{ else if eq "map" (kindOf $categoryValue true) }}
					{{ $categoryDict = $categoryValue }}
					{{ $isDict = true }}
				{{ end }}
				{{ if $isDict }}
					{{ $key := $keyArg }}
					{{ if ne $category "Commands" }}
						{{ $key = title $keyArg }}
					{{ end }}
					{{ if $categoryDict.HasKey $key }}
						{{ $old := $categoryDict.Get $key }}
						{{ if eq "string" (printf "%T" $old) }}
							{{ if gt (len (toRune $old)) 4000 }}
								{{ $valueField.Set "placeholder"
									"current text is too long for this box; type a replacement" }}
							{{ else }}
								{{ $valueField.Set "value" $old }}
							{{ end }}
						{{ else }}
							{{/* a list or settings group: a text box would overwrite it with text */}}
							{{ $nonText = true }}
							{{ $nonTextName = $key }}
						{{ end }}
					{{ end }}
				{{ end }}
			{{ end }}
			{{ if $nonText }}
				{{ $label := joinStr " › " $catShown $nonTextName }}
				{{ if gt (len (toRune $label)) 500 }}
					{{ $label = joinStr "" (slice (split $label "") 0 499) "…" }}
				{{ end }}
				{{ sendResponse nil (complexMessage "content" (joinStr "" "⚠️ `" $label
					"` holds a list or a group of settings, not text, so it can't be edited here. An admin can change it with /db.")
					"ephemeral" true) }}
			{{ else }}
				{{ $modalID := print "edit:entry:" currentTime.Unix }}
				{{ if $create }}
					{{ $modalID = print "edit:entry:new:" currentTime.Unix }}
				{{ end }}
				{{ sendModal (cmodal
					"title" "Edit entry"
					"custom_id" $modalID
					"fields" (cslice $catField $keyField $valueField)
				) }}
			{{ end }}
		{{ end }}
	{{ else if eq .SubCommand "delete_rule" }}
		{{ $n := toInt (or .Options.rule 0) }}
		{{/* no upper bound here: deleting an existing out-of-range rule is the repair path */}}
		{{ if lt $n 1 }}
			{{ sendResponse nil (complexMessage
				"content" "⚠️ Rule numbers start at 1." "ephemeral" true) }}
		{{ else }}
			{{ $key := joinStr "" "Rule #" $n }}
			{{ $rulesDict := or (dbGet 0 "Rules").Value sdict }}
			{{ if not ($rulesDict.HasKey $key) }}
				{{ sendResponse nil (complexMessage
					"content" (print "⚠️ There is no rule #" $n " to delete.") "ephemeral" true) }}
			{{ else }}
				{{ $old := $rulesDict.Get $key }}
				{{ $description := "" }}
				{{ if eq "string" (printf "%T" $old) }}
					{{ if gt (len (toRune $old)) 4096 }}
						{{ $kept := slice (split $old "") 0 4095 }}
						{{ $old = joinStr "" $kept "…" }}
					{{ end }}
					{{ $description = $old }}
				{{ else }}
					{{/* cut the json first, then fence: fencing after a truncation drops
						the closing fence and breaks the embed's markdown */}}
					{{ $oldJSON := json $old true }}
					{{ $oldJSONMax := sub 4096 8 }}
					{{ if gt (len (toRune $oldJSON)) $oldJSONMax }}
						{{ $kept := slice (split $oldJSON "") 0 (sub $oldJSONMax 1) }}
						{{ $oldJSON = joinStr "" $kept "…" }}
					{{ end }}
					{{ $description = joinStr "" "```\n" $oldJSON "\n```" }}
				{{ end }}
				{{ $uid := .Member.User.ID }}
				{{ $stamp := currentTime.Unix }}
				{{ dbSet $uid "Edit Pending" (sdict "kind" "rule" "rule" $n "stamp" $stamp) }}
				{{ $embedColor := toInt ((dbGet 0 "Global").Value.Get "Embed Color") }}
				{{ $row := cslice
					(cbutton "label" (joinStr "" "Delete rule " $n) "style" "danger"
						"custom_id" (print "editdel:" $uid ":" $stamp ":go"))
					(cbutton "label" "Dismiss" "style" "secondary"
						"custom_id" (print "editdel:" $uid ":" $stamp ":no"))
				}}
				{{ sendResponse nil (complexMessage "ephemeral" true
					"embed" (cembed "title" (joinStr "" "Delete rule #" $n "?")
						"color" $embedColor "description" $description)
					"components" (cslice $row)) }}
			{{ end }}
		{{ end }}
	{{ else if eq .SubCommand "delete_entry" }}
		{{ $categoryArg := toString (or .Options.section "") }}
		{{ $keyArg := toString (or .Options.name "") }}
		{{ $category := title $categoryArg }}
		{{/* the refusals quote them in a 2000-character message: show cut copies */}}
		{{ $catShown := $category }}
		{{ if gt (len (toRune $catShown)) 500 }}
			{{ $catShown = joinStr "" (slice (split $catShown "") 0 499) "…" }}
		{{ end }}
		{{ $refused := "" }}
		{{ $categoryEntry := dbGet 0 $category }}
		{{ if not $categoryEntry }}
			{{ $refused = joinStr "" "⚠️ There is no section called `" $catShown "`. Check the spelling." }}
		{{ end }}
		{{ $categoryDict := sdict }}
		{{ if and (not $refused) $categoryEntry }}
			{{ $categoryValue := $categoryEntry.Value }}
			{{ if eq "map[string]interface {}" (printf "%T" $categoryValue) }}
				{{ $categoryDict = sdict $categoryValue }}
			{{ else if eq "map" (kindOf $categoryValue true) }}
				{{ $categoryDict = $categoryValue }}
			{{ else }}
				{{ $refused = joinStr "" "⚠️ `" $catShown "` can't be edited by name: "
					"it holds a single value or a list. An admin can change it with /db." }}
			{{ end }}
		{{ end }}
		{{ $key := $keyArg }}
		{{ if not $refused }}
			{{ if ne $category "Commands" }}
				{{ $key = title $keyArg }}
			{{ end }}
			{{ if not ($categoryDict.HasKey $key) }}
				{{ $keyShown := $key }}
				{{ if gt (len (toRune $keyShown)) 500 }}
					{{ $keyShown = joinStr "" (slice (split $keyShown "") 0 499) "…" }}
				{{ end }}
				{{ $refused = joinStr "" "⚠️ There is no entry called `" $keyShown "` in `" $catShown
					"`." }}
			{{ end }}
		{{ end }}
		{{ if $refused }}
			{{ sendResponse nil (complexMessage "content" $refused "ephemeral" true) }}
		{{ else }}
			{{ $old := $categoryDict.Get $key }}
			{{ $description := "" }}
			{{ if eq "string" (printf "%T" $old) }}
				{{ if gt (len (toRune $old)) 4096 }}
					{{ $kept := slice (split $old "") 0 4095 }}
					{{ $old = joinStr "" $kept "…" }}
				{{ end }}
				{{ $description = $old }}
			{{ else }}
				{{/* cut the json first, then fence: fencing after a truncation drops
					the closing fence and breaks the embed's markdown */}}
				{{ $oldJSON := json $old true }}
				{{ $oldJSONMax := sub 4096 8 }}
				{{ if gt (len (toRune $oldJSON)) $oldJSONMax }}
					{{ $kept := slice (split $oldJSON "") 0 (sub $oldJSONMax 1) }}
					{{ $oldJSON = joinStr "" $kept "…" }}
				{{ end }}
				{{ $description = joinStr "" "```\n" $oldJSON "\n```" }}
			{{ end }}
			{{ $uid := .Member.User.ID }}
			{{ $stamp := currentTime.Unix }}
			{{ dbSet $uid "Edit Pending"
				(sdict "kind" "entry" "category" $category "key" $key "stamp" $stamp) }}
			{{ $embedColor := toInt ((dbGet 0 "Global").Value.Get "Embed Color") }}
			{{ $row := cslice
				(cbutton "label" "Delete entry" "style" "danger"
					"custom_id" (print "editdel:" $uid ":" $stamp ":go"))
				(cbutton "label" "Dismiss" "style" "secondary"
					"custom_id" (print "editdel:" $uid ":" $stamp ":no"))
			}}
			{{/* the title holds 256: "Delete " and "?" take 8 of them */}}
			{{ $label := joinStr " › " $category $key }}
			{{ if gt (len (toRune $label)) 248 }}
				{{ $label = joinStr "" (slice (split $label "") 0 247) "…" }}
			{{ end }}
			{{ sendResponse nil (complexMessage "ephemeral" true
				"embed" (cembed "title" (joinStr "" "Delete " $label "?")
					"color" $embedColor "description" $description)
				"components" (cslice $row)) }}
		{{ end }}
	{{ end }}
{{ else }}
Use /edit as a slash command: rule · entry · delete_rule · delete_entry
{{ end }}
